{% doc %}
  @prompt
    Create an eye-catching, on-brand 404 "lost page" hero section for a store that has recently migrated to a new website. Include a large friendly headline like "Oops! This page got lost in our move", a supportive message explaining the store recently migrated to a new site so some old links may no longer work and inviting visitors to use the product search or browse the website to find what they're looking for, a prominent search bar, and a clear "Continue shopping" / "Back to homepage" button. Make it visually appealing with generous spacing, centered layout, and customizable text and colors.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-404-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-404-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-404-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-404-hero-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.message_size }}px;
    color: {{ block.settings.message_color }};
    margin: 0 0 {{ block.settings.message_spacing }}px;
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-404-hero-search-wrapper-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.search_spacing }}px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-404-hero-search-form-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    gap: 10px;
  }

  .ai-404-hero-search-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 16px 20px;
    font-size: {{ block.settings.search_input_size }}px;
    border: {{ block.settings.search_border_width }}px solid {{ block.settings.search_border_color }};
    border-radius: {{ block.settings.search_border_radius }}px;
    background-color: {{ block.settings.search_background }};
    color: {{ block.settings.search_text_color }};
    outline: none;
  }

  .ai-404-hero-search-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.search_placeholder_color }};
    opacity: 0.7;
  }

  .ai-404-hero-search-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.search_focus_border_color }};
  }

  .ai-404-hero-search-button-{{ ai_gen_id }} {
    padding: 16px 32px;
    font-size: {{ block.settings.search_button_text_size }}px;
    background-color: {{ block.settings.search_button_bg }};
    color: {{ block.settings.search_button_text_color }};
    border: none;
    border-radius: {{ block.settings.search_button_radius }}px;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-404-hero-search-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.search_button_hover_bg }};
  }

  .ai-404-hero-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 18px 40px;
    font-size: {{ block.settings.cta_button_text_size }}px;
    background-color: {{ block.settings.cta_button_bg }};
    color: {{ block.settings.cta_button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_button_radius }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-404-hero-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_button_hover_bg }};
  }

  @media screen and (max-width: 749px) {
    .ai-404-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 16px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-404-hero-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-404-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-404-hero-message-{{ ai_gen_id }} {
      font-size: {{ block.settings.message_size | times: 0.9 }}px;
    }

    .ai-404-hero-search-form-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-404-hero-search-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<lost-page-hero-{{ ai_gen_id }} class="ai-404-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-404-hero-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-404-hero-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.message != blank %}
      <div class="ai-404-hero-message-{{ ai_gen_id }}">
        {{ block.settings.message }}
      </div>
    {% endif %}

    {% if block.settings.show_search %}
      <div class="ai-404-hero-search-wrapper-{{ ai_gen_id }}">
        <form action="{{ routes.search_url }}" method="get" class="ai-404-hero-search-form-{{ ai_gen_id }}" role="search">
          <input
            type="search"
            name="q"
            class="ai-404-hero-search-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.search_placeholder }}"
            aria-label="Search products"
          >
          <button type="submit" class="ai-404-hero-search-button-{{ ai_gen_id }}">
            {{ block.settings.search_button_label }}
          </button>
        </form>
      </div>
    {% endif %}

    {% if block.settings.show_cta_button %}
      <a href="{{ block.settings.cta_button_link }}" class="ai-404-hero-cta-button-{{ ai_gen_id }}">
        {{ block.settings.cta_button_label }}
      </a>
    {% endif %}
  </div>
</lost-page-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class LostPageHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupSearchForm();
      }

      setupSearchForm() {
        const form = this.querySelector('.ai-404-hero-search-form-{{ ai_gen_id }}');
        if (!form) return;

        form.addEventListener('submit', function(e) {
          const input = form.querySelector('.ai-404-hero-search-input-{{ ai_gen_id }}');
          if (!input.value.trim()) {
            e.preventDefault();
            input.focus();
          }
        });
      }
    }

    customElements.define('lost-page-hero-{{ ai_gen_id }}', LostPageHero{{ ai_gen_id }});
  })();
</script>

