        "heading_za6dRD": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Our Services</strong>",
            "heading_size": "h1"
          }
        },
        "text_7LpBqU": {
          "type": "text",
          "settings": {
            "text": "<ul><li><strong>Retail & E-commerce</strong>: A comprehensive catalog of pro audio, video, broadcast, lighting, musical instruments, CCTV, power tools, and more.</li></ul><p></p><ul><li><strong>Equipment Rental</strong>: Short-term and long-term gear rental for events, productions, and system testing.</li></ul><p></p><ul><li><strong>System Design & Installation</strong>: Customized AV and broadcast setups for organizations — churches, schools, government, and more. </li></ul><p></p><ul><li><strong>Studio Services</strong>: Recording, mixing, mastering, and video production tailored for artists, content creators, and institutions. </li></ul><p></p><ul><li><strong>Consultation</strong>: Our team provides expert guidance to help you pick the right technology for your needs — from live sound to CCTV integration.</li></ul>",
            "text_style": "body"
          }
        }
      },
