{{ 'customer.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .password-toggle-icon {
    position: absolute;
    right: 10px; 
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    width: 18px;
    height: 18px; /* Size of the icon */
    z-index: 10; 
  }

  /* Styles for validation feedback */
  .validation-list {
    list-style: none;
    padding: 0;
    margin-top: 10px;
    font-size: 0.8em; 
  }
  .validation-list li {
    display: flex;
    align-items: center;
    margin-bottom: 5px;
    color: #6b7280; /*gray */
  }
  .validation-list li.valid {
    color: #10b981; /* Green for valid */
  }
  .validation-list li.invalid {
    color: #ef4444; /* Red for invalid */
  }
  .validation-icon {
    margin-right: 8px;
    font-weight: bold;
    width: 16px; 
    text-align: center;
  }
  .password-match-status {
    margin-top: 10px;
    font-weight: bold;
    font-size: 0.6em; 
    display: flex;
    align-items: left;
  }
  .password-match-status .status-icon {
    margin-right: 8px;
    font-weight: bold;
      width: 16px;
    text-align: center;
  }
  .password-match-status.match {
    color: #10b981; /* Green for match */
  }
  .password-match-status.no-match {
    color: #ef4444; /* Red for no match */
  }
{%- endstyle -%}

<div class="customer reset-password section-{{ section.id }}-padding" style="margin: 50px auto; box-shadow: 2px 2px 10px 0px rgba(0,0,0,0.50); padding-left: 32px; padding-right: 32px; background-color: rgb(var(--color-background));" >
  <h1>
    {{ 'customer.reset_password.title' | t }}
  </h1>
  <p>
    {{ 'customer.reset_password.subtext' | t }}
  </p>
  {%- form 'reset_customer_password' -%}
      <input type="hidden" name="return_to" value="/account/login">
    {%- if form.errors -%}
      <h2 class="form__message" tabindex="-1" autofocus>
        <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        {{ 'templates.contact.form.error_heading' | t }}
      </h2>
      <ul>
        {%- for field in form.errors -%}
          <li>
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              <a href="#{{ field }}">
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="field">
      <input
        type="password"
        name="customer[password]"
        id="password"
        autocomplete="new-password"
        {% if form.errors contains 'password' %}
          aria-invalid="true"
          aria-describedby="password-error"
        {% endif %}
        placeholder="{{ 'customer.reset_password.password' | t }}"
      >
      <label for="password">
        {{ 'customer.reset_password.password' | t }}
      </label>

      <img
          id="togglePassword1"
          src="https://img.icons8.com/ios/50/closed-eye.png"
          alt="Show password"
          class="password-toggle-icon password-toggle-trigger"
      />
    </div>

    <div class="field" style="margin-top: 10px;">
      <input
        type="password"
        name="customer[password_confirmation]"
        id="password_confirmation"
        autocomplete="new-password"
        {% if form.errors contains 'password_confirmation' %}
          aria-invalid="true"
          aria-describedby="password_confirmation-error"
        {% endif %}
        placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
      >
      <label for="password_confirmation">
        {{ 'customer.reset_password.password_confirm' | t }}
      </label>

      <img
          id="togglePassword2"
          src="https://img.icons8.com/ios/50/closed-eye.png"
          alt="Show password"
          class="password-toggle-icon password-toggle-trigger"
      />
      
    </div>

    
    <div id="passwordMatchStatus" class="password-match-status" style="margin-top: 10px;">
      <!-- Status will be updated by JavaScript -->
    </div>

    
    <div id="passwordRequirements" class="validation-list" style="margin-top: 20px;">
      <p style="margin-bottom: 5px; color: #374151;">Password must include:</p>
      <ul>
        <li id="reqLength"><span class="validation-icon">✗</span> Minimum 8 characters</li>
        <li id="reqUppercase"><span class="validation-icon">✗</span> At least one uppercase letter</li>
        <li id="reqLowercase"><span class="validation-icon">✗</span> At least one lowercase letter</li>
        <li id="reqNumber"><span class="validation-icon">✗</span> At least one number</li>
        <li id="reqSpecial"><span class="validation-icon">✗</span> At least one special character (!@#$%^&*)</li>
      </ul>
    </div>

    <button>
      {{ 'customer.reset_password.submit' | t }}
    </button>
  {%- endform -%}
</div>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select all elements with the class 'password-toggle-trigger'
    const toggleIcons = document.querySelectorAll('.password-toggle-trigger');
    const passwordInput = document.getElementById('password');
    const passwordConfirmationInput = document.getElementById('password_confirmation');
    const passwordRequirements = document.getElementById('passwordRequirements');
    const passwordMatchStatus = document.getElementById('passwordMatchStatus');

    // Password requirement list items
    const reqLength = document.getElementById('reqLength');
    const reqUppercase = document.getElementById('reqUppercase');
    const reqLowercase = document.getElementById('reqLowercase');
    const reqNumber = document.getElementById('reqNumber');
    const reqSpecial = document.getElementById('reqSpecial');

    // Function to update password requirement feedback
    function updatePasswordRequirements() {
      const password = passwordInput.value;

      // Check length (at least 8 characters)
      const isLengthValid = password.length >= 8;
      updateRequirement(reqLength, isLengthValid);

      // Check for uppercase letter
      const isUppercaseValid = /[A-Z]/.test(password);
      updateRequirement(reqUppercase, isUppercaseValid);

      // Check for lowercase letter
      const isLowercaseValid = /[a-z]/.test(password);
      updateRequirement(reqLowercase, isLowercaseValid);

      // Check for number
      const isNumberValid = /[0-9]/.test(password);
      updateRequirement(reqNumber, isNumberValid);

      // Check for special character
      const isSpecialValid = /[!@#$%^&*()]/.test(password); // Added common special chars
      updateRequirement(reqSpecial, isSpecialValid);
    }

    // Helper function to update a single requirement item
    function updateRequirement(element, isValid) {
      const iconSpan = element.querySelector('.validation-icon');
      element.classList.remove('valid', 'invalid');
      if (isValid) {
        element.classList.add('valid');
        iconSpan.textContent = '✓';
      } else {
        element.classList.add('invalid');
        iconSpan.textContent = '✗';
      }
    }

    // Function to update password match feedback
    function updatePasswordMatchStatus() {
      const password = passwordInput.value;
      const confirmPassword = passwordConfirmationInput.value;

      passwordMatchStatus.innerHTML = ''; // Clear previous status
      passwordMatchStatus.classList.remove('match', 'no-match');

      if (confirmPassword.length === 0) {
        // Do nothing if confirmation field is empty
        return;
      }

      const iconSpan = document.createElement('span');
      iconSpan.classList.add('status-icon');
      const textNode = document.createTextNode('');

      if (password === confirmPassword) {
        passwordMatchStatus.classList.add('match');
        iconSpan.textContent = '✓';
        textNode.textContent = ' Passwords match';
      } else {
        passwordMatchStatus.classList.add('no-match');
        iconSpan.textContent = '✗';
        textNode.textContent = ' Passwords do not match';
      }
      passwordMatchStatus.appendChild(iconSpan);
      passwordMatchStatus.appendChild(textNode);
    }

    // Event listeners for password toggle icons
    toggleIcons.forEach(function(icon) {
      // Find the closest parent 'field' div
      const fieldDiv = icon.closest('.field');
      // Within that 'field' div, find the input with type 'password'
      const passwordField = fieldDiv ? fieldDiv.querySelector('input[type="password"], input[type="text"]') : null;

      if (icon && passwordField) {
        icon.addEventListener('click', function() {
          // Toggle the type attribute
          const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
          passwordField.setAttribute('type', type);

          // Toggle the eye icon and alt text based on the new type
          if (type === 'password') {
            this.src = 'https://img.icons8.com/ios/50/closed-eye.png'; // Closed eye
            this.alt = 'Show password';
          } else {
            this.src = 'https://img.icons8.com/external-smashingstocks-hand-drawn-black-smashing-stocks/99/external-eye-password-security-cyber-attack-hacking-smashingstocks-hand-drawn-black-smashing-stocks.png'; // Open eye
            this.alt = 'Hide password';
          }
        });
      }
    });

    // Event listeners for password validation
    passwordInput.addEventListener('input', function() {
      updatePasswordRequirements();
      updatePasswordMatchStatus(); // Also check match when first password changes
    });

    passwordConfirmationInput.addEventListener('input', updatePasswordMatchStatus);

    // Initial check on page load (useful if fields are pre-filled)
    updatePasswordRequirements();
    updatePasswordMatchStatus();
  });
</script>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
