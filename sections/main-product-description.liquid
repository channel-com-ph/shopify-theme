   <script>
function clickDesc(event) {
  const buttons = document.querySelectorAll('.description-btn');
  buttons.forEach(button => button.classList.remove('active'));

  event.target.classList.add('active');

  const sections = {
    overview: document.getElementById("content-overview"),
    specs: document.getElementById("content-specs"),
    review: document.getElementById("content-review"),
    accessories: document.getElementById("content-accessories"),
    compatible: document.getElementById("content-compatible")
  };

  // Hide all safely
  Object.values(sections).forEach(section => {
    if (section) section.style.display = "none";
  });

  // Show selected safely
  const id = event.target.id;

  if (id === "desc-overview" && sections.overview) {
    sections.overview.style.display = "block";
  }

  else if (id === "desc-specs" && sections.specs) {
    sections.specs.style.display = "block";

    setTimeout(() => {
      const btnContainer = document.querySelector(".btn-container");
      if (!btnContainer) return;

      const headerOffset = 80;
      const elementPosition = btnContainer.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: "smooth"
      });
    }, 100);
  }

  else if (id === "desc-review" && sections.review) {
    sections.review.style.display = "block";
  }

  else if (id === "desc-accessories" && sections.accessories) {
    sections.accessories.style.display = "block";
  }

  else if (id === "desc-compatible" && sections.compatible) {
    sections.compatible.style.display = "block";
  }
}
</script>
  </div>
</div>

