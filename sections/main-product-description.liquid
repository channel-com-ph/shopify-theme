#specs-wrapper {
  max-height: 350px;     
  overflow: hidden;
  transition: max-height 0.5s ease;
}

#specs-wrapper.expanded {
  max-height: 5000px;    /* large enough to show entire table */
}

.specs-toggle-btn {
  display: block;
  margin: 20px auto 0 auto; /* auto centers horizontally */
  padding: 10px 20px;
  background-color: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  border: none;
  cursor: pointer;
  font-size: 16px;
  text-align: center;
}


.specs-toggle-btn:hover {
  opacity: 0.85;
}

