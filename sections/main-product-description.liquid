    font-size: 13px !important;
  }

  /* Header cells */
  #content-specs .specsTable th {
    line-height: 1.4 !important;
    padding: 8px 10px !important;
  }

  /* REMOVE overly aggressive compression */
  table:not([class]) td[colspan="2"] {
    line-height: normal !important;
  }
}

