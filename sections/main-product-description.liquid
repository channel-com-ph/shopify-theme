<style>
/* === Original CSS retained === */
.btn-container{ width: 100%; display: flex; justify-content: center; padding: 0; gap: 20px; flex-direction: row; }
.description-btn{ width: calc(100% / 4); height: 50px; border: solid 1px rgb(var(--color-button)); background-color: transparent; color: rgb(var(--color-link)); font: inherit; }
.description-btn:hover{ background-color: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
.description-btn.active { background-color: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
#content-specs, #content-review, #content-accessories, #content-compatible { display: none; }
.description-container { margin-top: 25px; }
.styleFile img { display: flex !important; margin: 0 !important; justify-self: center !important; width: 80%; }
.styleFile table, .styleFile th, .styleFile td { border: none !important; background-color: transparent !important; font-weight: normal !important; font-size: inherit !important; color: inherit !important; padding: 0 !important; gap: 0 !important; box-shadow: none !important; text-align: left; }
.styleFile th:nth-child(1), .styleFile th:nth-child(2) { width: 60%; }
.styleFile th:nth-child(1):has(img) { width: 40%; }
.styleFile th:nth-child(2):has(img) { width: 40%; }

/* === Specs table === */
.specsTable table {
  width: 100%;
  margin-bottom: 20px;
  text-align: left;
  box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
  color: rgb(var(--color-foreground));
  font-size: 16px !important;
}

.specsTable table,
.specsTable th,
.specsTable td {
  border-bottom: solid 1px rgb(var(--color-button)) !important;
  border-top: solid 1px rgb(var(--color-button)) !important;
  border-left: transparent;
  border-right: transparent;
  border-collapse: collapse;
  padding: 1px 5px; /* compressed spacing */
  line-height: 1.2;  /* for txt */
}

.specsTable th{
  background-color: #363a45;
  color: #e6e7e8;
}



.specsTable td:nth-child(1){
  background-color: #e4e4e4;
  font-weight: bold;
}

/* === header titles to === */
table:not([class]) td[colspan="2"] {
  background-color: rgb(var(--color-background)) !important;
  text-transform: uppercase;
  font-size: 16px;
  padding-top: 1px;
  padding-bottom: 1px;
}

@media screen and (max-width: 750px) {
  .btn-container { flex-direction: column; }
  .description-btn{ width: 100%; }
}

/* === Collapsible wrapper === */
#specs-wrapper {
  overflow: hidden;
  position: relative;
  transition: max-height 0.35s ease;
}

#specs-wrapper.collapsed::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 80px; /* was 60px */
  background: linear-gradient(
    to bottom,
    rgba(255,255,255,0),
    rgba(var(--color-background), 0.95)
  );
  pointer-events: none;
}


#specs-wrapper.expanded::after {
  display: none;
}

/* === Button === */
.specs-toggle-btn {
  margin-top: 15px;
  padding: 10px 20px;
  background-color: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  border: none;
  cursor: pointer;
  font: inherit;
}
</style>

<script>
(function () {
  function initSpecsToggle() {
    const wrapper = document.querySelector("#specs-wrapper");
    const btn = document.querySelector("#toggle-specs-btn");

    if (!wrapper || !btn) return;

    const table = wrapper.querySelector("table");

    // If no table, just hide button
    if (!table) {
      btn.style.display = "none";
      return;
    }

    const rows = table.querySelectorAll("tr");
    const previewRows = 10;

    let collapsedHeight = 400;

    for (let i = 0; i < Math.min(rows.length, previewRows); i++) {
      collapsedHeight += rows[i].offsetHeight;
    }

    collapsedHeight += 20;
    wrapper.style.maxHeight = collapsedHeight + "px";
    wrapper.classList.add("collapsed");

    // Hide button if not enough rows
    if (rows.length <= previewRows) {
      btn.style.display = "none";
      wrapper.style.maxHeight = "none";
      wrapper.classList.remove("collapsed");
      return;
    }

    btn.addEventListener("click", function () {
      const isCollapsed = wrapper.classList.contains("collapsed");

      if (isCollapsed) {
        wrapper.classList.remove("collapsed");
        wrapper.classList.add("expanded");
        wrapper.style.maxHeight = wrapper.scrollHeight + "px";
        btn.textContent = "See Less";
      } else {
        wrapper.classList.remove("expanded");
        wrapper.classList.add("collapsed");
        wrapper.style.maxHeight = collapsedHeight + "px";
        btn.textContent = "See More";

        wrapper.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }
    });
  }

  // Run on normal load
  document.addEventListener("DOMContentLoaded", initSpecsToggle);

  // Run again if Shopify reloads sections
  document.addEventListener("shopify:section:load", initSpecsToggle);
})();
</script>

