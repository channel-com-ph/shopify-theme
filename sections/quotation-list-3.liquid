      function resetList() {
        const customerId = {{ customer.id | json }};

        fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields?namespace=quotation_info`, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' }
        })
        .then(res => res.ok ? res.json() : Promise.reject(`Error fetching metafields: ${res.statusText}`))
        .then(data => {
          const deletePromises = data.metafields.map(meta =>
            fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields/${meta.id}`, {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' }
            }).then(deleteRes => !deleteRes.ok ? Promise.reject(`Error deleting metafield ${meta.id}: ${deleteRes.statusText}`) : null)
          );
          return Promise.all(deletePromises);
        })
        .then(() => console.log('All quotation metafields deleted'))
        .catch(error => console.error('Error:', error));
      }

    window.onload = function () {
  document.getElementById("quotation-download-btn2").addEventListener("click", () => {
    const file = document.getElementById("file");
    const mainForm = document.getElementById("main-form");

    document.body.style.cursor = 'wait';
    mainForm.style.display = 'none';
    file.style.display = 'block';
    file.style.zIndex = '10000';

    var opt = {
      margin: [14.2, 12.7, 14.2, 12.7],
      filename: 'Quotation - channelcomph.pdf',
      image: { type: 'PNG', quality: 1 },
      html2canvas: { scale: 3, useCORS: true },
      jsPDF: { unit: 'mm', format: 'letter', orientation: 'portrait' }
    };

    resetList();

    if (file) {
      // REMOVE setTimeout wrapper - call html2pdf directly
      html2pdf().from(file).set(opt).toPdf().get('pdf').then(function(pdf) {
        var totalPages = pdf.internal.getNumberOfPages();
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();

        // === START: UPDATED PDF FOOTER SCRIPT ===
        for (let i = 1; i <= totalPages; i++) {
          pdf.setPage(i);

          // Set text style for the footer
          pdf.setFontSize(8);
          pdf.setTextColor(150); // A light grey color

          // Add footer text at the bottom-left
          const footerY = pageHeight - 10;
          pdf.text('This quotation is generated by: channel.com.ph', 12.7, footerY);
          pdf.text('Email: sales@channel.com.ph | Tel.: +632 7738 2844', 12.7, footerY + 3);

          // Add the page number at the bottom-center
          pdf.setFontSize(10);
          pdf.setTextColor(100); // A darker grey for the page number
          pdf.text(
            'Page ' + i + ' of ' + totalPages,
            pageWidth / 2, // Center horizontally
            pageHeight - 7, // Position vertically
            { align: 'center' } // Ensure text is centered
          );
        }
        // === END: UPDATED PDF FOOTER SCRIPT ===

        mainForm.style.display = 'block';
        file.style.display = 'none';
      }).save();

      // MOVE cursor reset AFTER the promise chain (not inside setTimeout)
      document.body.style.cursor = 'default';

      setTimeout(() => {
        sendMail();
        sendMailClient();
      }, 5000);

      setTimeout(() => {
        location.reload();
      }, 8000);
    } else {
      console.error("Element with ID 'file' not found.");
      document.body.style.cursor = 'default';
    }
  });
};
