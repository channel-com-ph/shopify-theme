{{ 'quotation-form-styles.aio.min.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom styles for the quotation table header and footer */
  .quotation-thead-style {
    background-color: #e0e0e0; /* Light Grey Background for header */
    color: #333;
  }
  
  .quotation-thead-style th,
  .quotation-thead-style span {
    color: #333; /* Ensure header text is dark */
  }
  
  .quotation-tfoot-style {
    color: darkred; /* Ensure footer text is darkred */
  }
  
  .quotation-tfoot-style #colVat strong {
    color: darkred; /* Ensure VAT INC. text is darkred */
    font-size: 10px !important; /* Adjusted VAT INC. font size */
  }
  
  /* Further refinements for a cohesive design */
  .quotation-table-style {
    border-collapse: collapse; /* Ensure borders are clean */
    width: 100%;
    margin-top: 20px;
    /* Apply border to the table, but also ensure cells have borders */
    border: 1px solid #d9d9d9; /* This will be the outer border */
    border-radius: 8px;
    overflow: hidden; /* Keep this for rounded corners clipping content */
  }
  
  .quotation-table-style th,
  .quotation-table-style td {
    padding: 10px 12px;
    border: 1px solid #d9d9d9; /* Apply borders to cells for inner lines */
    text-align: left;
    font-size: 1.2rem;
  }
  
  .quotation-tbody-style tr:nth-child(even) {
    background-color: white; /* Light stripe for readability */
  }
  
  .quotation-tbody-style tr:hover {
    background-color: white;
  }
  
  .quotation-table-style img {
    max-width: 80px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  
  /* New flexbox approach for header */
  .group {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    padding-top: 0;
  }
  
  .left-header-content {
    flex: 1;
    text-align: left;
    padding-right: 10px;
    padding-top: 0;
  }
  
  .right-header-content {
    flex-shrink: 0; /* Don't shrink */
    width: 30%; /* Adjusted width */
    text-align: right; /* Align content to the right */
    padding-top: 0; /* Removed top padding */
    padding-right: 10px; /* Added padding to the right */
  }
  
  .quotation-title {
    color: #8B0000;
    text-transform: uppercase;
    margin: 0; /* Remove default margins */
    font-size: 22px; /* Slightly smaller font size for prominence */
    font-weight: bold;
    text-align: right; /* Align to the right */
  }
  
  .company-name {
    font-size: 14px; /* Restored font size */
    margin: 0 0 2px 0; /* Adjusted margin */
    font-weight: bold;
    text-align: left; /* Align left */
  }
  
  .company-details {
    font-size: 11px; /* Adjusted font size for addresses/contact */
    margin: 0; /* Remove default margins */
    line-height: 1.2; /* Adjusted line height for tighter spacing */
    text-align: left; /* Ensure left alignment */
    padding: 0; /* Remove padding */
  }
  
 .company-logo {
   height: 60px; /* Slightly larger logo size */
   width: auto;
   max-width: 100px; /* Max width for responsiveness */
   margin: 0 0 5px 0; /* Margin bottom and left alignment, removed top margin */
   padding: 0;
   display: block; /* Ensures proper positioning */
 }
  
  /* TABLES for PDF generation */
  #quotation-products-table,
  #quotation-products-table2,
  #quotation-products-table3 {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    /* Crucial: To make the outer border visible with border-radius and overflow:hidden */
    border: 1px solid white; /* This will be the outer border for the table container */
    overflow: hidden; /* Needed for border-radius to work visually */
  }
  
  /* Apply borders to individual cells within the quotation product tables */
  #quotation-products-table td,
  #quotation-products-table2 td,
  #quotation-products-table3 td,
  #quotation-products-table th, 
  #quotation-products-table2 th,
  #quotation-products-table3 th {
    border: 1px solid    #d9d9d9 !important; /* Apply borders to cells and headers for inner lines */
  }
  
  /* Styling for tables generated for PDF */
  .file-table {
    width: 98%; /* Adjusted table width to 98% */
    margin-left: 0.5%;
    margin-right: auto;
    border-collapse: collapse;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid  #b3b3b3; /* Outer border for file-table */
    table-layout: fixed;
  }
  
  .file-table th,
  .file-table td {
    border: 1px solid white; /* Inner borders for file-table cells and headers */
    padding: 2px 4px;
    text-align: left;
    word-wrap: break-word;
    font-size: 9px;
  }
  
  /* Column widths for file-table */
  .file-table th:nth-child(1), .file-table td:nth-child(1) { width: 6%; } /* IMAGE */
  .file-table th:nth-child(2), .file-table td:nth-child(2) { width: 29%; }  /* ITEM KEY FEAT. */
  .file-table th:nth-child(3), .file-table td:nth-child(3) { width: 20%; }  /* MODEL */
  .file-table th:nth-child(4), .file-table td:nth-child(4) { width: 21%; }  /* BRAND */
  .file-table th:nth-child(5), .file-table td:nth-child(5) { width: 5%; }  /* UNIT PRICE */
  .file-table th:nth-child(6), .file-table td:nth-child(6) { width: 4%; }  /* QTY. */
  .file-table th:nth-child(7), .file-table td:nth-child(7) { width: 4%; }  /* UNIT */
  .file-table th:nth-child(8), .file-table td:nth-child(8) { width: 4%; }  /* AMOUNT */
  .file-table th:nth-child(9), .file-table td:nth-child(9) { width: 7%; }  /* NOTE */
  
  
  .file-table th {
    background-color: #e0e0e0;
    font-weight: bold;
    
  }
  
  /* Ensure top-left and top-right corners of the header are rounded */
  .file-table thead tr:first-child th:first-child {
    border-top-left-radius: 8px;
  }
  .file-table thead tr:first-child th:last-child {
    border-top-right-radius: 8px;
  }
  
  /* Ensure bottom-left and bottom-right corners of the last row are rounded */
  .file-table tbody tr:last-child td:first-child {
    border-bottom-left-radius: 8px;
  }
  .file-table tbody tr:last-child td:last-child {
    border-bottom-right-radius: 8px;
  }
  
  .quotation-footer {
    margin: 0;
    padding: 8px 0;
    background-color: #fff !important;
    border: 1px solid white; /* Border for the footer */
  }
  
  #quotation-products-table + #quotation-products-table2,
  #quotation-products-table2 + #quotation-products-table3 {
    border-width: 0.5px; /* Reduced thickness */
    margin-top: 0;
  }
  
  #totalRow {
    background-color: #e0e0e0 !important; /* Light Grey for total row */
    border: none; 
  }
  
  /* New style for images within the PDF table */
  .file-table img {
    max-width: 50px; /* Reduced image size for PDF */
    height: auto;
    display: block;
    margin: 0 auto;
  }
  
  /* Smaller font for footer sections */
  .quotation-footer p,
  .quotation-footer ul li {
    font-size: 10px !important; /* Adjusted for smaller font */
    line-height: 1.1; /* Slightly tighter line height */
  }
  
  .quotation-footer p strong {
    font-size: 11px !important; /* Keep strong tags slightly larger */
  }
  
  /* Signature line and text styling */
  .signature-line-container {
    width: 400px; /* Increased width to ensure text fits on one line */
    margin: 40px auto 5px 10%; /* Shift left by setting left margin to 10% and right to auto, increased top margin */
    text-align: left; /* Align content to the left within its container */
  }
  
  .signature-line-container p {
    border-top: 1px solid #000; /* Solid line */
    padding-top: 5px;
    font-size: 8px !important; /* Adjusted font size to be smaller and added !important */
    font-style: italic;
    white-space: nowrap; /* Force text to stay on one line */
    overflow: hidden; /* Hide overflow if text is still too long */
    text-overflow: ellipsis; /* Add ellipsis if text overflows */
    margin: 0; /* Remove default paragraph margin */
    display: block; /* Allows border to span width */
    text-align: center; /* Center the text within the block */
  }
  
  /* Removed text-decoration-line: overline from strong to prevent double line */
  .signature-line-container strong {
    /* text-decoration-line: overline; */
  }
  
  /* Styles for buttons */
  .action-buttons-cell {
    text-align: center; /* Center the buttons in their cells */
    vertical-align: middle; /* Vertically align buttons */
  }
  .action-buttons-cell button {
    padding: 4px 8px;
    font-size: 0.75rem;
    border-radius: 0.25rem;
    border: 1px solid #ccc;
    cursor: pointer;
    background-color: #f0f0f0;
    transition: background-color 0.2s;
    margin: 2px; /* Small margin between buttons if they are side-by-side */
    min-width: 50px; /* Ensure buttons have a minimum width */
  }
  .action-buttons-cell button:hover {
    background-color: #e0e0e0;
  }
  .action-buttons-cell .edit-btn2 {
    background-color: #2563eb; /* Blue */
    color: white;
    border-color: #2563eb;
  }
  .action-buttons-cell .edit-btn2:hover {
    background-color: #1d4ed8;
  }
  .action-buttons-cell .delete-btn2 {
    background-color: #dc2626; /* Red */
    color: white;
    border-color: #dc2626;
  }
  .action-buttons-cell .delete-btn2:hover {
    background-color: #b91c1c;
  }

  .table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-responsive table {
  min-width: 900px; /* or adjust based on your columns */
}
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.2/html2pdf.bundle.min.js" defer="defer"></script>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
{% assign companyProvince = customer.metafields.custom_info.company_province %}
{% assign companyProvinceWithoutSlash = companyProvince | split: '/' | last %}
{% assign customerName = customer.metafields.custom_info.first_name
  | append: ' '
  | append: customer.metafields.custom_info.last_name
%}
{% assign companyName = customer.metafields.custom_info.company_name %}
{% assign companyPhone = customer.metafields.custom_info.company_contactCode
  | append: customer.metafields.custom_info.company_contact
%}
{% assign companyAddress = customer.metafields.custom_info.company_address
  | append: ', '
  | append: customer.metafields.custom_info.company_brgy
  | append: ', '
  | append: customer.metafields.custom_info.company_city
  | append: ', '
  | append: companyProvinceWithoutSlash
  | append: ', '
  | append: customer.metafields.custom_info.company_country
  | append: ', '
  | append: customer.metafields.custom_info.company_code
%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div style="display: flex; justify-self: end; align-items: center;">
      <a
        href="/pages/quotation-list"
        style="display: flex; text-decoration: none; border-radius: 4px; border: 1px solid rgb(var(--color-button)); padding: 0 20px !important; text-transform: uppercase; line-height: 15px; height: 40px; align-items: center; gap: 10px;"
        class="anchorHover"
      >
        <span class="svg-wrapper" style="transform: rotate(180deg);">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
        NOT A CONTRACTOR?
      </a>
    </div>
    <div id="main-form">
      <span><h1>Quotation List</h1></span>
      <p style="color: #FF1F31;">To continue, kindly browse products to select or add to your quotation list.</p>
      <form id="form">
        <div class="table-responsive">  
        <table id="quotation-table" class="quotation-table-style">
          <thead class="quotation-thead-style">
            <tr>
              <th><span>IMAGE</span></th>
              <th><span>ITEM</span></th>
              <th><span>MODEL</span></th>
              <th><span>BRAND</span></th>
              <th><span>UNIT PRICE</span></th>
              <th><span>QTY.</span></th>
              <th><span>UNIT</span></th>
              <th><span>AMOUNT</span></th>
              <th><span>NOTE</span></th>
              <th class="action-buttons-header"></th>
              <th class="action-buttons-header"></th>
            </tr>
          </thead>
          <tbody class="quotation-tbody-style">
            </tbody>
          <tfoot class="quotation-tfoot-style">
            <tr id="totalRow">
              <td colspan="4"></td>
              <td class="total-label" colspan="3" style="color: darkred; text-align: center;">TOTAL AMOUNT</td>
              <td id="totalAmountPrice" class="total-amount" colspan="1"></td>
              <td colspan="1" id="colVat"><strong>VAT INC.</strong></td>
              <td colspan="2"></td> </tr>
          </tfoot>
        </table>
      </div>
        <div
          class="customer-details"
          style="margin-top: 32px; box-shadow: 2px 2px 10px 0px rgba(0,0,0,0.50); padding: 32px;"
        >
          <span><h2>Create a Quotation File</h2></span>
          <span><h3>Quotation By</h3></span>
          <label class="label-form">Full Name</label>
          <div class="two-col">
            <span
              ><input
                type="text"
                placeholder="First Name and Last Name"
                name="fName"
                class="text-field-normal"
                id="inputFNameC"
                value="{{ customerName }}"
                required
            ></span>
            </div>
          <label class="label-form">Company Name</label>
          <span
            ><input
              type="text"
              placeholder="Company Name"
              name="compName"
              class="text-field-wide"
              id="inputCNameC"
              value="{{ companyName }}"
              required
          ></span>
          <label class="label-form">Company Address</label>
          <span
            ><input
              type="text"
              placeholder="Address"
              name="addressName"
              class="text-field-wide"
              id="inputAddressC"
              value="{{ companyAddress }}"
              required
          ></span>
          <div class="two-col">
            <div class="one-col">
              <label class="label-form">Contact Number</label>
              <span
                ><input
                  type="tel"
                  placeholder="Contact Number"
                  name="inputTel"
                  class="text-field-wide"
                  id="inputPhoneC"
                  value="{{ companyPhone }}"
                  required
              ></span>
            </div>
            <div class="one-col">
              <label class="label-form">Email Address</label>
              <span
                ><input
                  type="email"
                  placeholder="Email Address"
                  name="emailAdd"
                  class="text-field-wide"
                  id="inputEmailC"
                  value="{{ customer.email }}"
                  required
              ></span>
            </div>
          </div>
          <label class="label-form">Upload your Logo</label>
          <label class="label-form" style="color: rgba(var(--color-button), 0.75);">Maximum File Size: 20 MB</label>
          <span style="display: flex; align-items: center; margin-top: 10px;">
            <label
              class="label-form"
              for="svyFile"
              style="border-radius: 4px; background-color: rgb(var(--color-button)); color: rgb(var(--color-button-text)); padding: 5px 14px; cursor: pointer;"
            >
              <span style="border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; ">
                {{- 'icon-btn-upload.svg' | inline_asset_content -}}
              </span>
              UPLOAD AN IMAGE
            </label>
            <input type="file" name="file" id="svyFile" accept="image/*" hidden
            ><span
              id="file-chosen"
              style="margin-left: 20px; margin-top: 5px;width: 78%; border-bottom: 1px solid rgb(var(--color-button)); padding: 4px 10px;"
              >No file chosen</span
            >
          </span>
          <p id="error-message" style="color: red; font-size: 11px; display: none;">
            File is too large. Please choose a file smaller than 1 MB.
          </p>
          <div id="previewForm"></div>
          <label class="label-form" style="margin-top: 16px; font-weight: bold; font-size: 1.6rem;"
            >Terms & Conditions</label
          >
          <div id="inRows" class="row" style="display: block; max-width:100%;">
            <div class="column" style="display: flex; flex-direction: row; gap: 20px; max-width:100%;">
              <div style="width: 100%; padding-bottom: 10px;">
                <label class="label-form" for="tcTitle">Title</label>
                <input type="text" name="title[]" class="text-field-wide" id="tcTitle" style="margin-bottom:0;">
              </div>
              <div style="width: 100%; padding-bottom: 10px;">
                <label class="label-form" for="tcDescription">Description</label>
                <textarea
                  name="description[]"
                  rows="1"
                  class="text-field-wide svySpecs"
                  style="max-width: 100%;margin-bottom:0; min-width: 100%; min-height: 39px; max-height: 160px;"
                  id="tcDescription"
                ></textarea>
              </div>
              <div style="width: 10%; display: flex; justify-content: center; align-items: flex-end; padding-bottom: 10px; border-radius: 4px;">
                <button
                  type="button"
                  onclick="removeRow(this)"
                  class="minBtn"
                  style="margin-bottom: 0; border-radius: 4px;"
                >
                  -
                </button>
              </div>
            </div>
          </div>
          <button
            type="button"
            onclick="addRow(); return false"
            class="addBtn"
            style="margin-bottom: 16px; border-radius: 4px;"
          >
            <span style="border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; padding-right: 4px;">
              <span class="svg-wrapper" style="transform: scale(0.75); ">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
              ADD MORE TERMS
            </span>
          </button>

          <hr style="border-top: 0.1px solid rgb(var(--color-button)); margin-top: 28px; margin-bottom: 28px;">
          <span><h3>Bank Account Details</h3></span>
          <div id="bankDetailsRows" class="row" style="display: block; max-width:100%;">
            <div class="column" style="display: flex; flex-direction: column; gap: 10px; max-width:100%;">
              <div>
                <label class="label-form" for="inputBankName">Bank Name</label>
                <span><input type="text" placeholder="Bank Name" name="bankName[]" class="text-field-wide" id="inputBankName"></span>
              </div>
              <div>
                <label class="label-form" for="inputAccountName">Account Name</label>
                <span><input type="text" placeholder="Account Name" name="accountName[]" class="text-field-wide" id="inputAccountName"></span>
              </div>
              <div style="display: flex; align-items: flex-end; gap: 20px;">
                <div style="flex-grow: 1;">
                  <label class="label-form" for="inputAccountNumber">Account Number</label>
                  <span><input type="text" placeholder="Account Number" name="accountNumber[]" class="text-field-wide" id="inputAccountNumber"></span>
                </div>
                <div style="width: 10%; display: flex; justify-content: center; padding-bottom: 10px; border-radius: 4px;">
                  <button
                    type="button"
                    onclick="removeBankRow(this)"
                    class="minBtn"
                    style="margin-bottom: 0; border-radius: 4px;"
                  >
                    -
                  </button>
                </div>
              </div>
            </div>
          </div>
          <button
            type="button"
            onclick="addBankRow(); return false"
            class="addBtn"
            style="margin-bottom: 16px; border-radius: 4px;"
          >
            <span style="border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; padding-right: 4px;">
              <span class="svg-wrapper" style="transform: scale(0.75); ">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
              ADD MORE BANK DETAILS
            </span>
          </button>
          <hr style="border-top: 0.1px solid rgb(var(--color-button)); margin-top: 28px; margin-bottom: 28px;">
          <span><h3>Quotation To</h3></span>
          <label class="label-form">Full Name</label>
          <div class="two-col">
            <span
              ><input
                type="text"
                placeholder="First Name and Last Name"
                name="fName"
                class="text-field-normal"
                id="inputFName"
                required
            ></span>
          </div>
          <label class="label-form">Company Name</label>
          <span
            ><input
              type="text"
              placeholder="Company Name"
              name="compName"
              class="text-field-wide"
              id="inputCName"
              required
          ></span>
          <label class="label-form">Address</label>
          <span
            ><input
              type="text"
              placeholder="Address"
              name="addressName"
              class="text-field-wide"
              id="inputAddress"
              required
          ></span>
          <div class="two-col">
            <div class="one-col">
              <label class="label-form">Contact Number</label>
              <span
                ><input
                  type="tel"
                  placeholder="Contact Number"
                  name="inputTel"
                  class="text-field-wide"
                  id="inputPhone"
                  required
              ></span>
            </div>
            <div class="one-col">
              <label class="label-form">Email Address</label>
              <span
                ><input
                  type="email"
                  placeholder="Email Address"
                  name="emailAdd"
                  class="text-field-wide"
                  id="inputEmail"
                  required
              ></span>
            </div>
          </div>
          <label class="label-form">Project Title</label>
          <span
            ><input
              type="text"
              placeholder="Project Title"
              name="projName"
              class="text-field-wide"
              id="inputProject"
              required
          ></span>
          <label class="label-form">Job Number</label>
          <span
            ><input
              type="text"
              placeholder="Job Number"
              name="properties[Job Number]"
              class="text-field-wide"
              id="quote-job-number"
              required
          ></span>
        </div>

        <span>
          <button
            type="submit"
            id="quotation-download-btn"
            class="quotation-btn"
            style="margin-top: 20px; align-items: center; justify-content: center; gap: 16px; border-radius: 4px;"
            disabled
          >
            <span class="svg-wrapper">
              {{- 'icon-save.svg' | inline_asset_content -}}
            </span>
            SAVE DATA
          </button>
        </span>
      </form>
    </div>
    <div class="quotation-document" id="quotation-file">
      <span>
        <button id="quotation-download-btn2" class="quotation-btn" style="display: none; margin-top: 20px;">
          <span style="display: flex; align-items: center; justify-content: center; gap: 5px;">
            {{- 'icon-btn-download.svg' | inline_asset_content -}}
            DOWNLOAD
          </span>
        </button>
      </span>
      <div style="width: 816px; height: auto;">
        <div class="container" id="file">
          <div class="group">
            <div class="left-header-content">
              <div id="pdf-logo-container" class="company-logo-container"></div> <p class="company-name" id="companyNameHeaderPDF"></p>
              <p class="company-details" id="companyAddressHeaderPDF"></p>
              <p class="company-details" id="companyContactHeaderPDF"></p>
              <p class="company-details" id="companyEmailWebsiteHeaderPDF"></p>
            </div>

            <div class="right-header-content">
              <h1 class="quotation-title">QUOTATION</h1>
