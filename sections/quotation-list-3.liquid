    <script>
    const fileInput = document.getElementById('svyFile');
    const fileChosen = document.getElementById('file-chosen');
    const errorMessage = document.getElementById('error-message');

    const MAX_FILE_SIZE = 20 * 1024 * 1024; // 20 MB

    fileChosen.addEventListener('click', () => {
        fileInput.click();
    });

    fileInput.addEventListener('change', () => {
        const file = fileInput.files[0];

        if (file) {
            fileChosen.textContent = file.name;

            if (file.size > MAX_FILE_SIZE) {
                errorMessage.style.display = 'block';
                fileInput.value = '';
                fileChosen.textContent = 'No file chosen';
            } else {
                errorMessage.style.display = 'none';
                var previewForm = document.getElementById('previewForm');
                previewForm.innerHTML = '';
                previewForm.style.border = '1px solid #000000';
                previewForm.style.marginTop = '10px';
                previewForm.style.justifyContent = 'center';
                previewForm.style.display = 'flex';
                var img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.style.maxHeight = '100px';
                img.style.maxWidth = '100%';
                img.style.margin = '10px';

                previewForm.appendChild(img);

                var preview = document.getElementById('preview'); // This is the preview for the form, not PDF
                preview.innerHTML = '';

                var img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.style.maxHeight = '40px';
                img.style.maxWidth = '100%';

                preview.appendChild(img);
            }
        } else {
            fileChosen.textContent = 'No file chosen';
            errorMessage.style.display = 'none';
        }
    });

    let rowCount = 1;
    let bankRowCount = 1; // New counter for bank detail rows

    const mainTextArea = document.getElementById('tcDescription');

    function addRow() {
      const newColumn = document.createElement('div');
      newColumn.setAttribute("class", "column");
      // newColumn.setAttribute("style", "display: flex; flex-direction: row; gap: 10px; align-items: flex-start;");
      newColumn.setAttribute("style", "display: flex; flex-direction: row; gap: 20px; max-width:100%;");

      newColumn.innerHTML = `
        <div style="width: 100%; padding-bottom: 10px;">
          <label class="label-form" for="tcTitle${rowCount}">Title</label>
          <input type="text" name="title[]" class="text-field-wide" id="tcTitle${rowCount}" style="margin-bottom:0;">
        </div>
        <div style="width: 100%; padding-bottom: 10px;">
          <label class="label-form" for="tcDescription${rowCount}">Description</label>
          <textarea name='description[]' rows="1" class="text-field-wide svySpecs" style="max-width: 100%;margin-bottom:0; min-width: 100%; min-height: 39px; max-height: 160px;" id="tcDescription${rowCount}"></textarea>
        </div>
        <div style="width: 10%; display: flex; justify-content: center; align-items: flex-end; padding-bottom: 10px;">
          <button type="button" onclick="removeRow(this)" class="minBtn" style="margin-bottom: 0;">-</button>
        </div>
      `;

      document.getElementById('inRows').appendChild(newColumn);
      const bulletArea = newColumn.querySelector('.svySpecs');
      addBulletListeners(bulletArea);
      rowCount++;
    }

    function addBankRow() {
      const newBankColumn = document.createElement('div');
      newBankColumn.setAttribute("class", "column");
      newBankColumn.setAttribute("style", "display: flex; flex-direction: column; gap: 10px; max-width:100%;");

      newBankColumn.innerHTML = `
        <div>
          <label class="label-form" for="inputBankName${bankRowCount}">Bank Name</label>
          <span><input type="text" placeholder="Bank Name" name="bankName[]" class="text-field-wide" id="inputBankName${bankRowCount}"></span>
        </div>
        <div>
          <label class="label-form" for="inputAccountName${bankRowCount}">Account Name</label>
          <span><input type="text" placeholder="Account Name" name="accountName[]" class="text-field-wide" id="inputAccountName${bankRowCount}"></span>
        </div>
        <div style="display: flex; align-items: flex-end; gap: 20px;">
          <div style="flex-grow: 1;">
            <label class="label-form" for="inputAccountNumber${bankRowCount}">Account Number</label>
            <span><input type="text" placeholder="Account Number" name="accountNumber[]" class="text-field-wide" id="inputAccountNumber${bankRowCount}"></span>
          </div>
          <div style="width: 10%; display: flex; justify-content: center; padding-bottom: 10px; border-radius: 4px;">
            <button
              type="button"
              onclick="removeBankRow(this)"
              class="minBtn"
              style="margin-bottom: 0; border-radius: 4px;"
            >
              -
            </button>
          </div>
        </div>
      `;
      document.getElementById('bankDetailsRows').appendChild(newBankColumn);
      bankRowCount++;
    }

    function removeBankRow(button) {
      const column = button.closest('.column');
      column.remove();
    }

    function addBulletListeners(bulletArea) {
      bulletArea.addEventListener('focus', function() {
        if (bulletArea.value.trim() === '') {
          bulletArea.value = '• ';
        } else if (!bulletArea.value.endsWith('• ')) {
          bulletArea.value += '\n• ';
        }
        bulletArea.setSelectionRange(bulletArea.value.length, bulletArea.value.length);
        adjustHeight(bulletArea);
      });

      bulletArea.addEventListener('input', function() {
        adjustHeight(bulletArea);
      });

      bulletArea.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          const currentText = bulletArea.value.trim();
          bulletArea.value = currentText + '\n• ';
          bulletArea.setSelectionRange(bulletArea.value.length, bulletArea.value.length);
          adjustHeight(bulletArea);
        }
      });
    }

    function adjustHeight(textarea) {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 160) + 'px';
    }

    if (mainTextArea) {
      function addBullet() {
        mainTextArea.addEventListener('focus', function() {
          if (mainTextArea.value.trim() === '') {
            mainTextArea.value = '• ';
          } else if (!mainTextArea.value.endsWith('• ')) {
            mainTextArea.value += '\n• ';
          }
          mainTextArea.setSelectionRange(mainTextArea.value.length, mainTextArea.value.length);
          adjustHeight(mainTextArea);
        });

        mainTextArea.addEventListener('input', function() {
          adjustHeight(mainTextArea);
        });

        mainTextArea.addEventListener('keydown', function(event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            const currentText = mainTextArea.value.trim();
            mainTextArea.value = currentText + '\n• ';
            mainTextArea.setSelectionRange(mainTextArea.value.length, mainTextArea.value.length);
            adjustHeight(mainTextArea);
          }
        });
      }
      addBullet();
    }

    function removeRow(button) {
      const column = button.closest('.column');
      column.remove();
    }
    </script>
    <script>
  document.addEventListener('DOMContentLoaded', () => {
    const customerId = {{ customer.id | json }};
    const quotationDetails = document.querySelector('tbody.quotation-tbody-style');

    function fetchQuotationProducts() {
      fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields?namespace=quotation_info`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(res => {
        if (!res) {
          throw new Error('Failed to fetch metafields: Response is undefined');
        }
        if (!res.ok) {
          throw new Error(`Failed to fetch metafields: ${res.statusText} (${res.status})`);
        }
        return res.json();
      })
      .then(data => {
        const aggregatedProducts = {};

      data.metafields.forEach(meta => {
        try {
          const productData = JSON.parse(meta.value);
          const title = productData.title || productData.title;

          if (!aggregatedProducts[title]) {
            aggregatedProducts[title] = {
              id: meta.id,
              title: title,
              type: productData.type || "",
              vendor: productData.vendor || "",
              price: typeof productData.price === 'string' ?
                    parseFloat(productData.price.replace(/₱/g, '').replace(/,/g, '')) :
                    parseFloat(productData.price) || 0,
              quantity: parseInt(productData.quantity, 10) || 0,
              metafields: productData.metafields || "",
              featured_image: productData.featured_image || "",
              note: productData.note || "",
              // Ensure custom_feature and custom_features are read from productData
              custom_feature: productData.custom_feature || "",
              custom_features: productData.custom_features || ""
            };

          } else {
            aggregatedProducts[title].quantity += parseInt(productData.quantity, 10) || 0;
          }
        } catch (error) {
          console.error('Error parsing product data:', error);
        }
      });

        Object.keys(aggregatedProducts).forEach(title => {
          const product = aggregatedProducts[title];
          // Ensure "PC" is used if the original metafields value is "PIECES" or similar
          let unitDisplay = product.metafields.trim();
          if (unitDisplay.toLowerCase() === 'pieces' || unitDisplay.toLowerCase() === 'piece/s') {
            unitDisplay = 'PC';
          } else if (unitDisplay.toLowerCase() === 'set') {
            unitDisplay = 'SET'; // Keep 'SET' as is
          } else if (unitDisplay === '') {
            unitDisplay = 'N/A'; // Handle empty string for unit
          }

          const newRow = document.createElement('tr');
          newRow.innerHTML = `
            <td><img src="${product.featured_image}" alt="${escapeHtml(title)}" /></td>
            <td>
              ${product.custom_features ? `${product.custom_features}` : escapeHtml(product.type)}
            </td> 
            <td>${escapeHtml(product.title)}</td> <td>${escapeHtml(product.vendor)}</td>
            <td class="table-unitPrice">₱${product.price.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</td>
            <td class="table-qty">${product.quantity}</td>
            <td>${unitDisplay}</td>
            <td class="table-amountPrice">₱${(product.price * product.quantity).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</td>
            <td class="table-note">${escapeHtml(product.note)}</td> <td class="action-buttons-cell"><button class="edit-btn2" type="button" data-id="${product.id}">Edit</button></td>
            <td class="action-buttons-cell"><button class="delete-btn2" type="button" data-id="${product.id}">Delete</button></td>
          `;
          quotationDetails.appendChild(newRow);
          const deleteButton = newRow.querySelector('.delete-btn2');
          deleteButton.addEventListener('click', () => deleteRowC(newRow, product.id));
          const editButton = newRow.querySelector('.edit-btn2');
          editButton.addEventListener('click', () => editQtyC(newRow, product.id, product));
        });

        updateTotals();
        checkInputs(); // Call checkInputs after products are loaded
      })
      .catch(error => console.error('Error fetching quotation products:', error));
    }

    function escapeHtml(unsafe) {
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function formatCurrency(amount) {
      return `₱${amount.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}`;
    }

    function updateTotals() {
      const rows = document.querySelectorAll('tbody.quotation-tbody-style tr');
      let sumValC = 0;

      rows.forEach(row => {
        const productPriceC = row.querySelector('.table-unitPrice').textContent;
        const productQtyC = row.querySelector('.table-qty').textContent;

        const parsedPriceC = parseFloat(productPriceC.replace(/₱/g, '').replace(/,/g, ''));
        const parsedQtyC = parseInt(productQtyC, 10);

        const productAmountPriceC = parsedPriceC * parsedQtyC;
        sumValC += productAmountPriceC;

        const amountPriceCell = row.querySelector('.table-amountPrice');
        if (amountPriceCell) {
          amountPriceCell.textContent = formatCurrency(productAmountPriceC);
        }
      });

      document.querySelector('#totalAmountPrice').textContent = formatCurrency(sumValC);
    }

    function deleteRowC(row, metafieldId) {
      row.remove();
      fetch(`https://quotation-api.channel.com.ph/quotation/metafields/${metafieldId}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(res => {
        if (res.ok) {
          console.log('Metafield deleted successfully.');
          updateTotals();
          checkInputs(); // Call checkInputs after a row is deleted
        } else {
          console.error('Error deleting metafield:', res.statusText);
        }
      })
      .catch(error => console.error('Error:', error));
    }

    function editQtyC(row, metafieldId, product) {
      const editButtonC = row.querySelector('.edit-btn2');
      const qtyCellC = row.querySelector('.table-qty');
      const noteCellC = row.querySelector('.table-note');
      const currentQtyC = qtyCellC.textContent;
      const currentNoteC = noteCellC.textContent;

      if (editButtonC.textContent === 'Edit') {
        qtyCellC.innerHTML = `<input type="number" value="${currentQtyC}" class="edit-qty" min="1" />`;
        noteCellC.innerHTML = `<input type="text" value="${currentNoteC}" class="edit-note" />`;
        editButtonC.textContent = 'Save';
      } else {
        const inputFieldC = qtyCellC.querySelector('.edit-qty');
        const newQtyC = inputFieldC.value;
        const inputFieldNote = noteCellC.querySelector('.edit-note');
        const newNote = inputFieldNote.value;
        if (isNaN(newQtyC) || newQtyC <= 0) {
          console.error("Please enter a valid quantity."); // Changed alert to console.error
          return;
        }

        noteCellC.textContent = newNote;
        qtyCellC.textContent = newQtyC;
        editButtonC.textContent = 'Edit';
        updateTotals();

        const updatedProduct = {
          ...product,
          quantity: newQtyC,
          note: newNote
        };

        fetch(`https://quotation-api.channel.com.ph/quotation/metafields/${metafieldId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            metafield: {
              id: metafieldId,
              value: JSON.stringify(updatedProduct),
              type: 'json'
            }
          })
        })
        .then(res => {
          if (res.ok) {
            console.log('Metafield updated successfully.');
          } else {
            console.error('Error updating metafield:', res.statusText);
          }
        })
        .catch(error => console.error('Error:', error));
      }
    }

    fetchQuotationProducts();
  });
    </script>
