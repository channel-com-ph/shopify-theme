        });
        bankDetailsHtml += `</div>`;
        document.getElementById('quotation-bank-details').innerHTML = bankDetailsHtml;


        const tcT = document.querySelectorAll("input[name='title[]']");
        const tcD = document.querySelectorAll("textarea[name='description[]']");

        const resultsDiv = document.getElementById('editedVersion');
        resultsDiv.innerHTML = '';

        const formatSpecs = (specValue) => {
          return specValue.split('\n').map(line => {
            const trimmedLine = line.trim();

            if (trimmedLine === '') {
              return null;
            }

            if (trimmedLine.startsWith('• ')) {
              return trimmedLine.slice(2);
            }
            return '• ' + trimmedLine;
          }).filter(Boolean)
          .join('<br>');
        };

        tcT.forEach((title, index) => {
          const itemData = document.createElement('li');
          const itemValue = title.value.trim() || 'N/A';
          const specsValue = tcD[index]?.value ? formatSpecs(tcD[index].value) : 'N/A';

          if (specsValue === 'N/A') {
            itemData.innerHTML = `
              <span style="font-weight: bold; width: 100%;">${itemValue}</span>
            `;
          } else {
            itemData.innerHTML = `
              <span style="font-weight: bold; width: 25%;">${itemValue}</span>
              <span style="width: 75%;">${specsValue}</span>
            `;
          }

          resultsDiv.appendChild(itemData);
        });

        // Do not reset the form, so user can see the download button
        // this.reset(); 
        console.log("Your data entered in the forms have been saved."); // Changed alert to console.log
      });

      function sendMail() {
    emailjs.init("uzfiB2iNH6YIYoPst");

    const messageContent = document.getElementById("quotation-customer-info");
    const messageContentHeader = "<h3 style='display: block;'> Customer Created a Quotation on their own </h3>";

    const table1 = document.getElementById("quotation-products-table");
    const table2 = document.getElementById("quotation-products-table2");
    const table3 = document.getElementById("quotation-products-table3");

    // Apply table styling
    [table1, table2, table3].forEach(table => {
        if (!table) return;

        const rows = table.querySelectorAll("tr");
        const ths = table.querySelectorAll("th");
        const tds = table.querySelectorAll("td");
        const imgs = table.querySelectorAll("img");
        const totalRows = table.querySelectorAll("#totalRow");

        for (let row of rows) {
            const cells = row.querySelectorAll("th, td");

            if (cells.length > 8) {
                cells[1].style.width = "15%";
                cells[2].style.width = "15%";
                cells[3].style.width = "10%";
                cells[4].style.width = "10%";
                cells[5].style.width = "5%";
                cells[6].style.width = "5%";
                cells[7].style.width = "15%";
                cells[8].style.width = "15%";
            }
        }

        for (let totalRow of totalRows) {
            totalRow.style.textAlign = "right";

            const totalRowCells = totalRow.querySelectorAll("td");

            if (totalRowCells.length === 3) {
                totalRowCells[0].colSpan = 5;
                totalRowCells[1].colSpan = 2;
                totalRowCells[2].colSpan = 1;
                totalRowCells[2].style.textAlign = "center";
            }
        }

        for (let th of ths) {
            th.style.border = "1px solid black";
            th.style.padding = "10px";
        }

        for (let td of tds) {
            td.style.border = "1px solid black";
            td.style.padding = "10px";

            if (td.cellIndex === 6) {
                td.style.textAlign = "right";
            }
        }

        for (let img of imgs) {
            img.remove();
        }
    });

    const messageTableHtml = table1.innerHTML;
    const messageTable2Html = table2.innerHTML;
    const messageTable3Html = table3.innerHTML;

    var params = {
        my_html:
            messageContentHeader +
            messageContent.innerHTML +
            messageTableHtml +
            messageTable2Html +
            messageTable3Html,
        isHtml: true,
    };

    const serviceID = "service_eg4wtpf";
    const templateID = "template_nrm5mbs";

    emailjs.send(serviceID, templateID, params)
        .then(res => {
            console.log("Sending mail...", res);
        })
        .catch(err => console.error("Error sending email:", err));
}

