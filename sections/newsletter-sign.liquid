{{ 'quotation-form-styles.aio.min.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {% if customer %}
    <div id="popup-div">
      <h2 style="margin: auto; text-align: center;">Newsletter</h2>
      <p  style="margin: auto; text-align: center; padding-top: 32px; padding-bottom: 32px;">Do you want to keep updated on our products?</p>
      <span style="display: flex; justify-content: center; gap: 30px; margin: auto;">
      <span style="display: flex; width: auto;"><a href="/" 
              id="newsYes"
              style="display: flex; justify-content: center; border: 1px solid rgb(var(--color-button)); background-color: rgb(var(--color-button)); color: rgb(var(--color-button-text)); width: 100px; padding: 10px; text-decoration: none;">Yes</a></span>
      <span style="display: flex; width: auto;"><a href="/" 
              id="newsNo"
              style="display: flex; justify-content: center; border: 1px solid rgb(var(--color-button)); color: rgb(var(--color-button)); width: 100px; padding: 10px; text-decoration: none;">No</a></span>
      </span>
    </div>
    {% endif %}
  </div>
</div>
<style>
  #popup-div {
    display: block;
    width: 500px;
    height: auto;
    background-color: rgb(var(--color-background));
    padding: 32px;
    margin: auto;
    box-shadow: 2px 2px 10px 0px rgba(0, 0, 0, 0.50);
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const customerEmail = "{{ customer.email }}";
    const customerId = "{{ customer.id }}"; 

    if (customerId) {
      document.getElementById('newsYes').addEventListener('click', function(event) {
        updateMarketingConsent(true);
        document.getElementById('popup-div').style.display = 'none';
      });

      document.getElementById('newsNo').addEventListener('click', function(event) {
        event.preventDefault(); 
        updateMarketingConsent(false);
        document.getElementById('popup-div').style.display = 'none';
      });
    }

    function updateMarketingConsent(subscribed) {
      fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          customer: {
            accepts_marketing: subscribed
          }
        })
      })
      .then(response => response.json())
      .then(data => {
        console.log('Customer marketing consent updated:', data);
      })
      .catch(error => {
        console.error('Error updating marketing consent:', error);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Newsletter-SignUp",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
"presets": [
  {
    "name": "Newsletter-SignUp"
  }
]
}
{% endschema %}
