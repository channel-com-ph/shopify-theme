{{ 'customer.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom styles for the password toggle icon */
  .field.password-field-wrapper {
    position: relative; /* Ensure the icon is positioned relative to this container */
  }

  .password-toggle-icon {
    position: absolute;
    right: 10px; /* Adjust as needed to position the icon */
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    width: 20px; /* Size of the icon */
    height: 20px; /* Size of the icon */
    z-index: 10; /* Ensure icon is above the input */
  }


  #CustomerPassword {
    padding-right: 40px !important; 
  }


{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div
  class="customer login section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} page-width"
  style="margin: 50px auto; box-shadow: 2px 2px 10px 0px rgba(0,0,0,0.50); padding-left: 32px; padding-right: 32px;"
>
  <h1 id="recover" tabindex="-1">
    {{ 'customer.recover_password.title' | t }}
  </h1>
  <div>
    <p>
      {{ 'customer.recover_password.subtext' | t }}
    </p>

    {%- form 'recover_customer_password' -%}
      {% assign recover_success = form.posted_successfully? %}
      <div class="setCol">
        <div class="field">
          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="RecoverEmail-email-error"
              autofocus
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
          <label for="RecoverEmail">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
      </div>
      {%- if form.errors -%}
        <small id="RecoverEmail-email-error" class="form__message">
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          {{ form.errors.messages.form }}
        </small>
      {%- endif -%}

      <button>
        {{ 'customer.login_page.submit' | t }}
      </button>

      <a href="#login">
        {{ 'customer.login_page.cancel' | t }}
      </a>
    {%- endform -%}
  </div>

  <h1 id="login" tabindex="-1">
    {{ 'customer.login_page.title' | t }}
  </h1>
  <div>
    {%- if recover_success == true -%}
      <h3 class="form__message" tabindex="-1" autofocus>
        <span class="svg-wrapper">
          {{- 'icon-success.svg' | inline_asset_content -}}
        </span>
        {{ 'customer.recover_password.success' | t }}
      </h3>
    {%- endif -%}
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      <!-- added | <input type="hidden" name="checkout_url" value="/">  -->

      <input type="hidden" name="return_to" value="/">
      
      <!--
        {%- if form.errors -%}
          <h3 class="form__message" tabindex="-1" autofocus>
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <span class="svg-wrapper" style="width: 40px;">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            {{ 'templates.contact.form.error_heading' | t }}
          </h3>
          {{ form.errors | default_errors }}
        {%- endif -%}
      -->

      {%- if form.errors -%}
        <div style="background-color: rgba(var(--color-button), 0.6); font-size: 12px;padding: 10px; text-decoration: none; display: flex; align-items: center; margin: auto; color: #fff;">
          <small
            class="form__message"
            tabindex="-1"
            style="display: flex; align-items: center; margin: auto; gap: 10px; list-style-decoration: none;"
          >
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ form.errors | default_errors }}
          </small>
        </div>
      {%- endif -%}

      {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
        <section name="sign-in-with-shop-provider">
          {{ shop | login_button: hide_button: hide_shop_login_button }}

          {%- unless hide_shop_login_button -%}
            <p>
              {{ 'customer.login_page.alternate_provider_separator' | t }}
            </p>
          {%- endunless -%}
        </section>
      {%- endif -%}

      <div class="setCol">
        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
            minlength="20"
            maxlength="35"
          >
          <label for="CustomerEmail">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
      </div>
      {%- if form.password_needed -%}
        <div class="setCol">
          <div class="field password-field-wrapper"> 
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ 'customer.login_page.password' | t }}"
              minlength="8"
              maxlength="20"
            >
            <label for="CustomerPassword">
              {{ 'customer.login_page.password' | t }}
            </label>
            
            <img
                id="togglePassword"
                src="https://img.icons8.com/ios/50/closed-eye.png"
                alt="Show password"
                class="password-toggle-icon"
            />
          </div>
        </div>
        <a href="#recover">
          {{ 'customer.login_page.forgot_password' | t }}
        </a>
      {%- endif -%}

      <button>
        {{ 'customer.login_page.sign_in' | t }}
      </button>
      <span>
        <small>Don't have an account?</small>
        <a id="create-acc-btn" href="{{ routes.account_register_url }}" style="text-transform: uppercase;">
          {{ 'customer.login_page.create_account' | t }}
        </a>
      </span>
    {%- endform -%}
  </div>

  {%- if shop.checkout.guest_login -%}
    <div>
      <hr>
      <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

      {%- form 'guest_login' -%}
        <button>
          {{ 'customer.login_page.guest_continue' | t }}
        </button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('CustomerPassword');

    if (togglePassword && passwordInput) {
      togglePassword.addEventListener('click', function() {
        // Toggle the type attribute
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);

        // Toggle the eye icon and alt text based on the new type
        if (type === 'password') {
          this.src = 'https://img.icons8.com/ios/50/closed-eye.png';
          this.alt = 'Show password';
        } else {
          this.src = 'https://img.icons8.com/external-smashingstocks-hand-drawn-black-smashing-stocks/99/external-eye-password-security-cyber-attack-hacking-smashingstocks-hand-drawn-black-smashing-stocks.png';
          this.alt = 'Hide password';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    }
  ]
}
{% endschema %}
