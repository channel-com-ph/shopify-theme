<script>
  window.addEventListener('load', () => {
    // --- Standard setup for Shopify's country/province selector ---
    if (typeof CustomerAddresses === 'undefined') {
      console.warn("CustomerAddresses class not found. Country/province selectors may not work dynamically.");
    } else {
      new CustomerAddresses();
    }

    // --- Get references to all the key elements on the page ---
    const addNewAddressButton = document.getElementById('AddNewAddressButton');
    const addNewAddressFormContainer = document.getElementById('AddNewAddressFormContainer');
    const activeEditFormContent = document.getElementById('active-edit-form-content');
    const allEditButtons = document.querySelectorAll('.button-edit');
    const allDeleteButtons = document.querySelectorAll('.button-delete');

    // --- Function to reset the right-hand panel to its default state ---
    function resetRightPane() {
      activeEditFormContent.innerHTML = '<p class="text-gray-500 italic">Select an address to edit or add a new one.</p>';
      activeEditFormContent.classList.remove('has-content');
    }

    // --- Logic for the "Add New Address" button ---
    if (addNewAddressButton && addNewAddressFormContainer && activeEditFormContent) {
      addNewAddressButton.addEventListener('click', () => {
        resetRightPane();
        const clonedAddForm = addNewAddressFormContainer.cloneNode(true);
        clonedAddForm.removeAttribute('id');
        clonedAddForm.classList.remove('hidden-form-container');
        activeEditFormContent.innerHTML = '';
        activeEditFormContent.appendChild(clonedAddForm);
        activeEditFormContent.classList.add('has-content');
        addNewAddressButton.setAttribute('aria-expanded', 'true');
        
        const formTitle = activeEditFormContent.querySelector('.title');
        if (formTitle) formTitle.focus({ preventScroll: true });

        const clonedAddFormCancelButton = activeEditFormContent.querySelector('[data-action="cancel-add-form"]');
        if (clonedAddFormCancelButton) {
          clonedAddFormCancelButton.addEventListener('click', (e) => {
            e.preventDefault();
            resetRightPane();
            addNewAddressButton.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }

    // --- Logic for all "Edit" buttons ---
    allEditButtons.forEach(button => {
      button.addEventListener('click', (event) => {
        const addressId = event.currentTarget.dataset.addressId;
        const originalEditFormContainer = document.getElementById(`EditAddress_${addressId}`);
        if (originalEditFormContainer && activeEditFormContent) {
          if (addNewAddressButton) {
            addNewAddressButton.setAttribute('aria-expanded', 'false');
          }
          resetRightPane();
          const clonedEditForm = originalEditFormContainer.cloneNode(true);
          clonedEditForm.removeAttribute('id');
          clonedEditForm.classList.remove('hidden-form-container');
          activeEditFormContent.innerHTML = '';
          activeEditFormContent.appendChild(clonedEditForm);
          activeEditFormContent.classList.add('has-content');
          
          const formTitle = activeEditFormContent.querySelector('.title');
          if (formTitle) formTitle.focus({ preventScroll: true });

          const clonedEditFormCancelButton = activeEditFormContent.querySelector('[data-action="cancel-edit-form"]');
          if (clonedEditFormCancelButton) {
            clonedEditFormCancelButton.addEventListener('click', (e) => {
              e.preventDefault();
              resetRightPane();
            });
          }
        }
      });
    });

    // --- Logic for all "Delete" buttons ---
    allDeleteButtons.forEach(button => {
      button.addEventListener('click', (event) => {
        const confirmMessage = event.currentTarget.dataset.confirmMessage;
        if (window.confirm(confirmMessage || 'Are you sure you wish to delete this address?')) {
          const targetUrl = event.currentTarget.dataset.target;
          if (targetUrl) {
            const form = document.createElement('form');
            form.method = 'post';
            form.action = targetUrl;
            const methodInput = document.createElement('input');
            methodInput.type = 'hidden';
            methodInput.name = '_method';
            methodInput.value = 'delete';
            form.appendChild(methodInput);
            document.body.appendChild(form);
            form.submit();
          }
        }
      });
    });
    
    // --- Initial page setup ---
    if (addNewAddressFormContainer) {
      addNewAddressFormContainer.classList.add('hidden-form-container');
      if (addNewAddressButton) {
        addNewAddressButton.setAttribute('aria-expanded', 'false');
      }
    }
    resetRightPane();

    const errorElement = document.querySelector('#AddNewAddressFormContainer .form__message, #AddNewAddressFormContainer .errors');
    
    // If an error message exists, we now safely click the button.
    if (errorElement && addNewAddressButton) {
      addNewAddressButton.click();
    }
  });
</script>

