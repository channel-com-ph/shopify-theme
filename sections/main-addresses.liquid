{{ 'customer.aio.min.css' | asset_url | stylesheet_tag }}

<script src="{{ 'customer.js' | asset_url }}" defer></script>


{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Main container for the customer addresses page */
  .customer-addresses-container {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
    padding-right: 2rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
    border-radius: 1rem;
  }

  /* Main page title styling (centered above the columns) */
  .main-page-title {
    font-size: 4rem;
    font-weight: 700;
    color: #1f2937;
    text-align: center;
    margin-bottom: 2.5rem;
    letter-spacing: -0.04em;
  }

  /* Return link styling */
  .return-link {
    color: #4b5563;
    text-decoration: underline;
    margin-bottom: 3.5rem;
    display: block;
    text-align: center;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .return-link:hover {
    text-decoration: underline;
    color: black;
  }

  /* Two-column layout for medium and larger screens */
  .customer-addresses-grid {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  @media screen and (min-width: 750px) {
    .customer-addresses-grid {
      flex-direction: row;
    }
    .customer-addresses-left-column {
      width: 50%;
      flex-shrink: 0;
    }
    .customer-addresses-right-column {
      width: 50%;
    }
  }

  /* General typography styles for sub-titles */
  .title {
    font-size: 2.8rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 2rem;
    text-align: left;
  }

  /* Address card styles */
  .address-card {
    padding: 2.5rem;
    background-color: #ffffff;
    border-radius: 1rem;
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.12), 0 4px 8px -2px rgba(0, 0, 0, 0.06);
    border: 1px solid #e5e7eb;
    margin-bottom: 2.5rem;
  }

  /* Default address title styling (made more prominent) */
  .address-card h2.default-address-title {
    font-size: 2rem;
    font-weight: 800;
    color: black;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 4px solid grey;
    padding-bottom: 0.75rem;
    display: inline-block;
  }

  .address-card-content {
    color: #374151;
    line-height: 1.8;
    font-size: 1.50rem;
    margin-bottom: 1.75rem;
  }

  .address-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  /* Button base styles */
  .button-base {
    font-weight: 600;
    padding: 1.125rem 2.25rem;
    border-radius: 0.75rem;
    transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
    transition-duration: 300ms;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12), 0 3px 6px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    border: none;
    display: inline-block;
    text-align: center;
    text-decoration: none;
    font-size: 1.125rem;
  }

  .button-full-width {
    width: 100%;
    margin-bottom: 1.75rem;
  }

  /* Primary action button (Add New, Update) */
  .button-primary {
    color: #ffffff;
  }
  .button-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
  }
  .button-primary.add-button {
    background-color: #8a1a1a;
  }
  .button-primary.add-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
  }

  /* Edit button */
  .button-edit {
    color: white;
    padding: 0.875rem 1.5rem;
    font-size: 1.05rem;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08);
  }
  .button-edit:hover {
    background-color: #8a1a1a;
    transform: translateY(-2px);
  }

  /* Delete button */
  .button-delete {
    color: #ffffff;
    padding: 0.875rem 1.5rem;
    font-size: 1.05rem;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08);
  }
  .button-delete:hover {
    transform: translateY(-2px);
  }

  /* Cancel button */
  .button-cancel {
    background-color: #e5e7eb;
    color:rgb(255, 255, 255);
  }
  .button-cancel:hover {
    background-color: #d1d5db;
    transform: translateY(-2px);
  }

  /* Form field styles */
  .form-field {
    margin-bottom: 1.75rem;
  }

  .form-input {
    width: 100%;
    padding: 1.125rem;
    font-size: 1.50rem;
    border: 1px solid #d1d5db;
    border-radius: 0.625rem;
    outline: none;
  }
  .form-input:focus {
    outline: 3px solid #3b82f6;
    border-color: transparent;
  }

  .form-label {
    display: block;
    font-size: 1.15rem;
    color: #4b5563;
    margin-bottom: 0.625rem;
  }

  .required-asterisk {
    color: red;
  }

  .form-select {
    display: block;
    appearance: none;
    width: 100%;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    color: #374151;
    padding: 1.125rem 1.5rem;
    padding-right: 3rem;
    border-radius: 0.625rem;
    line-height: 1.6;
    font-size: 1.60rem;
    outline: none;
  }
  .form-select:focus {
    outline: none;
    background-color: #ffffff;
    border-color: #3b82f6;
  }

  .select-wrapper {
    position: relative;
  }
  .select-wrapper .svg-caret {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    padding-inline: 1rem;
    color: #374151;
    pointer-events: none;
    height: 100%;
  }

  /* Checkbox styling */
  .checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .checkbox-label {
    font-size: 1.25rem;
    color: #374151;
  }

  /* Form button group */
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }
  .form-actions .button-base {
    flex-grow: 1;
    min-width: 140px;
  }

  /* Pagination styles */
  .pagination {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  .pagination ul {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pagination li a,
  .pagination li span {
    display: block;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background-color: #ffffff;
    transition-property: background-color, border-color;
    transition-duration: 200ms;
    text-decoration: none;
    color: #374151;
    font-size: 2rem;
  }
  .pagination li a:hover {
    background-color: #f3f4f6;
  }

  .pagination li span[aria-current="page"] {
    border-color: #3b82f6;
    background-color: #3b82f6;
    color: #ffffff;
    font-weight: 600;
  }

  .pagination li span.cursor-not-allowed {
    background-color: #e5e7eb;
    cursor: not-allowed;
  }

  /* SVG icon rotations for pagination arrows */
  .svg-arrow-prev {
    display: inline-block;
    transform: rotate(90deg);
  }
  .svg-arrow-next {
    display: inline-block;
    transform: rotate(-90deg);
  }

  /* Utility for hiding forms */
  .hidden-form-container {
    display: none;
  }

  /* Styling for the right edit pane when active */
  #active-edit-form-content {
    min-height: 300px;
    padding: 2.5rem;
    background-color: #f9fafb;
    border-radius: 1rem;
    border: 1px dashed #d1d5db;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 1.25rem;
  }
  #active-edit-form-content.has-content {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.12), 0 4px 8px -2px rgba(0, 0, 0, 0.06);
    display: block;
  }
{%- endstyle -%}

{%- paginate customer.addresses by 5 -%}
