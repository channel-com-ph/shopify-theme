                  Pick up from the store for on stock items within a 1-5 day duration from the Purchase Order with down
                  payment.
                </li>
                <li>
                  Delivery for on stock items within an 8-10 day duration from the Purchase Order with a down payment.
                </li>
                <li>Order based items within a 21-45 days duration from the Purchase Order with down payment.</li>
              </ul>

              <p style="margin: 2px 0; font-size: 10px;">
                <strong>D. Purchase Orders made (especially with down payment) are not cancelable.</strong>
              </p>
              <p style="margin: 2px 0; font-size: 10px;">
                <strong>E. All items are on first come first served basis.</strong>
              </p>
              <p style="margin: 2px 0; font-size: 10px;">
                <strong
                  >F. If payment for the balance is also check, it has to be cleared first before we release the items.</strong
                >
              </p>
            </div>

            <div style="width: 70%; margin: 20px auto 0; text-align: left;">
              <p style="margin: 5px 0; font-weight: bold; font-size: 12px; color: darkred;">Conforme:</p>
              <div class="signature-line-container">
                <p style="font-size: 8px !important;"><strong>Signature of the Owner/Representative Over Printed Name</strong></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
    
      let sumVal = 0; 

        const productAmountPrice = parseFloat(productPrice.replace(/₱/g, '').replace(/,/g, '')) * parseInt(productQty);
    
        const tableBody = document.querySelector('tbody');
        const newRow = document.createElement('tr');
        newRow.innerHTML = `
          <td><img src="${productImage}" alt="${productModel}" /></td>
          <td>${productItem}</td>
          <td>${productModel}</td>
          <td>${productBrand}</td>
          <td>${productPrice}</td>
          <td class="qty-cell">${productQty}</td>
          <td>${productQtyUnit}</td>
          <td>${formatCurrency(productAmountPrice)}</td>
          <td>${productNote}</td>
          <td id="edit-col"><button class="edit-btn" type="button">Edit</button></td>
          <td id="delete-col"><button class="delete-btn" type="button">Delete</button></td>
        `;
    
        tableBody.appendChild(newRow);
        const blankRow = tableBody.querySelector('#blank');
        if (blankRow) {
          blankRow.remove();
            checkInputs();
        } 
        
        sumVal += productAmountPrice; 
        document.querySelector('#totalAmountPrice').textContent = formatCurrency(sumVal);
    
        newRow.querySelector('.delete-btn').addEventListener('click', () => deleteRow(newRow, productAmountPrice));
        newRow.querySelector('.edit-btn').addEventListener('click', () => editQty(newRow));
    
        selectProduct.selectedIndex = 0; 
        qty.value = 1; 
      }

      function deleteRow(row, productAmountPrice) {
        sumVal -= productAmountPrice; 
        row.remove(); 
        document.querySelector('#totalAmountPrice').textContent = formatCurrency(sumVal); 
      }

      const units = [
          {% assign units = shop.metaobjects.quantity_units.values %}
          {% for unit in units %}
            { name: '{{ unit.name }}' }{% if forloop.last == false %}, {% endif %}
          {% endfor %}
        ];
      
      function editQty(newRow) {
        const editButton = newRow.querySelector('.edit-btn');
        const qtyCell = newRow.querySelector('.qty-cell');
        const priceCell = newRow.querySelector('td:nth-child(5)'); 
        const unitCell = newRow.querySelector('td:nth-child(7)'); 
        const noteCell = newRow.querySelector('td:nth-child(9)'); 
        const currentQty = qtyCell.textContent;
        const currentPriceText = priceCell.textContent.replace(/₱/g, '').replace(/,/g, ''); 
        const currentAmountPrice = parseFloat(newRow.querySelector('td:nth-child(8)').textContent.replace(/₱/g, '').replace(/,/g, ''));
        const currentNote = noteCell.textContent;
        
        if (editButton.textContent === 'Edit') {
          qtyCell.innerHTML = `<input type="number" value="${currentQty}" class="edit-qty" min="1" />`;
          priceCell.innerHTML = `<input type="text" value="${currentPriceText}" class="edit-price" />`; 
          noteCell.innerHTML = `<input type="text" value="${currentNote}" class="edit-note" />`; 
    
          let unitOptions = units.map(unit => `<option value="${unit.name}">${unit.name}</option>`).join('');
          unitCell.innerHTML = `<select class="edit-unit">${unitOptions}</select>`;
    
          editButton.textContent = 'Save';
        } else {
          const inputQtyField = qtyCell.querySelector('.edit-qty');
          const inputPriceField = priceCell.querySelector('.edit-price');
          const selectedUnit = unitCell.querySelector('.edit-unit').value;
          const inputNoteField = noteCell.querySelector('.edit-note').value;
          
          const newQty = parseInt(inputQtyField.value, 10); 
          const newPrice = parseFloat(inputPriceField.value.replace(/₱/g, '').replace(/,/g, '')); 
    
          if (isNaN(newQty) || newQty <= 0) {
            alert("Please enter a valid quantity.");
            return;
          }
    
          if (isNaN(newPrice) || newPrice <= 0) {
            alert("Please enter a valid price.");
            return;
          }
    
          qtyCell.textContent = newQty;
          priceCell.textContent = formatCurrency(newPrice); 
          unitCell.textContent = selectedUnit; 
          noteCell.textContent = inputNoteField;
    
          const newAmountPrice = newPrice * newQty; 
    
          sumVal = sumVal - currentAmountPrice + newAmountPrice; 
          newRow.querySelector('td:nth-child(8)').textContent = formatCurrency(newAmountPrice);
          document.querySelector('#totalAmountPrice').textContent = formatCurrency(sumVal); 
    
          editButton.textContent = 'Edit';
        }
      }




      // Initially disable the button
      const saveBtn = document.getElementById('quotation-download-btn');
      saveBtn.style.border = "1px solid transparent";
      saveBtn.style.color = "rgba(var(--color-foreground), 0.50)";
      saveBtn.style.backgroundColor = "rgba(var(--color-foreground), 0.40)";
      saveBtn.style.cursor = "default";
      function checkInputs() {
        const tableBody = document.querySelector('tbody');
        const fName = document.getElementById('inputFName').value.trim();
        // const lName = document.getElementById('inputLName').value.trim();
        const cName = document.getElementById('inputCName').value.trim();
        const phone = document.getElementById('inputPhone').value.trim();
        const email = document.getElementById('inputEmail').value.trim();
        const jobnum = document.getElementById('inputJobNum').value.trim();
        const project = document.getElementById('inputProject').value.trim();
        const blankElement = document.getElementById('blank'); 
        const isBlankRemoved = blankElement === null;
  
        const tableRows = document.querySelectorAll('tbody tr'); 
        const trCount = tableRows.length;
        console.log('Is blank div removed:', isBlankRemoved);
        console.log('Number of <tr> elements:', trCount);
    
        console.log(fName, cName, phone, email, project, jobnum, blankElement);

          if (fName !== "" && cName !== "" && phone !== "" && email !== "" && project !== "" && jobnum !== "" && isBlankRemoved && trCount >= 0) {
            saveBtn.style.border = "1px solid rgb(var(--color-button))";
            saveBtn.style.color = "rgb(var(--color-button))";
            saveBtn.style.backgroundColor = "transparent";
            saveBtn.style.cursor = "pointer"; 
            
            saveBtn.addEventListener('mouseenter', function() {
              saveBtn.style.backgroundColor = "rgb(var(--color-button))"; 
              saveBtn.style.color = "rgb(var(--color-button-text))";
            });
            saveBtn.addEventListener('mouseleave', function() {
              saveBtn.style.backgroundColor = "transparent"; 
              saveBtn.style.color = "rgb(var(--color-button))";
            });
          } else {
            saveBtn.style.border = "1px solid transparent";
            saveBtn.style.color = "rgba(var(--color-foreground), 0.50)";
            saveBtn.style.backgroundColor = "rgba(var(--color-foreground), 0.40)";
            saveBtn.style.cursor = "default"; 
          }
      }
  
      document.getElementById('inputFName').addEventListener('input', checkInputs);
      // document.getElementById('inputLName').addEventListener('input', checkInputs);
      document.getElementById('inputCName').addEventListener('input', checkInputs);
      document.getElementById('inputPhone').addEventListener('input', checkInputs);
      document.getElementById('inputEmail').addEventListener('input', checkInputs);
      document.getElementById('inputJobNum').addEventListener('input', checkInputs);
      document.getElementById('inputProject').addEventListener('input', checkInputs);
      
      document.getElementById('form').addEventListener('submit', function(event) {
        event.preventDefault(); 
    
        const fName = document.getElementById('inputFName').value;
        // const lName = document.getElementById('inputLName').value;
        // const fullName = `${fName} ${lName}`;
        const company = document.getElementById('inputCName').value;
        const phone = document.getElementById('inputPhone').value;
        const email = document.getElementById('inputEmail').value;
        const project = document.getElementById('inputProject').value;
        const jobNum = document.getElementById('inputJobNum').value;
        const preparedBy = 'channel.com.ph';
        const table = document.getElementById('quotation-table');
    
        const updatedRows = [];
        const rows = table.getElementsByTagName('tr');
        const downloadBtn = document.getElementById('quotation-download-btn2');
        downloadBtn.style.display = "block";
        
        for (let row of rows) {
          const clonedRow = row.cloneNode(true);
          const deleteCol = clonedRow.querySelector('#delete-col');
          const editCol = clonedRow.querySelector('#edit-col');
  
          if (deleteCol) deleteCol.remove(); 
          if (editCol) editCol.remove(); 
  
          updatedRows.push(clonedRow.outerHTML);
        }

        let tableHtml = '';
        const numRows = updatedRows.length;
        
        if (numRows <= 7) {
          tableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${updatedRows.join('')}</tbody></table>`;
          document.getElementById('quotation-products-table').innerHTML = tableHtml;
          document.getElementById('quotation-products-table2').innerHTML = '';
          document.getElementById('quotation-products-table3').innerHTML = '';
        } else if (numRows >= 8 && numRows < 17) {
          const firstTableRows = updatedRows.slice(0, 7);
          const secondTableRows = updatedRows.slice(7);
        
          tableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${firstTableRows.join('')}</tbody></table>`;
          document.getElementById('quotation-products-table').innerHTML = tableHtml;
        
          const secondTableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${secondTableRows.join('')}</tbody></table>`;
          document.getElementById('quotation-products-table2').innerHTML = secondTableHtml;
          document.getElementById('quotation-products-table3').innerHTML = '';
        } else if (numRows >= 17) {
          const firstTableRows = updatedRows.slice(0, 7);
          const secondTableRows = updatedRows.slice(7, 16);
          const thirdTableRows = updatedRows.slice(16);
          tableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${firstTableRows.join('')}</tbody></table>`;
          document.getElementById('quotation-products-table').innerHTML = tableHtml;
        
          const secondTableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${secondTableRows.join('')}</tbody></table>`;
          document.getElementById('quotation-products-table2').innerHTML = secondTableHtml;
          const thirdTableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${thirdTableRows.join('')}</tbody></table>`;
          document.getElementById('quotation-products-table3').innerHTML = thirdTableHtml;
        } 
        
        const today = new Date().toLocaleString("en-US", { timeZone: "Asia/Manila" });
        const date = new Date(today);
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        const formattedDate = date.toLocaleDateString(undefined, options);

        document.getElementById('quotation-customer-info').innerHTML = `
          <div class="start-margin" style="font-size: 11px; line-height: 1.37;"><div class="start-margin-col"><strong>Attention:</strong> ${fName} <br>
          <strong>Company:</strong> ${company} <br>
          <strong>Contact Number:</strong> ${phone} <br>
          <strong>Email:</strong> ${email} <br>
          <strong>Project Title:</strong> ${project} <br></div>
          <div class="start-margin-col"><strong>Date:</strong> ${formattedDate} <br>
          <strong>Prepared by:</strong> ${preparedBy} <br>
          <strong>Job Number:</strong> ${jobNum} <br></div></div>
          
        `;
        
        this.reset();
        alert("Your data entered in the forms have been saved.");
      });

      window.onload = function () {
        document.getElementById("quotation-download-btn2").addEventListener("click", () => {
          const file = document.getElementById("file");
          const mainForm = document.getElementById("main-form");
        
          const dlBtn = document.getElementById("quotation-download-btn2");
          
          document.body.style.cursor = 'wait';
          mainForm.style.display = 'none';
          file.style.display = 'block';
          file.style.zIndex = '10000';
    
          var opt = {
            margin: [14.2, 12.7, 14.2, 12.7],
            filename: 'Quotation - channelcomph.pdf',
            image: { type: 'PNG', quality: 1 },
            html2canvas: { scale: 3, useCORS: true },
            jsPDF: {
              unit: 'mm',
              format: 'letter',
              orientation: 'portrait'
            },
            pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
          };
    
          if (file) {
              html2pdf().from(file).set(opt).toPdf().get('pdf').then(function(pdf) {
                  const totalPages = pdf.internal.getNumberOfPages();
                  const pageWidth = pdf.internal.pageSize.getWidth();
                  const pageHeight = pdf.internal.pageSize.getHeight();

                  // --- START: FOOTER SCRIPT ---
                  for (let i = 1; i <= totalPages; i++) {
                      pdf.setPage(i);

                      // ADD FOOTER
                      pdf.setFontSize(8);
                      pdf.setTextColor(150); // A light grey color

                      const footerY = pageHeight - 10;
                      pdf.text('This quotation is generated by: channel.com.ph', 12.7, footerY);
                      pdf.text('Email: sales@channel.com.ph | Tel.: +632 7738 2844', 12.7, footerY + 3);

                      // Add the page number at the bottom-center
                      pdf.setFontSize(10);
                      pdf.setTextColor(100); // A darker grey for the page number
                      pdf.text(
                          'Page ' + i + ' of ' + totalPages,
                          pageWidth / 2, // Center horizontally
                          pageHeight - 7, // Position vertically
                          { align: 'center' } // Ensure text is centered
                      );
                  }
                  // --- END: FOOTER SCRIPT ---

              }).then(() => {
                  mainForm.style.display = 'block';
                  file.style.display = 'none';
                  document.body.style.cursor = 'default';
              }).save();
                          
              setTimeout(() => {
                  sendMail();
                  sendMailClient();
              }, 5000);
              setTimeout(() => {
                  location.reload();
              }, 8000);
          } else {
              console.error("Element with ID 'file' not found.");
              document.body.style.cursor = 'default';
          }
        });
      };
    </script>
  </div>
</div>

