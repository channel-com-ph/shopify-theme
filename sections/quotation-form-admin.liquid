<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    /* --- NEW Repeating Watermark Style --- */
    #file {
      position: relative;
      /* This ensures the pseudo-element is positioned relative to the file container */
    }

#file::before {
  content: '';
  position: absolute;
  inset: 0;

  background-image: url('https://cdn.shopify.com/s/files/1/0676/7991/2122/files/Channel_Logo_-_Transparent.png?v=1727063299');
  background-repeat: repeat;
  background-size: 250px;
  background-position: 0 0;

  opacity: 0.05;
  transform: rotate(-20deg) scale(1.2);
  transform-origin: center;
  pointer-events: none;
  z-index: 0;
}
    
    /* Custom styles for the quotation table header and footer */
    .quotation-thead-style {
      background-color: #e0e0e0; /* Light Grey Background for header */
      color: #333;
    }
    
    .quotation-thead-style th,
    .quotation-thead-style span {
      color: #333; /* Ensure header text is dark */
    }
    
    .quotation-tfoot-style {
      color: darkred; /* Ensure footer text is darkred */
    }
    
    .quotation-tfoot-style #colVat strong {
      color: darkred; /* Ensure VAT INC. text is darkred */
      font-size: 10px !important; /* Adjusted VAT INC. font size */
    }
    
    /* Further refinements for a cohesive design */
    .quotation-table-style {
      border-collapse: collapse; /* Ensure borders are clean */
      width: 100%;
      margin-top: 20px;
      /* Apply border to the table, but also ensure cells have borders */
      border: 1px solid #d9d9d9; /* This will be the outer border */
      border-radius: 8px;
      overflow: hidden; /* Keep this for rounded corners clipping content */
    }
    
    .quotation-table-style th,
    .quotation-table-style td {
      padding: 10px 12px;
      border: 1px solid #d9d9d9; /* Apply borders to cells for inner lines */
      text-align: left;
      font-size: 1.2rem;
    }
    
    .quotation-tbody-style tr:nth-child(even) {
      background-color: white; /* Light stripe for readability */
    }
    
    .quotation-tbody-style tr:hover {
      background-color: white;
    }
    
    .quotation-table-style img {
      max-width: 80px;
      height: auto;
      display: block;
      margin: 0 auto;
    }
    
    /* New flexbox approach for header */
    .group {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      width: 100%;
      padding-top: 0;
    }
    
    .left-header-content {
      flex: 1;
      text-align: left;
      padding-right: 10px;
      padding-top: 0;
    }
    
    .right-header-content {
      flex-shrink: 0; /* Don't shrink */
      width: 30%; /* Adjusted width */
      text-align: right; /* Align content to the right */
      padding-top: 0; /* Removed top padding */
      padding-right: 10px; /* Added padding to the right */
    }
    
    .quotation-title {
      color: #8B0000;
      text-transform: uppercase;
      margin: 0; /* Remove default margins */
      font-size: 22px; /* Slightly smaller font size for prominence */
      font-weight: bold;
      text-align: right; /* Align to the right */
    }
    
    .company-name {
      font-size: 14px; /* Restored font size */
      margin: 0 0 2px 0; /* Adjusted margin */
      font-weight: bold;
      text-align: left; /* Align left */
    }
    
    .company-details {
      font-size: 11px; /* Adjusted font size for addresses/contact */
      margin: 0; /* Remove default margins */
      line-height: 1.2; /* Adjusted line height for tighter spacing */
      text-align: left; /* Ensure left alignment */
      padding: 0; /* Remove padding */
    }
    
    .company-logo {
      height: 35px; /* Slightly larger logo size */
      width: 150px;
      max-width: 150px; /* Max width for responsiveness */
      margin: 0 0 5px 0; /* Margin bottom and left alignment, removed top margin */
      padding: 0;
      display: block; /* Ensures proper positioning */
    }
    
    /* TABLES for PDF generation */
    #quotation-products-table,
    #quotation-products-table2,
    #quotation-products-table3 {
      width: 100%;
      border-collapse: collapse;
      margin: 0;
      padding: 0;
      border-radius: 8px;
      /* Crucial: To make the outer border visible with border-radius and overflow:hidden */
      border: 1px solid white; /* This will be the outer border for the table container */
      overflow: hidden; /* Needed for border-radius to work visually */
    }
    
    /* Apply borders to individual cells within the quotation product tables */
    #quotation-products-table td,
    #quotation-products-table2 td,
    #quotation-products-table3 td,
    #quotation-products-table th, 
    #quotation-products-table2 th,
    #quotation-products-table3 th {
      border: 1px solid   #d9d9d9 !important; /* Apply borders to cells and headers for inner lines */
    }
    
    /* Styling for tables generated for PDF */
    .file-table {
      width: 98%; /* Adjusted table width to 98% */
      margin-left: 0.5%;
      margin-right: auto;
      border-collapse: collapse;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid  #b3b3b3; /* Outer border for file-table */
      table-layout: fixed;
    }
    
    .file-table th,
    .file-table td {
      border: 1px solid white; /* Inner borders for file-table cells and headers */
      padding: 2px 4px;
      text-align: left;
      word-wrap: break-word;
      font-size: 9px;
    }
    
    /* Column widths for file-table */
    .file-table th:nth-child(1), .file-table td:nth-child(1) { width: 6%; } /* IMAGE */
    .file-table th:nth-child(2), .file-table td:nth-child(2) { width: 29%; }  /* ITEM KEY FEAT. */
    .file-table th:nth-child(3), .file-table td:nth-child(3) { width: 20%; }  /* MODEL */
    .file-table th:nth-child(4), .file-table td:nth-child(4) { width: 21%; }  /* BRAND */
    .file-table th:nth-child(5), .file-table td:nth-child(5) { width: 5%; }  /* UNIT PRICE */
    .file-table th:nth-child(6), .file-table td:nth-child(6) { width: 4%; }  /* QTY. */
    .file-table th:nth-child(7), .file-table td:nth-child(7) { width: 4%; }  /* UNIT */
    .file-table th:nth-child(8), .file-table td:nth-child(8) { width: 4%; }  /* AMOUNT */
    .file-table th:nth-child(9), .file-table td:nth-child(9) { width: 7%; }  /* NOTE */
    
    
    .file-table th {
      background-color: #e0e0e0;
      font-weight: bold;
      
    }
    
    /* Ensure top-left and top-right corners of the header are rounded */
    .file-table thead tr:first-child th:first-child {
      border-top-left-radius: 8px;
    }
    .file-table thead tr:first-child th:last-child {
      border-top-right-radius: 8px;
    }
    
    /* Ensure bottom-left and bottom-right corners of the last row are rounded */
    .file-table tbody tr:last-child td:first-child {
      border-bottom-left-radius: 8px;
    }
    .file-table tbody tr:last-child td:last-child {
      border-bottom-right-radius: 8px;
    }
    
    .quotation-footer {
      margin: 0;
      padding: 8px 0;
      background-color: #fff !important;
      border: 1px solid white; /* Border for the footer */
    }
    
    #quotation-products-table + #quotation-products-table2,
    #quotation-products-table2 + #quotation-products-table3 {
      border-width: 0.5px; /* Reduced thickness */
      margin-top: 0;
    }
    
    #totalRow {
      background-color: #e0e0e0 !important; /* Light Grey for total row */
      border: none; 
    }
    
    /* New style for images within the PDF table */
    .file-table img {
      max-width: 50px; /* Reduced image size for PDF */
      height: auto;
      display: block;
      margin: 0 auto;
    }
    
    /* Smaller font for footer sections */
    .quotation-footer p,
    .quotation-footer ul li {
      font-size: 10px !important; /* Adjusted for smaller font */
      line-height: 1.1; /* Slightly tighter line height */
    }
    
    .quotation-footer p strong {
      font-size: 11px !important; /* Keep strong tags slightly larger */
    }
    
    /* Signature line and text styling */
    .signature-line-container {
      width: 400px; /* Increased width to ensure text fits on one line */
      margin: 40px auto 5px 10%; /* Shift left by setting left margin to 10% and right to auto, increased top margin */
      text-align: left; /* Align content to the left within its container */
    }
    
    .signature-line-container p {
      border-top: 1px solid #000; /* Solid line */
      padding-top: 5px;
      font-size: 8px !important; /* Adjusted font size to be smaller and added !important */
      font-style: italic;
      white-space: nowrap; /* Force text to stay on one line */
      overflow: hidden; /* Hide overflow if text is still too long */
      text-overflow: ellipsis; /* Add ellipsis if text overflows */
      margin: 0; /* Remove default paragraph margin */
      display: block; /* Allows border to span width */
      text-align: center; /* Center the text within the block */
    }
    
    /* Removed text-decoration-line: overline from strong to prevent double line */
    .signature-line-container strong {
      /* text-decoration-line: overline; */
    }
    
    /* Styles for buttons */
    .action-buttons-cell {
      text-align: center; /* Center the buttons in their cells */
      vertical-align: middle; /* Vertically align buttons */
    }
    .action-buttons-cell button {
      padding: 4px 8px;
      font-size: 0.75rem;
      border-radius: 0.25rem;
      border: 1px solid #ccc;
      cursor: pointer;
      background-color: #f0f0f0;
      transition: background-color 0.2s;
      margin: 2px; /* Small margin between buttons if they are side-by-side */
      min-width: 50px; /* Ensure buttons have a minimum width */
    }
    .action-buttons-cell button:hover {
      background-color: #e0e0e0;
    }
    .action-buttons-cell .edit-btn2 {
      background-color: #2563eb; /* Blue */
      color: white;
      border-color: #2563eb;
    }
    .action-buttons-cell .edit-btn2:hover {
      background-color: #1d4ed8;
    }
    .action-buttons-cell .delete-btn2 {
      background-color: #dc2626; /* Red */
      color: white;
      border-color: #dc2626;
    }
    .action-buttons-cell .delete-btn2:hover {
      background-color: #b91c1c;
    }
  {%- endstyle -%}
