<label class="label-form">Search and Select a Product to be Quoted</label>

<input
  type="text"
  id="searchInput"
  placeholder="Search a Product"
  class="text-field-wide"
  autocomplete="off"
  style="margin-bottom: 5px;"
>

<div id="searchResults" class="text-field-options" style="margin-bottom: 16px; display:none;"></div>

<input type="hidden" id="selectedProductTitle" name="contact[Product]">

<div class="three-col">
  <label class="label-form width-col3">Number of Quantity</label>
  <input
    type="number"
    placeholder="Quantity"
    name="qty"
    value="1"
    class="text-field-small width-col3"
    id="inputQty"
    min="1"
    required
  >
  <span id="qtyUnit" class="width-col3">UNIT</span>
</div>

<button
  type="button"
  id="addProduct-btn"
  onclick="getProductData()"
  class="quotation-btn"
>
  <span style="display:flex;align-items:center;justify-content:center;gap:5px;">
    <span class="svg-wrapper" style="transform: scale(0.75);">
      {{- 'icon-plus.svg' | inline_asset_content -}}
    </span>
    ADD PRODUCT
  </span>
</button>

<script>
let debounceTimer;
let selectedProduct = {};

document.getElementById('searchInput').addEventListener('input', function () {
  clearTimeout(debounceTimer);
  const query = this.value.trim();

  if (query.length < 2) {
    document.getElementById('searchResults').style.display = 'none';
    return;
  }

  debounceTimer = setTimeout(() => {
    fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=10`)
      .then(res => res.json())
      .then(data => {
        const products = data.resources.results.products;
        let html = '';

        products.forEach(product => {
          html += `
            <div class="search-item"
              data-handle="${product.handle}"
              data-type="${product.type}"
              data-title="${product.title}"
              data-vendor="${product.vendor}"
              data-image="${product.image}"
            >
              <img src="${product.image}" alt="">
              <span>${product.title}</span>
            </div>
          `;
        });

        const results = document.getElementById('searchResults');
        results.innerHTML = html;
        results.style.display = 'block';
      });
  }, 300);
});

document.addEventListener('click', function (e) {
  const item = e.target.closest('.search-item');
  if (!item) return;

  document.getElementById('addProduct-btn').disabled = false;


  document.getElementById('searchInput').value = item.dataset.title;
  document.getElementById('selectedProductTitle').value = item.dataset.title;
  document.getElementById('searchResults').style.display = 'none';

  fetch(`/products/${item.dataset.handle}.js`)
    .then(res => res.json())
    .then(product => {
      selectedProduct = product;

      // Example metafield fallback
      document.getElementById('qtyUnit').innerText =
        product.metafields?.custom?.quantity_units?.name || 'UNIT';
    });
});


      function formatCurrency(value) {
        return '₱' + value.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }
      
function getProductData() {
  if (!selectedProduct || !selectedProduct.title) {
    alert('Please select a product');
    return;
  }

  const qty = parseInt(document.getElementById('inputQty').value, 10);
  if (isNaN(qty) || qty <= 0) {
    alert('Invalid quantity');
    return;
  }

  const price = selectedProduct.price / 100;
  const amount = price * qty;

  const tableBody = document.querySelector('#quotation-table tbody');
  const newRow = document.createElement('tr');

newRow.innerHTML = `
  <td>
    <img src="${selectedProduct.images && selectedProduct.images.length > 0 ? selectedProduct.images[0] : ''}" 
         alt="${selectedProduct.title || 'Product Image'}" />
  </td>
  <td>${selectedProduct.type || 'N/A'}</td> 
  <td>${selectedProduct.title || 'Untitled'}</td>
  <td>${selectedProduct.vendor || 'Unknown'}</td>
  <td>${formatCurrency(price || 0)}</td>
  <td class="qty-cell">${qty || 1}</td>
  <td>${document.getElementById('qtyUnit')?.innerText || ''}</td>
  <td>${formatCurrency(amount || 0)}</td>
  <td>${selectedProduct.note || 'None'}</td>
  <td id="edit-col"><button class="edit-btn" type="button">Edit</button></td>
  <td id="delete-col"><button class="delete-btn" type="button">Delete</button></td>
`;


  const blankRow = document.getElementById('blank');
  if (blankRow) blankRow.remove();

  tableBody.appendChild(newRow);

  sumVal += amount;
  document.getElementById('totalAmountPrice').textContent = formatCurrency(sumVal);

  newRow.querySelector('.delete-btn').addEventListener('click', () => {
    sumVal -= amount;
    newRow.remove();
    document.getElementById('totalAmountPrice').textContent = formatCurrency(sumVal);
  });

  newRow.querySelector('.edit-btn').addEventListener('click', () => editQty(newRow));

  document.getElementById('searchInput').value = '';
  document.getElementById('inputQty').value = 1;
  document.getElementById('addProduct-btn').disabled = true;

  selectedProduct = {};
}


</script>


