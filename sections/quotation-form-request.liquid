    document.getElementById("quotation-send-btn").addEventListener("click", async () => {
      const customerRequest = document.getElementById("file");
      const customerInfoElement = document.getElementById("quotation-customer-info");
      const scriptURL = 'https://script.google.com/macros/s/AKfycbx4RCrms6xjVvYvn0jBzcexgPHTuSICaRJGTs7Vye_OXQzpL_G703J-aUgQGYXZIbDB/exec'; 

      if (!customerRequest || !customerInfoElement) {
          console.error("Required elements for sending request are not found.");
          sendStatusMessage.textContent = "An internal error occurred. Please try again.";
          sendStatusMessage.className = "status-message error";
          sendStatusMessage.style.display = "block";
          return;
      }

      const customerName = document.getElementById("customerName")?.textContent.trim();
      const customerCompany = document.getElementById("customerCompany")?.textContent.trim();
      const customerContact = document.getElementById("customerContact")?.textContent.trim();
      const emailCustomer = document.getElementById("emailCustomer")?.textContent.trim();
      const projectName = document.getElementById("projectName")?.textContent.trim();
      const dateSubmitted = document.getElementById("dateSubmitted")?.textContent.trim();
      const jobNumber = document.getElementById("jobNumber")?.textContent.trim();
      
      // IMPORTANT: Get all file links from the hidden input for sending to Google Sheets
      const fileValue = document.getElementById('svyFileLink').value.trim() || 'N/A';

      const data = { customerName, customerCompany, customerContact, emailCustomer, projectName, dateSubmitted, jobNumber, fileValue };
      const formDataString = new URLSearchParams(data).toString();

      try {
        sendStatusMessage.textContent = "Sending request...";
        sendStatusMessage.className = "status-message loading";
        sendStatusMessage.style.display = "block";
        sendBtn.disabled = true;

        await fetch(scriptURL, {
          method: "POST",
          body: formDataString,
          headers: {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          mode: "no-cors"
        });

        console.log("Sent to Google Script (no-cors)");

        await Promise.all([sendMail(), sendMailClient()]);

        sendStatusMessage.textContent = "Request sent successfully!";
        sendStatusMessage.className = "status-message success";

        setTimeout(() => { location.reload(); }, 3000);

      } catch (error) {
        console.error("FULL ERROR DETAILS:", error);

        sendStatusMessage.textContent = "Failed: " + error.message;
        sendStatusMessage.className = "status-message error";

        sendBtn.disabled = false;
      }


    });
    </script>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fileInputsContainer = document.getElementById('file-inputs-container');
    const addFileBtn = document.getElementById('add-file-btn');
    const fileLinkInput = document.getElementById('svyFileLink');
    const liveUploadPreview = document.getElementById('live-upload-preview');

    const UPLOAD_URL_ENDPOINT = 'https://gcs-uploader-final.onrender.com/generate-upload-url';
    const DOWNLOAD_URL_ENDPOINT = 'https://gcs-uploader-final.onrender.com/generate-download-url';

    const handleFileUpload = (fileInput) => {
      fileInput.addEventListener('change', async (event) => {
        const file = event.target.files[0];
        if (!file) return;

        const wrapper = fileInput.parentElement;
        const statusMessage = wrapper.querySelector('.gcs-upload-status');

        statusMessage.textContent = 'Preparing to upload...';
        statusMessage.className = 'gcs-upload-status status-message loading';
        statusMessage.style.display = 'block';
        fileInput.disabled = true;

        try {
          const uploadUrlResponse = await fetch(UPLOAD_URL_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, contentType: file.type }),
          });
          const uploadUrlData = await uploadUrlResponse.json();
          if (!uploadUrlResponse.ok) throw new Error(uploadUrlData.error || 'Could not get upload link.');
          
          const { url, objectName } = uploadUrlData;
          statusMessage.textContent = 'Uploading...';

          const uploadResponse = await fetch(url, {
            method: 'PUT',
            body: file,
            headers: { 'Content-Type': file.type || 'application/octet-stream' },
          });
          if (!uploadResponse.ok) throw new Error('File upload to Google Cloud failed.');
          
          statusMessage.textContent = 'Upload complete. Generating link...';

          const downloadUrlResponse = await fetch(DOWNLOAD_URL_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ objectName: objectName }),
          });
          if (!downloadUrlResponse.ok) throw new Error('Could not get download link.');

          const downloadUrlData = await downloadUrlResponse.json();
          const secureFileUrl = downloadUrlData.url;

          fileLinkInput.value += secureFileUrl + '\n'; 

          statusMessage.textContent = `✅ Success! File "${file.name}" uploaded.`;
          statusMessage.className = 'gcs-upload-status status-message success';

          const linkElement = document.createElement('p');
          linkElement.innerHTML = `<strong>Uploaded:</strong> <a href="${secureFileUrl}" target="_blank" rel="noopener noreferrer" style="word-break: break-all;">${file.name}</a>`;
          liveUploadPreview.appendChild(linkElement);

        } catch (error) {
          console.error('Upload Error Details:', error);
          statusMessage.textContent = `❌ Error: ${error.message}`;
          statusMessage.className = 'gcs-upload-status status-message error';
          fileInput.disabled = false;
        }
      });
    };

    const addFileInput = () => {
      const newWrapper = document.createElement('div');
      newWrapper.className = 'file-input-wrapper';
      newWrapper.style.marginBottom = '15px';
      
      newWrapper.innerHTML = `
        <input type="file" class="gcs-file-input text-field-wide">
        <div class="gcs-upload-status status-message" style="margin-top: 10px; display: none;"></div>
      `;
      
      fileInputsContainer.appendChild(newWrapper);
      
      const newFileInput = newWrapper.querySelector('.gcs-file-input');
      handleFileUpload(newFileInput);
    };

    const initialFileInput = document.querySelector('.gcs-file-input');
    if (initialFileInput) {
      handleFileUpload(initialFileInput);
    }

    if (addFileBtn) {
      addFileBtn.addEventListener('click', addFileInput);
    }
  });
</script>
