      "settings": {
        "custom_liquid": "<footer class=\"site-footer\" role=\"contentinfo\">\n\n  <div class=\"footer-inner\">\n\n    <!-- NEED HELP BOX -->\n    <div class=\"footer-help-box\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0676/7991/2122/files/Channel_Logo_-_800x800_69b82952-e917-499c-b748-11c5b390d1ee.png?v=1763189839\"\n        alt=\"Channel Logo\"\n        class=\"fh-logo\">\n\n      <p class=\"fh-title\">Need Assistance?</p>\n      <p class=\"fh-sub\">Call your Sales Engineer.</p>\n\n      <hr class=\"fh-divider\">\n\n      <div class=\"fh-phones\">\n        <p><span>Landline</span>(+632) 7738-2844</p>\n        <p><span>Viber</span>(+63) 915-339-7985</p>\n        <p><span>Smart</span>(+63) 998-983-4535</p>\n      </div>\n\n      <p class=\"fh-email\">sales@channel.com.ph</p>\n\n    </div>\n\n    <!-- RIGHT COLUMNS -->\n    <div class=\"footer-columns\">\n\n      <div class=\"footer-col\">\n        <h4 class=\"footer-heading\">Company</h4>\n        <ul class=\"footer-list\">\n          <li><a href=\"/pages/about-us-company\">About Channel</a></li>\n          <li><a href=\"/pages/hours-of-operation\">Hours of Operation</a></li>\n          <li><a href=\"/pages/directions-parking\">Site Directory</a></li>\n          <li><a href=\"/pages/contact\">Contact Us</a></li>\n        </ul>\n      </div>\n\n      <div class=\"footer-col\">\n        <h4 class=\"footer-heading\">Customer Service</h4>\n        <ul class=\"footer-list\">\n          <li><a href=\"/pages/ordering-information\">Ordering Information</a></li>\n          <li><a href=\"/pages/payment-options\">Payments</a></li>\n          <li><a href=\"/pages/shipping-delivery\">Shipping</a></li>\n          <li><a href=\"/pages/return-policy\">Return Policy</a></li>\n          <li><a href=\"/pages/technical-support\">Technical Support</a></li>\n        </ul>\n      </div>\n\n      <div class=\"footer-col\">\n        <h4 class=\"footer-heading\">Help</h4>\n        <ul class=\"footer-list\">\n          <li><a href=\"/pages/faqs-in-quotation\">FAQ's in Quotation</a></li>\n          <li><a href=\"/pages/store-pickup\">Store Pickup</a></li>\n          <li><a href=\"/pages/quotation-guide\">Request for Quotation (RFQ)</a></li>\n          <li><a href=\"/collections\">Shop By Brand</a></li>\n          <li><a href=\"/pages/help\">All Help Topics</a></li>\n        </ul>\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- BOTTOM BAR -->\n  <div class=\"footer-bottom-bar\">\n    <div class=\"footer-address\">\n      <a href=\"https://d99e66-54.myshopify.com/\">Channel International Enterprises</a><br>\n      43 Don A. Roces Ave., Brgy. Paligsahan, Quezon City, Metro Manila, Philippines 1103\n    </div>\n    <div class=\"footer-links-right\">\n      <a href=\"https://maps.app.goo.gl/nZZnygqUVay95iJeA\" target=\"_blank\" rel=\"noopener\">Get Directions</a>\n      <a href=\"/pages/hours-of-operation\">Store Hours</a>\n    </div>\n  </div>\n\n  <p class=\"footer-copy\">© 2019 - 2026 channel.com.ph. All rights reserved.</p>\n\n\n<style>\n\n/* ── FOOTER BASE ── */\n.site-footer {\n  background: #D7D7D7;\n  border-top: 2px solid #8A0000;\n  font-family: Helvetica, Inter;\n  color: #000000;\n}\n\n/* ── MAIN LAYOUT ── */\n.footer-inner {\n  max-width: 1300px;\n  margin: 0 auto;\n  padding: 52px 40px 0;\n  display: flex;\n  gap: 60px;\n  align-items: flex-start;\n}\n\n/* ── HELP BOX ── */\n.footer-help-box {\n  flex-shrink: 0;\n  width: 300px;\n  background: #F3F3F3;\n  border: 1px solid #c4c4c4;\n  border-radius: 10px;\n  padding: 24px 22px;\n  text-align: center\n}\n\n.fh-logo {\n  width: 100px;\n  height: 100px;\n  border-radius: 50%;\n  object-fit: cover;\n  border: 2px solid #D7D7D7;\n  display: block;\n  margin-bottom: 14px;\n  margin: 0 auto 14px\n}\n\n.fh-title {\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: #8A0000;\n  text-transform: uppercase;\n  margin: 0 0 3px;\n}\n\n.fh-sub {\n  font-size: 13px;\n  color: #000000;\n  margin: 0 0 14px;\n}\n\n.fh-divider {\n  border: none;\n  border-top: 1px solid #D7D7D7;\n  margin: 0 0 14px;\n}\n\n.fh-phones p {\n  font-size: 13px;\n  font-weight: 600;\n  color: #222;\n  line-height: 2;\n  margin: 0;\n}\n\n.fh-phones p span {\n  display: inline-block;\n  font-weight: 400;\n  color: #000000;\n  min-width: 62px;\n}\n\n.fh-email {\n  margin-top: 12px;\n  font-size: 13px;\n  font-weight: 600;\n  color: #8A0000;\n}\n\n/* ── COLUMNS ── */\n.footer-columns {\n  flex: 1;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 36px;\n}\n\n.footer-heading {\n  font-size: 13.5px;\n  font-weight: 700;\n  letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: #8A0000;\n  margin: 0 0 16px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid #bfbfbf;\n}\n\n.footer-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.footer-list li {\n  margin-bottom: 9px;\n}\n\n.footer-list a {\n  font-size: 13.5px;\n  color:#000000;\n  text-decoration: none;\n}\n\n.footer-list a:hover {\n  color: #8A0000;\n}\n\n/* ── BOTTOM BAR ── */\n.footer-bottom-bar {\n  max-width: 1300px;\n  margin: 40px auto 0;\n  padding: 20px 40px;\n  border-top: 1px solid #bfbfbf;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.footer-address {\n  font-size: 12.5px;\n  color: #000000;\n  line-height: 1.7;\n}\n\n.footer-address a {\n  color: #000000;\n  text-decoration: none;\n  font-weight: 600;\n}\n\n.footer-address a:hover { color: #8A0000; }\n\n.footer-links-right {\n  display: flex;\n  gap: 20px;\n  font-size: 12.5px;\n}\n\n.footer-links-right a {\n  color: #000000;\n  text-decoration: none;\n}\n\n.footer-links-right a:hover { color: #8A0000; }\n\n.footer-copy {\n  text-align: center;\n  font-size: 11.5px;\n  color: #000000;\n  padding: 14px 40px 20px;\n  margin: 0;\n}\n\n/* ── MOBILE ── */\n@media (max-width: 768px) {\n  .footer-inner {\n    flex-direction: column;\n    padding: 36px 20px 0;\n    gap: 36px;\n    align