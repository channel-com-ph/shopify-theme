{{ 'section-main-page.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  <style>
/* REMOVE Shopify's narrow container */
.policy-fullwidth {
    max-width: 1400px !important;   /* now wide */
    width: 100% !important;
    margin: 0 auto !important;
}

/* Make the actual page content wider */
.policy-fullwidth .rte {
    max-width: 1400px !important;
    width: 100% !important;
}

/* Remove text-area auto-styles */
.rte * {
    width: auto !important;
}

/* Your side-by-side layout */
.policy-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 60px;
    max-width: 1400px;
    margin: 0 auto;
}

.privacy-policy-container {
    flex: 1;
    background: #fff;
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 0 12px rgba(0,0,0,0.08);
}

.contact-box {
    width: 400px;
    background: #fff;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 12px rgba(0,0,0,0.1);
}

</style>

{%- endstyle -%}

 <!----<div class="page-width page-width--narrow section-{{ section.id }}-padding">----> 
  <div class="page-width section-{{ section.id }}-padding policy-fullwidth">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
<script>
// Polyfill for NodeList.forEach (for older browsers like IE)
if (window.NodeList && !NodeList.prototype.forEach) {
    NodeList.prototype.forEach = function(callback, thisArg) {
        thisArg = thisArg || window;
        for (var i = 0; i < this.length; i++) {
            callback.call(thisArg, this[i], i, this);
        }
    };
}

// FAQ toggle script compatible with older browsers
document.addEventListener("DOMContentLoaded", function() {
    var questions = document.querySelectorAll('.faq-question');

    questions.forEach(function(q) {
        q.addEventListener('click', function() {
            // toggle class "active"
            var classes = q.className.split(' ');
            var idx = classes.indexOf('active');
            if (idx > -1) {
                classes.splice(idx, 1);
            } else {
                classes.push('active');
            }
            q.className = classes.join(' ');

            // toggle answer display
            var answer = q.nextElementSibling || q.nextSibling; // fallback for older browsers
            while (answer && answer.nodeType !== 1) {
                answer = answer.nextSibling;
            }

            if (answer) {
                if (answer.style.display === 'block') {
                    answer.style.display = 'none';
                } else {
                    answer.style.display = 'block';
                }
            }
        });
    });
});
</script>

<script>
// BH group toggle script with auto-open active group
document.addEventListener("DOMContentLoaded", function () {
    var groups = document.querySelectorAll(".bh-group");
    var currentPage = window.location.pathname.toLowerCase();

    var activeGroup = null;

    groups.forEach(function (group) {
        var list = group.querySelector(".bh-list");
        var icon = group.querySelector(".bh-icon");

        if (!list || !icon) return;

        // Check if any link in this list matches the current URL
        var links = list.querySelectorAll("a");
        links.forEach(function (link) {
            var href = link.getAttribute("href") || "";
            if (href && currentPage.includes(href.toLowerCase())) {
                activeGroup = group;
            }
        });
    });

    // Set initial open/close states
    groups.forEach(function (group) {
        var list = group.querySelector(".bh-list");
        var icon = group.querySelector(".bh-icon");

        if (group === activeGroup) {
            list.style.display = "block";   // OPEN
            icon.textContent = "−";
        } else {
            list.style.display = "none";    // CLOSED
            icon.textContent = "+";
        }

        // Allow manual toggle
        group.addEventListener("click", function () {
            var isOpen = list.style.display === "block";
            list.style.display = isOpen ? "none" : "block";
            icon.textContent = isOpen ? "+" : "−";
        });
    });
});
</script>



