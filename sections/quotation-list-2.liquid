{{ 'quotation-form-styles.aio.min.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* --- NEW Repeating Watermark Style --- */
  #file {
    position: relative;
    /* This ensures the pseudo-element is positioned relative to the file container */
  }

#file::before {
  content: '';
  position: absolute;
  inset: 0;

  background-image: url('https://cdn.shopify.com/s/files/1/0676/7991/2122/files/Channel_Logo_-_Transparent.png?v=1727063299');
  background-repeat: repeat;
  background-size: 250px;
  background-position: 0 0;

  opacity: 0.05;
  transform: rotate(-20deg) scale(1.2);
  transform-origin: center;
  pointer-events: none;
  z-index: 0;
}
  /* Custom styles for the quotation table header and footer */
  .quotation-thead-style {
    background-color: #e0e0e0;
    color: #333;
  }

  .quotation-thead-style th,
  .quotation-thead-style span {
    color: #333;
  }

  .quotation-tfoot-style {
    color: darkred;
  }

  .quotation-tfoot-style #colVat strong {
    color: darkred;
    font-size: 10px !important;
  }

  /* Further refinements for a cohesive design */
  .quotation-table-style {
    border-collapse: collapse;
    width: 100%;
    margin-top: 20px;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    overflow: hidden;
  }

  .quotation-table-style th,
  .quotation-table-style td {
    padding: 10px 12px;
    border: 1px solid #d9d9d9;
    text-align: left;
    font-size: 1.2rem;
  }

  .quotation-tbody-style tr:nth-child(even) {
    background-color: white;
  }

  .quotation-tbody-style tr:hover {
    background-color: white;
  }

  .quotation-table-style img {
    max-width: 80px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  /* New flexbox approach for header */
  .group {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    padding-top: 0;
  }

  .left-header-content {
    flex: 1;
    text-align: left;
    padding-right: 10px;
    padding-top: 0;
  }

  .right-header-content {
    flex-shrink: 0;
    width: 30%;
    text-align: right;
    padding-top: 0;
    padding-right: 10px;
  }

  .quotation-title {
    color: #8B0000;
    text-transform: uppercase;
    margin: 0;
    font-size: 22px;
    font-weight: bold;
    text-align: right;
  }

  .company-name {
    font-size: 14px;
    margin: 0 0 2px 0;
    font-weight: bold;
    text-align: left;
  }

  .company-details {
    font-size: 11px;
    margin: 0;
    line-height: 1.2;
    text-align: left;
    padding: 0;
  }

  .company-logo {
    height: 35px;
    width: 150px;
    max-width: 150px;
    margin: 0 0 5px 0;
    padding: 0;
    display: block;
  }

  /* TABLES for PDF generation */
  #quotation-products-table,
  #quotation-products-table2,
  #quotation-products-table3 {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    border: 1px solid white;
    overflow: hidden;
  }

  #quotation-products-table td,
  #quotation-products-table2 td,
  #quotation-products-table3 td,
  #quotation-products-table th,
  #quotation-products-table2 th,
  #quotation-products-table3 th {
    border: 1px solid #d9d9d9 !important;
  }

  .file-table {
    width: 98%;
    margin-left: 0.5%;
    margin-right: auto;
    border-collapse: collapse;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #b3b3b3;
    table-layout: fixed;
  }

  .file-table th,
  .file-table td {
    border: 1px solid white;
    padding: 2px 4px;
    text-align: left;
    word-wrap: break-word;
    font-size: 9px;
  }

  .file-table th:nth-child(1), .file-table td:nth-child(1) { width: 6%; }
  .file-table th:nth-child(2), .file-table td:nth-child(2) { width: 29%; }
  .file-table th:nth-child(3), .file-table td:nth-child(3) { width: 20%; }
  .file-table th:nth-child(4), .file-table td:nth-child(4) { width: 21%; }
  .file-table th:nth-child(5), .file-table td:nth-child(5) { width: 5%; }
  .file-table th:nth-child(6), .file-table td:nth-child(6) { width: 4%; }
  .file-table th:nth-child(7), .file-table td:nth-child(7) { width: 4%; }
  .file-table th:nth-child(8), .file-table td:nth-child(8) { width: 4%; }
  .file-table th:nth-child(9), .file-table td:nth-child(9) { width: 7%; }

  .file-table th {
    background-color: #e0e0e0;
    font-weight: bold;
  }

  .file-table thead tr:first-child th:first-child {
    border-top-left-radius: 8px;
  }
  .file-table thead tr:first-child th:last-child {
    border-top-right-radius: 8px;
  }

  .file-table tbody tr:last-child td:first-child {
    border-bottom-left-radius: 8px;
  }
  .file-table tbody tr:last-child td:last-child {
    border-bottom-right-radius: 8px;
  }

  .quotation-footer {
    margin: 0;
    padding: 8px 0;
    background-color: #fff !important;
    border: 1px solid white;
  }

  #quotation-products-table + #quotation-products-table2,
  #quotation-products-table2 + #quotation-products-table3 {
    border-width: 0.5px;
    margin-top: 0;
  }

  #totalRow {
    background-color: #e0e0e0 !important;
    border: none;
  }

  .file-table img {
    max-width: 50px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .quotation-footer p,
  .quotation-footer ul li {
    font-size: 10px !important;
    line-height: 1.1;
  }

  .quotation-footer p strong {
    font-size: 11px !important;
  }

  .signature-line-container {
    width: 400px;
    margin: 40px auto 5px 10%;
    text-align: left;
  }

  .signature-line-container p {
    border-top: 1px solid #000;
    padding-top: 5px;
    font-size: 8px !important;
    font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    display: block;
    text-align: center;
  }

  .signature-line-container strong {
    /* text-decoration-line: overline; */
  }

  .action-buttons-cell {
    text-align: center;
    vertical-align: middle;
  }
  .action-buttons-cell button {
    padding: 4px 8px;
    font-size: 0.75rem;
    border-radius: 0.25rem;
    border: 1px solid #ccc;
    cursor: pointer;
    background-color: #f0f0f0;
    transition: background-color 0.2s;
    margin: 2px;
    min-width: 50px;
  }
  .action-buttons-cell button:hover {
    background-color: #e0e0e0;
  }
  .action-buttons-cell .edit-btn2 {
    background-color: #2563eb;
    color: white;
    border-color: #2563eb;
  }
  .action-buttons-cell .edit-btn2:hover {
    background-color: #1d4ed8;
  }
  .action-buttons-cell .delete-btn2 {
    background-color: #dc2626;
    color: white;
    border-color: #dc2626;
  }
  .action-buttons-cell .delete-btn2:hover {
    background-color: #b91c1c;
  }

  .table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-responsive table {
  min-width: 900px; /* or adjust based on your columns */
}

{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.2/html2pdf.bundle.min.js" defer="defer"></script>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
