    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const customerId = {{ customer.id | json }};
        const quotationDetails = document.querySelector('tbody.quotation-tbody-style');

        function fetchQuotationProducts() {
          fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields?namespace=quotation_info`, {
            method: 'GET',
            headers: {
              'Content-Type': 'application/json'
            }
          })
          .then(res => {
            if (!res) {
              throw new Error('Failed to fetch metafields: Response is undefined');
            }
            if (!res.ok) {
              throw new Error(`Failed to fetch metafields: ${res.statusText} (${res.status})`);
            }
            return res.json();
          })
          .then(data => {
            const aggregatedProducts = {};
        
            data.metafields.forEach(meta => {
              try {
                const productData = JSON.parse(meta.value);
                const title = productData.title || productData.title;
            
                if (!aggregatedProducts[title]) {
                  aggregatedProducts[title] = {
                    id: meta.id,
                    title: title,
                    type: productData.type || "",
                    vendor: productData.vendor || "",
                    price: typeof productData.price === 'string' ? 
                           parseFloat(productData.price.replace(/₱/g, '').replace(/,/g, '')) : 
                           parseFloat(productData.price) || 0,
                    quantity: parseInt(productData.quantity, 10) || 0,
                    metafields: productData.metafields || "",
                    featured_image: productData.featured_image || "",
                    note: productData.note || ""
                  };
                } else {
                  aggregatedProducts[title].quantity += parseInt(productData.quantity, 10) || 0; 
                }
              } catch (error) {
                console.error('Error parsing product data:', error);
              }
            });
        
            Object.keys(aggregatedProducts).forEach(title => {
              const product = aggregatedProducts[title];
              // ========== UNIT DISPLAY LOGIC - Maps Metaobject Handles ==========
            let unitDisplay = product.metafields.trim().toLowerCase();

            // Map metaobject unit handles to display values
            const unitMap = {
              'pack': 'PACK',
              'each': 'EACH',
              'pair': 'PAIR',
              'meter': 'METER',
              'set': 'SET',
              'lot': 'LOT',
              'roll': 'ROLL',
              'piece-s': 'PIECE/S',
              'pieces': 'PIECE/S',     // Alternative variations
              'piece/s': 'PIECE/S',
              'pc': 'PIECE/S',
              'pcs': 'PIECE/S'
            };

            // Get the mapped value, or show N/A if not found
            unitDisplay = unitMap[unitDisplay] || (product.metafields.trim() === '' ? 'N/A' : product.metafields.trim().toUpperCase());
            // ==================================================================
              
              const newRow = document.createElement('tr');
              newRow.innerHTML = `
                <td><img src="${product.featured_image}" alt="${escapeHtml(title)}" /></td>
                <td>${escapeHtml(product.type)}</td>
                <td>${escapeHtml(product.title)}</td>
                <td>${escapeHtml(product.vendor)}</td>
                <td class="table-unitPrice">₱${product.price.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</td>
                <td class="table-qty">${product.quantity}</td>
                <td>${unitDisplay}</td>
                <td class="table-amountPrice">₱${(product.price * product.quantity).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</td>
                <td class="table-note">${escapeHtml(product.note)}</td>
                <td class="action-buttons-cell"><button class="edit-btn2" type="button" data-id="${product.id}">Edit</button></td>
                <td class="action-buttons-cell"><button class="delete-btn2" type="button" data-id="${product.id}">Delete</button></td>
              `;
              quotationDetails.appendChild(newRow);
              const deleteButton = newRow.querySelector('.delete-btn2');
              deleteButton.addEventListener('click', () => deleteRowC(newRow, product.id));
              const editButton = newRow.querySelector('.edit-btn2');
              editButton.addEventListener('click', () => editQtyC(newRow, product.id, product));
            });
        
            updateTotals();
          })
          .catch(error => console.error('Error fetching quotation products:', error));
        }

        function escapeHtml(unsafe) {
          return unsafe
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
        }

        function formatCurrency(amount) {
          return `₱${amount.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}`;
        }

        function updateTotals() {
          const rows = document.querySelectorAll('tbody.quotation-tbody-style tr');
          let sumValC = 0;

          rows.forEach(row => {
            const productPriceC = row.querySelector('.table-unitPrice').textContent; 
            const productQtyC = row.querySelector('.table-qty').textContent; 
        
            const parsedPriceC = parseFloat(productPriceC.replace(/₱/g, '').replace(/,/g, ''));
            const parsedQtyC = parseInt(productQtyC, 10);
        
            const productAmountPriceC = parsedPriceC * parsedQtyC;
            sumValC += productAmountPriceC;
        
            const amountPriceCell = row.querySelector('.table-amountPrice'); 
            if (amountPriceCell) {
              amountPriceCell.textContent = formatCurrency(productAmountPriceC);
            }
          });
      
          document.querySelector('#totalAmountPrice').textContent = formatCurrency(sumValC);
        }
        
        function deleteRowC(row, metafieldId) {
          row.remove();
          fetch(`https://quotation-api.channel.com.ph/quotation/metafields/${metafieldId}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            }
          })
          .then(res => {
            if (res.ok) {
              console.log('Metafield deleted successfully.');
              updateTotals(); 
            } else {
              console.error('Error deleting metafield:', res.statusText);
            }
          })
          .catch(error => console.error('Error:', error));
        }
      
        function editQtyC(row, metafieldId, product) {
          const editButtonC = row.querySelector('.edit-btn2');
          const qtyCellC = row.querySelector('.table-qty');
          const noteCellC = row.querySelector('.table-note');
          const currentQtyC = qtyCellC.textContent;
          const currentNoteC = noteCellC.textContent;
        
          if (editButtonC.textContent === 'Edit') {
            qtyCellC.innerHTML = `<input type="number" value="${currentQtyC}" class="edit-qty" min="1" />`;
            noteCellC.innerHTML = `<input type="text" value="${currentNoteC}" class="edit-note" />`;
            editButtonC.textContent = 'Save';
          } else {
            const inputFieldC = qtyCellC.querySelector('.edit-qty');
            const newQtyC = inputFieldC.value;
            const inputFieldNote = noteCellC.querySelector('.edit-note');
            const newNote = inputFieldNote.value;
            if (isNaN(newQtyC) || newQtyC <= 0) {
              console.error("Please enter a valid quantity.");
              return;
            }

            noteCellC.textContent = newNote;
            qtyCellC.textContent = newQtyC;
            editButtonC.textContent = 'Edit';
            updateTotals(); 
        
            const updatedProduct = {
              ...product, 
              quantity: newQtyC, 
              note: newNote
            };
        
            fetch(`https://quotation-api.channel.com.ph/quotation/metafields/${metafieldId}`, {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                metafield: {
                  id: metafieldId,
                  value: JSON.stringify(updatedProduct), 
                  type: 'json' 
                }
              })
            })
            .then(res => {
              if (res.ok) {
                console.log('Metafield updated successfully.');
              } else {
                console.error('Error updating metafield:', res.statusText);
              }
            })
            .catch(error => console.error('Error:', error));
          }
        }

        fetchQuotationProducts();
      });
    </script>
    <script>
      const saveBtn = document.getElementById('quotation-download-btn');
      saveBtn.style.border = "1px solid transparent";
      saveBtn.style.color = "rgba(var(--color-foreground), 0.50)";
      saveBtn.style.backgroundColor = "rgba(var(--color-foreground), 0.40)";
      saveBtn.style.cursor = "default";
      function checkInputs() {
        const tableBody = document.querySelector('tbody');
        const fName = document.getElementById('inputFName').value.trim();
        const cName = document.getElementById('inputCName').value.trim();
        const phone = document.getElementById('inputPhone').value.trim();
        const email = document.getElementById('inputEmail').value.trim();
        const project = document.getElementById('inputProject').value.trim();
        const blankElement = document.getElementById('blank');
        const isBlankRemoved = blankElement === null;

        const tableRows = document.querySelectorAll('tbody tr'); 
        const trCount = tableRows.length;
        
        if (fName !== "" && cName !== "" && phone !== "" && email !== "" && project !== "" && isBlankRemoved && trCount >= 0) {
          saveBtn.style.border = "1px solid rgb(var(--color-button))";
          saveBtn.style.color = "rgb(var(--color-button))";
          saveBtn.style.backgroundColor = "transparent";
          saveBtn.style.cursor = "pointer"; 
          
          saveBtn.addEventListener('mouseenter', function() {
            saveBtn.style.backgroundColor = "rgb(var(--color-button))"; 
            saveBtn.style.color = "rgb(var(--color-button-text))";
          });
          saveBtn.addEventListener('mouseleave', function() {
            saveBtn.style.backgroundColor = "transparent"; 
            saveBtn.style.color = "rgb(var(--color-button))";
          });
        } else {
          saveBtn.style.border = "1px solid transparent";
          saveBtn.style.color = "rgba(var(--color-foreground), 0.50)";
          saveBtn.style.backgroundColor = "rgba(var(--color-foreground), 0.40)";
          saveBtn.style.cursor = "default"; 
        }
      }
      checkInputs();

      document.getElementById('inputFName').addEventListener('input', checkInputs);
      document.getElementById('inputCName').addEventListener('input', checkInputs);
      document.getElementById('inputPhone').addEventListener('input', checkInputs);
      document.getElementById('inputEmail').addEventListener('input', checkInputs);
      document.getElementById('inputProject').addEventListener('input', checkInputs);
    
      document.getElementById('form').addEventListener('submit', function(event) {
        event.preventDefault(); 
        const customerId = {{ customer.id | json }};
      
        const fName = document.getElementById('inputFName').value;
        const company = document.getElementById('inputCName').value;
        const phone = document.getElementById('inputPhone').value;
        const email = document.getElementById('inputEmail').value;
        const project = document.getElementById('inputProject').value;
        const preparedBy = 'channel.com.ph';
        const table = document.getElementById('quotation-table');
      
        const updatedRows = [];
        const rows = table.getElementsByTagName('tr');
        const downloadBtn = document.getElementById('quotation-download-btn2');
        downloadBtn.style.display = "block";
      
        for (let i = 0; i < rows.length; i++) {
          const row = rows[i];
          const clonedRow = row.cloneNode(true);

          const headerCells = clonedRow.querySelectorAll('.action-buttons-header');
          headerCells.forEach(cell => cell.remove());

          const actionCells = clonedRow.querySelectorAll('.action-buttons-cell');
          actionCells.forEach(cell => cell.remove());
          
          updatedRows.push(clonedRow.outerHTML);
        }

        const tableHtml = `<table class="file-table" style="border-collapse: collapse;"><tbody>${updatedRows.join('')}</tbody></table>`;
        document.getElementById('quotation-products-table').innerHTML = tableHtml;
        document.getElementById('quotation-products-table2').innerHTML = '';
        document.getElementById('quotation-products-table3').innerHTML = '';
        
        const today = new Date().toLocaleString("en-US", { timeZone: "Asia/Manila" });
        const date = new Date(today);
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        const formattedDate = date.toLocaleDateString(undefined, options);
        
        const year = date.getFullYear();
        const shYear = year.toString().slice(-2);
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String.fromCharCode(date.getHours() + 65);
        const mins = String(date.getMinutes()).padStart(2, '0');
        const secs = String(date.getSeconds()).padStart(2, '0');
        const jobNumber = month + day + shYear + "-" + hours + mins + secs;
        
        document.getElementById('quotation-customer-info').innerHTML = `
          <div class="start-margin" style="font-size: 12px; line-height: 1.5;"><div class="start-margin-col"><strong>Attention:</strong> ${fName} <br>
          <strong>Company:</strong> ${company} <br>
          <strong>Contact Number:</strong> ${phone} <br>
          <strong>Email:</strong><span id="emailCustomer"> ${email} </span><br>
          <strong>Project Title:</strong> ${project} <br></div>
          <div class="start-margin-col"><strong>Date:</strong> ${formattedDate} <br>
          <strong>Prepared by:</strong> ${preparedBy} <br>
          <strong>Job Number:</strong> ${jobNumber} <br></div></div>
        `;
        
        this.reset();
        alert("Your data entered in the forms have been saved.");
      });
  
      function sendMail() {
    emailjs.init("uzfiB2iNH6YIYoPst");

    const messageContent = document.getElementById("quotation-customer-info");
    const messageContentHeader = "<h3 style='display: block;'> Customer Created a Quotation on their own </h3>";

    // Clone tables so the page itself is not modified
    const table1 = document.getElementById("quotation-products-table").cloneNode(true);
    const table2 = document.getElementById("quotation-products-table2").cloneNode(true);
    const table3 = document.getElementById("quotation-products-table3").cloneNode(true);

    // Apply styling from first code
    [table1, table2, table3].forEach(table => {
        const rows = table.querySelectorAll("tr");
        const ths = table.querySelectorAll("th");
        const tds = table.querySelectorAll("td");
        const imgs = table.querySelectorAll("img");
        const totalRows = table.querySelectorAll("#totalRow");

        for (let row of rows) {
            const cells = row.querySelectorAll("th, td");

            if (cells.length > 8) {
                cells[0].remove();
                cells[1].style.width = "15%";
                cells[2].style.width = "15%";
                cells[3].style.width = "10%";
                cells[4].style.width = "10%";
                cells[5].style.width = "5%";
                cells[6].style.width = "5%";
                cells[7].style.width = "15%";
                cells[8].style.width = "15%";
            }
        }

        for (let totalRow of totalRows) {
            totalRow.style.textAlign = "right";

            const totalRowCells = totalRow.querySelectorAll("td");

            if (totalRowCells.length === 3) {
                totalRowCells[0].colSpan = 5;
                totalRowCells[1].colSpan = 2;
                totalRowCells[2].colSpan = 1;
                totalRowCells[2].style.textAlign = "center";
            }
        }

        for (let th of ths) {
            th.style.border = "1px solid black";
            th.style.padding = "10px";
        }

        for (let td of tds) {
            td.style.border = "1px solid black";
            td.style.padding = "10px";

            if (td.cellIndex === 6) {
                td.style.textAlign = "right";
            }
        }

        for (let img of imgs) {
            img.remove();
        }
    });

    var params = {
        my_html:
            messageContentHeader +
            messageContent.innerHTML +
            table1.outerHTML +
            table2.outerHTML +
            table3.outerHTML,
        isHtml: true,
    };

    const serviceID = "service_eg4wtpf";
    const templateID = "template_nrm5mbs";

    emailjs.send(serviceID, templateID, params)
        .then(res => {
            console.log("Sending mail...");
            console.log(res);
            console.log("Your email sent successfully!");
        })
        .catch(err => {
            console.error("Error sending email:", err);
        });
}

