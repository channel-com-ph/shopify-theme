      </table>
        <div class="customer-details" style="margin-top: 12px;">
          <label class="label-form">Full Name</label>
          <div class="two-col">
            <span><input type="text" placeholder="First Name" name="fName" class="text-field-normal" id="inputFName" required ></span>
            <span><input type="text" placeholder="Last Name" name="lName" class="text-field-normal" id="inputLName" required ></span>
          </div>
          <label class="label-form">Company Name</label>
          <span><input type="text" placeholder="Company Name" name="compName" class="text-field-wide" id="inputCName" required ></span>
          <div class="two-col">
            <div class="one-col">
              <label class="label-form">Contact Number</label>
              <span><input type="tel" placeholder="Contact Number" name="inputTel" class="text-field-wide" id="inputPhone" required ></span>
            </div>
            <div class="one-col">
              <label class="label-form">Email Address</label>
              <span><input type="email" placeholder="Email Address" name="emailAdd" class="text-field-wide" id="inputEmail" required ></span>
            </div>
          </div>
          <label class="label-form">Project Title</label>
          <span><input type="text" placeholder="Project Title (Enter 'None' if you don't have Title)" name="projName" class="text-field-wide" id="inputProject" required ></span>
        </div>
          <span><input type="submit" value="SAVE" id="quotation-download-btn" class="quotation-btn"></span>
    </form>
  </div>
  <div class="quotation-document" id="quotation-file">
    <span><input type="button" value="DOWNLOAD" id="quotation-download-btn2" class="quotation-btn" style="display: none;"></span>
    <div class="container" id="file">
      <div class="quotation-header">
        <span><img src="https://cdn.shopify.com/s/files/1/0676/7991/2122/files/Channel_Logo_-_Transparent.png?v=1727063299" crossorigin="anonymous" 
    referrerpolicy="no-referrer"  height="40" width="auto"></span>
        <span class="small-heading"><p style="font-size: 14px;">CHANNEL INTERNATIONAL ENTERPRISES</p></span>
        <span class="small-heading"><p>#43 Don A. Roces Ave.Quezon City Metro Manila Philippines</p></span>
        <span class="small-heading"><p>Tel.: (+632) 7738 2844; Smart +63 998 983 4535; Globe +63 915 339 7985</p></span>
      </div>
      <div id="quotation-customer-info" class="quotation-info">
        
      </div>
      <div id="quotation-products-table" style=" margin: 0;">
        
      </div>
      <div class="quotation-footer">
          <span><p><strong>TERMS & CONDITIONS:</strong></p></span>
          <span>
            <ol type="A" style="color: black; border-bottom: 1px solid #BC2305;">
              <li class="col-con">
                <span class="col-sh">
                  <strong>A. Payment Terms:</strong>
                </span>
