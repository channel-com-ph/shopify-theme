              <th><span>IMAGE</span></th>
              <th><span>ITEM</span></th>
              <th><span>MODEL</span></th>
              <th><span>BRAND</span></th>
              <th><span>UNIT PRICE</span></th>
              <th><span>QTY.</span></th>
              <th><span>UNIT</span></th>
              <th><span>AMOUNT</span></th>
              <th><span>NOTE</span></th>
              <th class="btn-col" id="edit-col"></th>
              <th class="btn-col" id="delete-col"></th>
            </tr>
          </thead>
          <tbody class="quotation-tbody-style">
            <!-- Rows will be inserted here -->
          </tbody>
          <tfoot class="quotation-tfoot-style">
            <tr id="totalRow">
              <td class="total-label" colspan="6">TOTAL AMOUNT</td>
              <td id="totalAmountPrice" class="total-amount" colspan="2">To be Calculated</td>
              <td colspan="1" id="colVat"><strong>VAT INC.</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>
        <div
