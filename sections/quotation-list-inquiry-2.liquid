<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div id="main-form">
      <span><h1>Product Price Inquiry List</h1></span>
      <p style="color: #FF1F31;">To continue, kindly select or add the product to your inquiry list.</p>
      <form id="form">
        <div class="table-responsive">  
        <table id="quotation-table" class="quotation-table-style">
          <thead class="quotation-thead-style">
