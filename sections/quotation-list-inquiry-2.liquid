{{ 'quotation-form-styles.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

      /* Custom styles for the quotation table header and footer */
      .quotation-thead-style {
        background-color: #e0e0e0; 
        color: #333; 
      }

      .quotation-thead-style th,
      .quotation-thead-style span {
        color: #333; 
      }

      .quotation-tfoot-style {
        color: darkred; 
      }

      .quotation-tfoot-style #colVat strong {
        color: darkred; 
        font-size: 10px !important; /
      }

      /* Further refinements for a cohesive design */
      .quotation-table-style {
        border-collapse: collapse; 
        width: 100%;
        margin-top: 20px;
        border: 1px solid #ddd; 
        border-radius: 8px; 
        overflow: hidden; 
      }

      .quotation-table-style th,
      .quotation-table-style td {
        padding: 10px 12px; 
        border: 1px solid #ddd; 
        text-align: left;
        font-size: 1.2rem; 
      }

      .quotation-tbody-style tr:nth-child(even) {
        background-color: #f2f2f2; 
      }

      .quotation-tbody-style tr:hover {
        background-color: #f0f0f0; 
      }

      .quotation-table-style img {
        max-width: 80px; 
        height: auto;
        display: block; 
        margin: 0 auto;
      }

        /* New flexbox approach for header */
         .group {
           display: flex;
           justify-content: space-between; 
           align-items: flex-start; 
           width: 100%; 
           padding-top: 0; 
         }

         .left-header-content {
           flex: 1; 
           text-align: left; 
           padding-right: 10px; 
           padding-top: 0; 
         }

         .right-header-content {
           flex-shrink: 0; 
           width: 30%; 
           text-align: right; 
           padding-top: 0;
           padding-right: 10px; 
         }

         .quotation-title {
           color: #8B0000;
           text-transform: uppercase;
           margin: 0; 
           font-size: 22px; 
           font-weight: bold;
           text-align: right; 
         }

         .company-name {
           font-size: 14px; 
           margin: 0 0 2px 0; 
           font-weight: bold;
           text-align: left; 
         }

         .company-details {
           font-size: 11px; 
           margin: 0; 
           line-height: 1.2; 
           text-align: left;
           padding: 0; 
         }

         .company-logo {
           height: 35px; 
           width: 150px;
           max-width: 150px; 
           margin: 0 0 5px 0; 
           padding: 0;
           display: block;
         }

            /* TABLE for PDF generation */
          #quotation-products-table,
          #quotation-products-table2,
          #quotation-products-table3{
          width:100%;
          border-width: 1px; 
          border-collapse:collapse;
          margin:0;
          padding:0;
          border-bottom: none; 
          border-radius: 8px; 
          overflow: hidden; 
          }

          /* Styling for tables generated for PDF */
          .file-table {
            width: 98%; 
            margin-left: 0.5%;
            margin-right: auto;
            border-collapse: collapse;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #eeeeee; 
            table-layout: fixed; 
          }

          .file-table th,
          .file-table td {
            border: 1px solid #eeeeee; 
            padding: 2px 4px;
            text-align: left;
            word-wrap: break-word; 
            font-size: 9px; 
          }

          /* Specific column widths for PDF table to prevent cutting */
          .file-table th:nth-child(1), .file-table td:nth-child(1) { width: 8%; } /* IMAGE */
          .file-table th:nth-child(2), .file-table td:nth-child(2) { width: 30%; } /* ITEM  */
          .file-table th:nth-child(3), .file-table td:nth-child(3) { width: 15%; } /* MODEL */
          .file-table th:nth-child(4), .file-table td:nth-child(4) { width: 9%; } /* BRAND */
          .file-table th:nth-child(5), .file-table td:nth-child(5) { width: 6%; } /* UNIT PRICE */
          .file-table th:nth-child(6), .file-table td:nth-child(6) { width: 4%; } /* QTY. */
          .file-table th:nth-child(7), .file-table td:nth-child(7) { width: 4%; } /* UNIT */
          .file-table th:nth-child(8), .file-table td:nth-child(8) { width: 4%; } /* AMOUNT */
          .file-table th:nth-child(9), .file-table td:nth-child(9) { width: 20%; } /* NOTE  */


          .file-table th {
            background-color: #e0e0e0;
            font-weight: bold;
          }

          /* Ensure top-left and top-right corners of the header are rounded */
          .file-table thead tr:first-child th:first-child {
            border-top-left-radius: 8px;
          }
          .file-table thead tr:first-child th:last-child {
            border-top-right-radius: 8px;
          }

          /* Ensure bottom-left and bottom-right corners of the last row are rounded */
          .file-table tbody tr:last-child td:first-child {
            border-bottom-left-radius: 8px;
          }
          .file-table tbody tr:last-child td:last-child {
            border-bottom-right-radius: 8px;
          }

          .quotation-footer{
          margin:0;
          padding:8px 0;
          background-color:#fff!important;
          /* Removed border-top:0.5px solid #fafafa; */
          }
          #quotation-products-table+#quotation-products-table2,
          #quotation-products-table2+#quotation-products-table3{
          border-width: 0.5px; /* Reduced thickness */
          margin-top:0;
          }

        #totalRow{
          background-color:#e0e0e0 !important; /* Light Grey for total row */
          border: none;
          }

          /* New style for images within the PDF table */
          .file-table img {
            max-width: 50px; 
            height: auto;
            display: block;
            margin: 0 auto;
          }

          /* Smaller font for footer sections */
          .quotation-footer p,
          .quotation-footer ul li {
            font-size: 10px !important; 
            line-height: 1.1; 
          }

          .quotation-footer p strong {
            font-size: 11px !important; /* Keep strong tags slightly larger */
          }

          /* Signature line and text styling */
          .signature-line-container {
            width: 400px; 
            margin: 40px auto 5px 10%; 
            text-align: left; 
          }

          .signature-line-container p {
            border-top: 1px solid #000; 
            padding-top: 5px;
            font-size: 8px !important; 
            font-style: italic;
            white-space: nowrap; 
            overflow: hidden;
            text-overflow: ellipsis; 
            margin: 0; 
            display: block; 
            text-align: center; 
          }

          /* Removed text-decoration-line: overline from strong to prevent double line */
          .signature-line-container strong {
            /* text-decoration-line: overline; */
          }

          /* Styles for buttons */
          .action-buttons-cell {
            text-align: center; 
            vertical-align: middle; 
          }
          .action-buttons-cell button {
            padding: 4px 8px;
            font-size: 0.75rem;
            border-radius: 0.25rem;
            border: 1px solid #ccc;
            cursor: pointer;
            background-color: #f0f0f0;
            transition: background-color 0.2s;
            margin: 2px; 
            min-width: 50px; 
          }
          .action-buttons-cell button:hover {
            background-color: #e0e0e0;
          }
          .action-buttons-cell .edit-btn2 {
            background-color: #2563eb; /* Blue */
            color: white;
            border-color: #2563eb;
          }
          .action-buttons-cell .edit-btn2:hover {
            background-color: #1d4ed8;
          }
          .action-buttons-cell .delete-btn2 {
            background-color: #dc2626; /* Red */
            color: white;
            border-color: #dc2626;
          }
          .action-buttons-cell .delete-btn2:hover {
            background-color: #b91c1c;
          }

          .table-responsive {
          width: 100%;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }

        .table-responsive table {
          min-width: 900px; /* or adjust based on your columns */
        }

{%- endstyle -%}

