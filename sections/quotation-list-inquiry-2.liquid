function resetList() {
  const customerId = {{ customer.id | json }};
  
  fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields?namespace=inquiry_info`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(res => {
    if (!res.ok) {
      throw new Error(`Error fetching metafields: ${res.statusText}`);
    }
    return res.json();
  })
  .then(data => {
    const deletePromises = data.metafields.map(meta => {
      return fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields/${meta.id}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(deleteRes => {
        if (!deleteRes.ok) {
          throw new Error(`Error deleting metafield ${meta.id}: ${deleteRes.statusText}`);
        }
      });
    });

    return Promise.all(deletePromises);
  })
  .then(() => {
    console.log('All quotation metafields deleted');
  })
  .catch(error => console.error('Error:', error));
}
      window.onload = function () {
        document.getElementById("quotation-download-btn2").addEventListener("click", () => {
          const file = document.getElementById("file");
          
          updateInquiryCount();
          resetList();
          
          if (file) {
            setTimeout(() => {
              sendMail();
              sendMailClient();
            }, 1000);
            setTimeout(() => {
              location.reload(); 
            }, 2000);
            
          } else {
            console.error("Element with ID 'file' not found.");
          }
          
        });
      };
