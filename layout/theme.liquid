      {%- if customer.metafields.custom_info.marketing == 't' -%}
        <script>
    	  const customerIdMarketing = {{ customer.id | json }};   
          const updatedCustomerDataMarketing = {
            customer: {
              id: customerIdMarketing,
              email_marketing_consent: {
                consent_updated_at: null,
                opt_in_level: "single_opt_in",
                state: "subscribed"
              },
              tags: "newsletter"
            }
          };
          
          fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerIdMarketing}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(updatedCustomerDataMarketing),
          })
            .then(response => response.json())
            .then(data => {
            })
            .catch(error => {
              console.error('Error:', error);
            });
        </script>
