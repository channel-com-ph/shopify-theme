<script>

document.addEventListener("DOMContentLoaded", function () {

  /* Save redirect source */
  const urlParams = new URLSearchParams(window.location.search);

  if (urlParams.has("from_quote")) {
    sessionStorage.setItem(
      "afterLoginRedirect",
      urlParams.get("from_quote")
    );
  }

  const redirect = sessionStorage.getItem("afterLoginRedirect");

  /* Return to previous page after login */
  if (redirect) {
    sessionStorage.removeItem("afterLoginRedirect");
    window.location.href = redirect;
  }

});
</script>

{% endif %}

   <script>
      const customerId = {{ customer.id | json }};
      const notif = document.getElementById('quoteNotif');
      const notifI = document.getElementById('inquiryNotif');
      function dataQty() {
        const qtyInput = document.querySelectorAll(".quantity__input")[0];
        return qtyInput ? parseInt(qtyInput.value) : 0;
      }


document.addEventListener('click', function(e) {
  const button = e.target.closest(
    '#addToQuotationButton, .card-add-to-quote'
  );

  if (!button) return;

  // Skip inquiry buttons — they use data-item, handled separately
  if (button.classList.contains('addToInquireButton')) return;

  const rawData = button.getAttribute('data-product');
  if (!rawData) return;

  const productData = JSON.parse(rawData);

  // Try to get quantity (product page OR fallback to 1 for cards)
  let qtyInput = document.querySelector(".quantity__input");
  let qty = qtyInput ? parseInt(qtyInput.value) : 1;

  if (!qty || isNaN(qty) || qty <= 0) {
    qty = 1; // fallback for cards
  }

  fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields?namespace=quotation_info`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(res => res.json())
  .then(data => {
    const existingMeta = data.metafields.find(meta => meta.key === productData.handle);

    if (existingMeta) {
      const existingData = JSON.parse(existingMeta.value);
      existingData.quantity = (parseInt(existingData.quantity, 10) || 0) + qty;

      return fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields/${existingMeta.id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          metafield: {
            id: existingMeta.id,
            value: JSON.stringify(existingData)
          }
        })
      });
    } else {
      productData.quantity = qty;

      return fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          metafield: {
            namespace: 'quotation_info',
            key: productData.handle,
            value: JSON.stringify(productData),
            type: 'json'
          }
        })
      });
    }
  })
  .then(() => {
    updateQuotationCount();
    if (typeof notif !== "undefined" && notif) {
      notif.style.opacity = '1';
      setTimeout(() => notif.style.opacity = '0', 2500);
    }
  })
  .catch(error => console.error('Error:', error));
});

document.addEventListener('click', function(e) {
  const button = e.target.closest('.addToInquireButton');

  if (!button) return;

  const rawItem = button.getAttribute('data-item');
  if (!rawItem) return;

  const productData = JSON.parse(rawItem);

  // On card pages there's no quantity input, so default to 1
  let qtyI = dataQty();
  if (!qtyI || isNaN(qtyI) || qtyI <= 0) qtyI = 1;

  fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields?namespace=inquiry_info`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(res => res.json())
  .then(data => {
    const existingMeta = data.metafields.find(meta => meta.key === productData.handle);

    if (existingMeta) {
      const existingData = JSON.parse(existingMeta.value);
      existingData.quantity = (parseInt(existingData.quantity, 10) || 0) + qtyI;

      return fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields/${existingMeta.id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          metafield: {
            id: existingMeta.id,
            value: JSON.stringify(existingData)
          }
        })
      });
    } else {
      productData.quantity = qtyI;

      return fetch(`https://quotation-api.channel.com.ph/quotation/customer/${customerId}/metafields`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          metafield: {
            namespace: 'inquiry_info',
            key: productData.handle,
            value: JSON.stringify(productData),
            type: 'json'
          }
        })
      });
    }
  })
  .then(() => {
    updateInquiryCount();

    if (notifI) {
      notifI.style.opacity = '1';
      notifI.style.transition = 'opacity 0.5s ease-in';

      setTimeout(() => {
        notifI.style.opacity = '0';
        notifI.style.transition = 'opacity 0.5s ease-out';
      }, 2500);
    }
  })
  .catch(error => console.error('Error:', error));
});

