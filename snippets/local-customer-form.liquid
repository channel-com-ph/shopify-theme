<style>
  /* === BASE DESKTOP STYLES === */
  :root {
    --primary-color: #007bff;
    --primary-hover: #0056b3;
    --border-color: #cbd5e0;
    --bg-light: #f8fafc;
    --text-dark: #222;
    --text-medium: #555;
    --text-light: #777;
  }

  body, input, select, button {
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
    color: var(--text-dark);
  }

  .setRow {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 1.5rem;
  }

  .setCol {
    flex: 1;
    min-width: 280px;
  }

  label {
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--text-dark);
    display: block;
    margin-bottom: 6px;
  }

  .form-input-container {
    position: relative;
    margin-top: 0.3rem;
  }

  .form-input-box,
  .password-field-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background-color: var(--bg-light);
    height: 3.2rem;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .form-input-box input,
  .password-field-wrapper input {
    flex-grow: 1;
    border: none;
    outline: none;
    background-color: transparent;
    padding: 0 1.2rem;
    font-size: 1.6rem;
    height: 100%;
  }

  .form-input-box input:focus,
  .password-field-wrapper input:focus,
  select:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 1px var(--primary-color);
  }

  .password-toggle {
    position: absolute;
    right: 12px;
    cursor: pointer;
    padding: 0 5px;
  }

  .password-toggle img {
    width: 20px;
    height: 20px;
    vertical-align: middle;
  }

  .dropdown-wrapper {
    position: relative;
    width: 100%;
  }

  .dropdown-wrapper select {
    appearance: none;
    width: 100%;
    background-color: var(--bg-light);
    cursor: pointer;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    height: 3.2rem;
    font-size: 1.6rem;
    padding: 0 1.2rem;
    box-sizing: border-box;
  }

  .dropdown-wrapper .svg-wrapper {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  button[type="submit"],
  button[type="button"] {
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 12px 20px;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  button[type="submit"]:hover,
  button[type="button"]:hover {
    background-color: var(--primary-hover);
  }

  button[disabled] {
    background-color: #cccccc;
    cursor: not-allowed;
  }

  /* === MODAL === */
  .custom-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }

  .custom-modal-content {
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    text-align: center;
    max-width: 400px;
    width: 90%;
    position: relative;
  }

  .custom-modal-content h3 {
    margin-top: 0;
    font-size: 1.8rem;
    color: var(--text-dark);
    margin-bottom: 15px;
  }

  .custom-modal-content p {
    font-size: 1.5rem;
    color: var(--text-medium);
    margin-bottom: 25px;
  }

  .custom-modal-close-btn {
    background-color: var(--primary-color);
    color: white;
    border: none;
    padding: 10px 25px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1.4rem;
    transition: background-color 0.3s ease;
  }

  .custom-modal-close-btn:hover {
    background-color: var(--primary-hover);
  }

  .required-asterisk {
    color: red;
    margin-right: 4px;
    font-weight: bold;
  }

  .password-match-feedback {
    margin-top: 8px;
    font-size: 1.3rem;
    transition: all 0.3s ease;
    text-align: right;
  }

  .password-match {
    color: #27ae60;
  }

  .password-mismatch {
    color: #e74c3c;
  }

  /* === MOBILE OPTIMIZATION === */
  @media (max-width: 749px) {
    label {
      font-size: 1.4rem;
      margin-bottom: 4px;
    }

    .setRow {
      flex-direction: column;
      gap: 1rem;
    }

    .setCol {
      width: 100%;
      min-width: unset;
    }

    .form-input-box,
    .password-field-wrapper,
    .dropdown-wrapper select {
      height: 2.8rem;
      font-size: 1.4rem;
      border-radius: 6px;
    }

    .form-input-box input,
    .password-field-wrapper input {
      font-size: 1.4rem;
      padding: 0 1rem;
    }

    .password-toggle img {
      width: 18px;
      height: 18px;
    }

    button[type="submit"],
    button[type="button"] {
      width: 100%;
      font-size: 1.4rem;
      padding: 10px;
      margin-top: 0.7rem;
    }

    .custom-modal-content {
      width: 90%;
      padding: 20px;
    }

    .custom-modal-content h3 {
      font-size: 1.5rem;
    }

    .custom-modal-content p {
      font-size: 1.2rem;
    }

    .custom-modal-close-btn {
      font-size: 1.2rem;
      padding: 8px 18px;
    }

    .password-match-feedback {
      text-align: left;
      font-size: 1.1rem;
      margin-top: 5px;
    }
  }
</style>


