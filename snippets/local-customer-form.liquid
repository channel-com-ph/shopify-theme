    });
  });

  // Password Strength Checker
  function checkPasswordStrength(password) {
    const strengthMeter = document.getElementById('strength-meter');
    const requirements = {
      length: document.getElementById('length-req'),
      upper: document.getElementById('upper-req'),
      lower: document.getElementById('lower-req'),
      number: document.getElementById('number-req'),
      special: document.getElementById('special-req')
    };

    let allRequirementsMet = true; // Flag to track if all requirements are met

    // Helper to update requirement list item color and track overall validity
    const updateRequirement = (reqElement, condition) => {
        if (reqElement) { // Check if element exists before manipulating
            if (condition) {
                reqElement.style.color = '#27ae60'; // Green
                // Ensure "✓ " is only added if not already present
                if (!reqElement.textContent.startsWith('✓ ')) {
                    reqElement.textContent = '✓ ' + reqElement.textContent.replace(/^[✓✗]\s/, '');
                }
            } else {
                reqElement.style.color = '#e74c3c'; // Red
                // Ensure "✗ " is only added if not already present
                if (!reqElement.textContent.startsWith('✗ ')) {
                    reqElement.textContent = '✗ ' + reqElement.textContent.replace(/^[✓✗]\s/, '');
                }
                allRequirementsMet = false; // Mark overall as false if any specific fails
            }
        }
    };

    // Reset all requirements to red initially for validation check
    Object.values(requirements).forEach(req => {
      if (req) req.style.color = '#e74c3c';
    });
    allRequirementsMet = true; // Reset for each check to ensure accurate validation for the current password


    // Check individual requirements
    const hasLength = password.length >= 8;
    updateRequirement(requirements.length, hasLength);

    const hasUpperCase = /[A-Z]/.test(password);
    updateRequirement(requirements.upper, hasUpperCase);

    const hasLowerCase = /[a-z]/.test(password);
    updateRequirement(requirements.lower, hasLowerCase);

    const hasNumber = /[0-9]/.test(password);
    updateRequirement(requirements.number, hasNumber);

    const hasSpecialChar = /[^A-Za-z0-9]/.test(password);
    updateRequirement(requirements.special, hasSpecialChar);

    // Determine strength level for UI display (can be different from strict validation)
    let strengthLevel = '';
    let color = '';

    // Count met requirements for visual strength meter
    let metCount = 0;
    // For visual strength, consider 8+ for length
    if (password.length >= 8) metCount++;
    if (hasUpperCase) metCount++;
    if (hasLowerCase) metCount++;
    if (hasNumber) metCount++;
    if (hasSpecialChar) metCount++;
    
    // If the password is less than 8 characters OR very few other requirements met, it's weak.
    if (password.length === 0) {
      strengthLevel = 'None';
      color = '#777';
    } else if (password.length < 8 || metCount <= 2) { // Less than 8 characters or very few requirements met
      strengthLevel = 'Weak';
      color = '#e74c3c';
    } else if (metCount <= 4) {
      strengthLevel = 'Medium';
      color = '#f39c12';
    } else { // All 5 requirements met and at least 8 characters
      strengthLevel = 'Strong';
      color = '#27ae60';
    }

    if (strengthMeter) {
        strengthMeter.textContent = strengthLevel;
        strengthMeter.style.color = color;
    }

    // Return true only if ALL requirements are met based on the strict checks
    return allRequirementsMet;
  }

        // Function to check if passwords match
        function checkPasswordsMatch() {
        const passwordInput = document.getElementById('RegisterForm-password');
        const confirmPasswordInput = document.getElementById('RegisterForm-confirm-password');
        const feedbackElement = document.getElementById('password-match-feedback');
        
        if (!passwordInput || !confirmPasswordInput || !feedbackElement) {
          console.error('Password or Confirm Password input or feedback element not found.');
          return;
        }
      
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        if (confirmPassword.length === 0) {
          feedbackElement.textContent = '';
          feedbackElement.style.color = '';
          return;
        }
        
        if (password === confirmPassword) {
          feedbackElement.textContent = '✓ Passwords match';
          feedbackElement.style.color = '#28a745'; // Green
        } else {
          feedbackElement.textContent = '✗ Passwords do not match';
          feedbackElement.style.color = '#dc3545'; // Red
        }
      }
  
  // Function to toggle password visibility with images
  function togglePasswordVisibility(inputId, toggleId) {
      const input = document.getElementById(inputId);
      const toggle = document.getElementById(toggleId);
      const toggleImg = toggle.querySelector('img');

      if (!input || !toggle || !toggleImg) {
          console.error('Missing elements for password toggle:', { input, toggle, toggleImg });
          return;
      }

      if (input.type === 'password') {
          input.type = 'text';
          // Using the specific show icon provided by the user
          toggleImg.src = 'https://img.icons8.com/external-smashingstocks-hand-drawn-black-smashing-stocks/99/external-eye-password-security-cyber-attack-hacking-smashingstocks-hand-drawn-black-smashing-stocks.png';
          toggleImg.alt = 'Show password';
      } else {
          input.type = 'password';
          // Using the specific hide icon provided by the user
          toggleImg.src = 'https://img.icons8.com/ios/50/closed-eye.png';
          toggleImg.alt = 'Hide password';
      }
  }


