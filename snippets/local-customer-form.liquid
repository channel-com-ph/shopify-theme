if (industrySelect) {
  industrySelect.addEventListener('change', function() {
      const selectedIndustry = this.value;
      console.log(`Industry changed to: ${selectedIndustry}`);

      // Reset and hide all role-dependent fields
      resetRoleDependentFields();

      // Handle "Other Industry" text field visibility and required status
      if (selectedIndustry === 'Other Industry') {
          otherIndustryTextField.style.display = 'block';
          if (otherIndustryTextInput) otherIndustryTextInput.required = true;
      } else {
          otherIndustryTextField.style.display = 'none';
          if (otherIndustryTextInput) {
              otherIndustryTextInput.required = false;
              otherIndustryTextInput.value = ''; // Clear value when hidden
          }
      }

      // Populate the role dropdown based on the selected industry
      populateRoles(selectedIndustry);

      // Show the role dropdown container if an industry is selected AND it's not "Other Industry"
      if (selectedIndustry && selectedIndustry !== 'Other Industry') {
          roleDropdownContainer.style.display = 'block';
          roleSelect.disabled = false;
          roleSelect.required = true; // Role becomes required once an industry is selected (unless "Other Industry")
      } else {
          roleDropdownContainer.style.display = 'none';
          roleSelect.required = false; // Role is not required if no industry or "Other Industry" is selected
      }

      // Update company/agency name label based on selected industry
      const companyNameLabel = document.querySelector('label[for="Local-Register-CompanyName"]');
      if (companyNameLabel) {
          if (selectedIndustry.includes('Education') || selectedIndustry.includes('AV Education')) {
              companyNameLabel.textContent = 'Institute Name (Optional)';
          } else if (selectedIndustry.includes('Religious Organizations')) {
              companyNameLabel.textContent = 'House of Worship (Optional)';
          } else {
              companyNameLabel.textContent = 'Company/Agency Name (Optional)';
          }
      }
  });
}

/**
 * Populates the Role dropdown based on the selected industry.
 * @param {string} industry The selected industry value.
 */
function populateRoles(industry) {
    console.log(`Populating roles for industry: ${industry}`);
    if (!roleSelect) return;

    roleSelect.innerHTML = '<option value="" disabled selected>Select Your Role</option>';
    const roles = window.industryRolesData[industry] || window.industryRolesData["Default Roles"]; 

    roles.sort((a, b) => a.localeCompare(b)); // Sort roles alphabetically

    roles.forEach(role => {
        const option = document.createElement('option');
        option.value = role;
        option.textContent = role;
        roleSelect.appendChild(option);
    });

    // Add "Other Role" option at the bottom of the dropdown
    const otherRoleOption = document.createElement('option');
    otherRoleOption.value = 'Other Role';
    otherRoleOption.textContent = 'Other Role';
    roleSelect.appendChild(otherRoleOption);

    roleSelect.disabled = false;
    console.log(`Populated roles for ${industry}. Total: ${roles.length + 1}`);
}

