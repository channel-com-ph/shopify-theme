    /**
     * Resets a dropdown to its initial state (disabled with a default option).
     * @param {HTMLSelectElement} dropdown The select element to reset.
     * @param {string} defaultOptionText The text for the default disabled option.
     */
    function resetDropdown(dropdown, defaultOptionText) {
        if (dropdown) {
            dropdown.innerHTML = `<option value="" disabled selected>${defaultOptionText}</option>`;
            dropdown.disabled = true;
        }
    }

    /**
     * Sets or unsets the 'required' attribute and clears the value for input/select elements
     * within a given container.
     * @param {HTMLElement} container The container element.
     * @param {boolean} isRequired Whether the fields should be required.
     */
    function setFieldsRequiredAndClear(container, isRequired) {
        if (!container) return;
        const fields = container.querySelectorAll('input, select');
        fields.forEach(field => {
            // Skip hidden inputs like postalCodeInput as their 'required' state is managed by the logic
            if (field.type === 'hidden') {
                return;
            }

            field.required = isRequired;
            if (!isRequired) {
                // Clear value and reset dropdowns only if making them not required/hidden
                if (field.tagName === 'SELECT') {
                    field.value = ''; // Attempt to reset to empty
                    if (field.querySelector('option[disabled][selected]')) {
                        field.value = ''; // Ensure the disabled selected option is active
                    }
                } else if (field.type !== 'radio' && field.type !== 'checkbox') {
                    field.value = ''; // Clear input field value
                }
            }
        });
    }

    /**
     * Get postal code from addressObject
     * @param {string} region The selected region.
     * @param {string} city The selected city.
     * @param {string|null} barangay The selected barangay (optional).
     * @returns {string} The postal code or an empty string if not found.
     */
    function getPostalCode(region, city, barangay = null) {
        // Ensure addressObject is available globally, as it's now external.
        if (typeof addressObject === 'undefined' || !region || !city || !addressObject.Philippines || !addressObject.Philippines[region]) {
            console.warn("addressObject or address data for region not found. Cannot determine postal code.");
            return '';
        }

        let targetData = null;
        const regionContent = addressObject.Philippines[region];

        // First, check if the city is directly under the region
        if (regionContent[city]) {
            targetData = regionContent[city];
        } else {
            // If not directly under, iterate through provinces/sub-regions within the region
            for (const provKey in regionContent) {
                if (regionContent[provKey] && typeof regionContent[provKey] === 'object' && regionContent[provKey][city]) {
                    targetData = regionContent[provKey][city];
                    break;
                }
            }
        }

        if (targetData) {
            if (barangay && typeof targetData[barangay] === 'string') {
                return targetData[barangay]; // Barangay has its own specific postal code
            }
            return targetData.postal_code || ''; // Return city's postal code or empty string
        }
        return '';
    }

    /**
     * Updates the postal code input field based on the current dropdown selections.
     * @param {HTMLSelectElement} provinceDropdown The province select element.
     * @param {HTMLSelectElement} cityDropdown The city select element.
     * @param {HTMLSelectElement} barangayDropdown The barangay select element.
     * @param {HTMLInputElement} postalInput The postal code input element.
     */
    function updatePostalCodeInput(provinceDropdown, cityDropdown, barangayDropdown, postalInput) {
        const selectedRegion = provinceDropdown.value;
        const selectedCity = cityDropdown.value;
        const selectedBarangay = barangayDropdown ? barangayDropdown.value : null;

        if (postalInput) {
            postalInput.value = getPostalCode(selectedRegion, selectedCity, selectedBarangay);
        }
    }


    /**
     * Populates the Region/Province dropdown with Philippine Regions.
     * @param {HTMLSelectElement} provinceDropdown The province select element to populate.
     * @param {HTMLSelectElement} cityDropdown The city select element to clear and disable.
     * @param {HTMLSelectElement} barangayDropdown The barangay select element to clear and disable.
     * @param {HTMLInputElement} postalInput The postal code input to clear.
     */
    function populateRegions(provinceDropdown, cityDropdown, barangayDropdown, postalInput) {
        if (!provinceDropdown || typeof addressObject === 'undefined' || !addressObject.Philippines) {
            console.warn("addressObject or address data for regions not found during populateRegions.");
            resetDropdown(provinceDropdown, 'Select Region/Province');
            return;
        }

        provinceDropdown.disabled = false;
        resetDropdown(cityDropdown, 'Select City/Municipality');
        resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
        if (postalInput) postalInput.value = ''; // Clear postal code input

        provinceDropdown.innerHTML = '<option value="" disabled selected>Select Region/Province</option>';
        const regions = Object.keys(addressObject.Philippines);
        regions.forEach(region => {
            const option = document.createElement('option');
            option.value = region;
            option.textContent = region;
            provinceDropdown.appendChild(option);
        });

        // After populating regions, clear related city/barangay/postal for initial state
        resetDropdown(cityDropdown, 'Select City/Municipality');
        resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
        if (postalInput) postalInput.value = '';
    }

    /**
     * Populates the City/Municipality dropdown based on selected Region/Province.
     * @param {HTMLSelectElement} provinceDropdown The province select element holding the selected region.
     * @param {HTMLSelectElement} cityDropdown The city select element to populate.
     * @param {HTMLSelectElement} barangayDropdown The barangay select element to clear and disable.
     * @param {HTMLInputElement} postalInput The postal code input to clear.
     */
    function populateCities(provinceDropdown, cityDropdown, barangayDropdown, postalInput) {
        const selectedRegion = provinceDropdown.value;
        if (typeof addressObject === 'undefined' || !selectedRegion || !addressObject.Philippines[selectedRegion]) {
            console.warn("addressObject or address data for selected region not found during populateCities.");
            resetDropdown(cityDropdown, 'Select City/Municipality');
            return;
        }

        cityDropdown.disabled = false;
        resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
        if (postalInput) postalInput.value = ''; // Clear postal code input

        cityDropdown.innerHTML = '<option value="" disabled selected>Select City/Municipality</option>';
        const regionContent = addressObject.Philippines[selectedRegion];
        for (const key in regionContent) {
            // Case 1: key is directly a city (e.g., "Caloocan City" under "NCR / Metro Manila")
            // A city is identified by having properties that are either strings (barangay postal codes) or 'postal_code'
            if (regionContent[key] && typeof regionContent[key] === 'object' &&
                Object.keys(regionContent[key]).some(subKey => typeof regionContent[key][subKey] === 'string' || subKey === 'postal_code')) {
                const option = document.createElement('option');
                option.value = key;
                option.textContent = key;
                cityDropdown.appendChild(option);
            }
            // Case 2: key is a province/sub-region which contains cities (e.g., "Benguet" under "CAR")
            else if (regionContent[key] && typeof regionContent[key] === 'object') {
                for (const cityKey in regionContent[key]) {
                    if (regionContent[key][cityKey] && typeof regionContent[key][cityKey] === 'object' &&
                        Object.keys(regionContent[key][cityKey]).some(subSubKey => typeof regionContent[key][cityKey][subSubKey] === 'string' || subSubKey === 'postal_code')) {
                        const option = document.createElement('option');
                        option.value = cityKey;
                        option.textContent = cityKey;
                        cityDropdown.appendChild(option);
                    }
                }
            }
        }
        updatePostalCodeInput(provinceDropdown, cityDropdown, barangayDropdown, postalInput);
    }

    /**
     * Populates the Barangay/Sub-Municipality dropdown.
     * @param {HTMLSelectElement} provinceDropdown The province select element holding the selected region.
     * @param {HTMLSelectElement} cityDropdown The city select element holding the selected city.
     * @param {HTMLSelectElement} barangayDropdown The barangay select element to populate.
     * @param {HTMLInputElement} postalInput The postal code input (now just cleared, not set).
     */
    function populateBarangays(provinceDropdown, cityDropdown, barangayDropdown, postalInput) {
        const selectedRegion = provinceDropdown.value;
        const selectedCity = cityDropdown.value;

        if (typeof addressObject === 'undefined' || !selectedRegion || !selectedCity || !addressObject.Philippines[selectedRegion]) {
            console.warn("addressObject or address data for selected region/city not found during populateBarangays.");
            resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
            if (postalInput) postalInput.value = ''; // Clear postal code
            return;
        }

        barangayDropdown.disabled = false;
        barangayDropdown.innerHTML = '<option value="" disabled selected>Select Barangay/Sub-Municipality</option>';

        let targetCityData = null;
        const regionContent = addressObject.Philippines[selectedRegion];

        if (regionContent) {
            // Find the correct city data, whether it's directly under region or nested under a province within the region
            if (regionContent[selectedCity] && typeof regionContent[selectedCity] === 'object') {
                targetCityData = regionContent[selectedCity];
            } else {
                for (const provinceKey in regionContent) {
                    if (regionContent[provinceKey] && typeof regionContent[provinceKey] === 'object' && regionContent[provinceKey][selectedCity]) {
                        targetCityData = regionContent[provinceKey][selectedCity];
                        break;
                    }
                }
            }
        }

        if (targetCityData) {
            const barangays = Object.keys(targetCityData).filter(key => key !== 'postal_code');
            barangays.forEach(barangay => {
                const option = document.createElement('option');
                option.value = barangay;
                option.textContent = barangay;
                barangayDropdown.appendChild(option);
            });
        } else {
            resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
        }
        // Always update postal code here, even if no barangay selected (it will use city's)
        updatePostalCodeInput(provinceDropdown, cityDropdown, barangayDropdown, postalInput);
    }


    function validateFormFields() {
        const allFormElements = form.querySelectorAll('input, select, textarea');
        const hiddenRequiredFields = [];

        allFormElements.forEach(field => {
            const isHidden = field.offsetParent === null || field.offsetWidth === 0 || field.offsetHeight === 0 ||
                                     field.style.display === 'none';
            
            if (field.type === 'hidden') {
                return;
            }

            if (field.required && isHidden) {
                field.setAttribute('data-temp-required', 'true');
                field.required = false;
                hiddenRequiredFields.push(field);
            }
        });

        let allValid = true;
        const visibleRequiredInputs = form.querySelectorAll('[required]:not([type="hidden"])');

        for (let i = 0; i < visibleRequiredInputs.length; i++) {
            const input = visibleRequiredInputs[i];
            // Ensure the element is visible and required before validating it
            if (input.offsetParent === null || input.offsetWidth === 0 || input.offsetHeight === 0 || input.style.display === 'none') {
                continue;
            }
            if (!input.checkValidity()) {
                allValid = false;
                input.reportValidity(); // Show native browser validation message
                break;
            }
        }

        // Check for password strength
        const passwordInput = document.getElementById('RegisterForm-password');
        // IMPORTANT: The checkPasswordStrength function now returns a boolean for strict validation
        if (passwordInput && !checkPasswordStrength(passwordInput.value)) { // Check if passwordInput exists before accessing value
            showCustomMessage('Your password does not meet all the required criteria. Please review the password requirements.');
            allValid = false;
            passwordInput.focus(); // Focus on password field to help user
            // Do not return here, allow restoration of required fields
        }

        // Check for password match AFTER individual field validity and strength
        const confirmPasswordInput = document.getElementById('RegisterForm-confirm-password');
        if (passwordInput && confirmPasswordInput && passwordInput.value !== confirmPasswordInput.value) { // Check if both exist
            showCustomMessage('Passwords do not match. Please ensure both password fields are identical.');
            allValid = false; // Set overall validity to false
            // Optionally, focus on the confirm password field to highlight the issue
            confirmPasswordInput.focus();
        }


        hiddenRequiredFields.forEach(field => {
            field.required = true;
            field.removeAttribute('data-temp-required');
        });

        return allValid;
    }


