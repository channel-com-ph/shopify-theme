if (roleSelect) {
    roleSelect.addEventListener('change', function() {
        const selectedRole = this.value;
        console.log(`Role changed to: ${selectedRole}`);

        // Reset and hide all role-dependent fields before showing the relevant one
        resetRoleDependentFields();

        // Re-apply industry-based label (important for consistency)
        const currentIndustry = industrySelect.value;
        const companyNameLabel = document.querySelector('label[for="Local-Register-CompanyName"]');
        if (companyNameLabel) {
            if (currentIndustry.includes('Education') || currentIndustry.includes('AV Education')) {
                companyNameLabel.textContent = 'Institute Name (Optional)';
                employmentPrivateGovernmentFields.style.display = 'block'; // Show for Educator/Academic
            } else if (currentIndustry.includes('Religious Organizations')) {
                companyNameLabel.textContent = 'House of Worship (Optional)';
                employmentReligiousFields.style.display = 'block'; // Show religious fields
            } else {
                companyNameLabel.textContent = 'Company/Agency Name (Optional)';
                employmentPrivateGovernmentFields.style.display = 'block'; // Show for general company/agency
            }
        }

        // Determine which category the selected role falls into
        if (selectedRole.includes('Student')) {
            employmentStudentFields.style.display = 'block';
            employmentPrivateGovernmentFields.style.display = 'none'; // Hide company/agency for students
        } else if (selectedRole.includes('Business Owner / Proprietor')) {
            employmentSelfEmployedFields.style.display = 'block';
            if (businessTypeInput) businessTypeInput.required = true; // Business Type is required for Business Owner
        } else if (selectedRole.includes('Freelancer') || selectedRole.includes('Musician / Artist / Performer')) {
            employmentSelfEmployedFields.style.display = 'block';
            // businessTypeInput is optional for these roles
        } else if (selectedRole.includes('Unemployed')) {
            employmentUnemployedFields.style.display = 'block';
            // previousOccupationInput is optional
        } else if (selectedRole.includes('Home User / Hobbyist')) {
            employmentHomemakerFields.style.display = 'block'; // No specific inputs, just shows the section
        } else if (selectedRole.includes('Other Role')) {
            employmentOtherFields.style.display = 'block';
            if (otherEmploymentInput) otherEmploymentInput.required = true; // Make "Other Role" required
        }
    });
}


// --- Initial Setup on Page Load ---
// Function to populate the industry dropdown
function populateIndustryDropdown() {
    if (!industrySelect) return;

    industrySelect.innerHTML = '<option value="" disabled selected>Select Your Industry</option>';

    const newAVIndustries = [
        "AV Rental & Staging",
        "AV Integration"
    ];

    // Add new AV industries first
    newAVIndustries.forEach(industry => {
        const option = document.createElement('option');
        option.value = industry;
        option.textContent = industry;
        industrySelect.appendChild(option);
    });

    // Get all other industries, excluding AV, Default Roles, Other Industry, and removed ones
    let otherIndustries = Object.keys(window.industryRolesData).filter(
        key => !newAVIndustries.includes(key) &&
               key !== "Default Roles" &&
               key !== "Other Industry"
    );

    // Sort the remaining industries alphabetically
    otherIndustries.sort((a, b) => a.localeCompare(b));

    // Add the sorted non-AV industries
    otherIndustries.forEach(industry => {
        const option = document.createElement('option');
        option.value = industry;
        option.textContent = industry;
        industrySelect.appendChild(option);
    });

    // Add "Other Industry" at the very end
    const otherIndustryOption = document.createElement('option');
    otherIndustryOption.value = 'Other Industry';
    otherIndustryOption.textContent = 'Other Industry (please specify)';
    industrySelect.appendChild(otherIndustryOption);
}

// Call this function to populate the industry dropdown when the DOM is ready
populateIndustryDropdown();


    // 1. Trigger initial industry logic to set default visibility and required states
    if (industrySelect) {
      industrySelect.dispatchEvent(new Event('change'));
    }

    // 2. Attach all address-related event listeners directly.
    // These functions (populateRegions, populateCities, populateBarangays, updatePostalCodeInput)
    // now assume addressObject is already defined by the time DOMContentLoaded fires,
    // as address-custom.js is linked before this script.
    if (philippineAddressProvinceSelect) {
        philippineAddressProvinceSelect.addEventListener('change', () => populateCities(philippineAddressProvinceSelect, philippineAddressCitySelect, philippineAddressBarangaySelect, postalCodeInput));
    }
    if (philippineAddressCitySelect) {
        philippineAddressCitySelect.addEventListener('change', () => populateBarangays(philippineAddressProvinceSelect, philippineAddressCitySelect, philippineAddressBarangaySelect, postalCodeInput));
    }
    if (philippineAddressBarangaySelect) {
        philippineAddressBarangaySelect.addEventListener('change', () => updatePostalCodeInput(philippineAddressProvinceSelect, philippineAddressCitySelect, philippineAddressBarangaySelect, postalCodeInput));
    }

    // Company Address dropdowns (these will likely be null if not added to HTML)
    if (companyAddressPGProvinceSelect) {
        companyAddressPGProvinceSelect.addEventListener('change', () => populateCities(companyAddressPGProvinceSelect, companyAddressPGCitySelect, companyAddressPGBarangaySelect, companyPostalCodePGInput));
    }
    if (companyAddressPGCitySelect) {
        companyAddressPGCitySelect.addEventListener('change', () => populateBarangays(companyAddressPGProvinceSelect, companyAddressPGCitySelect, companyAddressPGBarangaySelect, companyPostalCodePGInput));
    }
    if (companyAddressPGBarangaySelect) {
        companyAddressPGBarangaySelect.addEventListener('change', () => updatePostalCodeInput(companyAddressPGProvinceSelect, companyAddressPGCitySelect, companyAddressPGBarangaySelect, companyPostalCodePGInput));
    }

    if (companyAddressSEProvinceSelect) {
        companyAddressSEProvinceSelect.addEventListener('change', () => populateCities(companyAddressSEProvinceSelect, companyAddressSECitySelect, companyAddressSEBarangaySelect, companyPostalCodeSEInput));
    }
    if (companyAddressSECitySelect) {
        companyAddressSECitySelect.addEventListener('change', () => populateBarangays(companyAddressSEProvinceSelect, companyAddressSECitySelect, companyAddressSEBarangaySelect, companyPostalCodeSEInput));
    }
    if (companyAddressSEBarangaySelect) {
        companyAddressSEBarangaySelect.addEventListener('change', () => updatePostalCodeInput(companyAddressSEProvinceSelect, companyAddressSECitySelect, companyAddressSEBarangaySelect, companyPostalCodeSEInput));
    }

    // 3. Ensure shipping address fields are always visible and required on load
    // The HTML now has display: block; for shipping-address-container and display: flex; for ph-address-fields and ph-barangay-zip-fields.
    if (shippingAddress1Input) shippingAddress1Input.required = true;
    // if (addressCountrySelect) addressCountrySelect.required = true; // Country is fixed to Philippines, no longer a select

    document.querySelectorAll('#ph-address-fields select, #ph-barangay-zip-fields select').forEach(s => s.required = true);
    document.getElementById('postalCode').required = true;

    // Explicitly populate regions and then trigger change if a value is pre-selected
    populateRegions(philippineAddressProvinceSelect, philippineAddressCitySelect, philippineAddressBarangaySelect, postalCodeInput);
    if (philippineAddressProvinceSelect.value) { // Check if a default value is present
        philippineAddressProvinceSelect.dispatchEvent(new Event('change')); // Trigger city/barangay/postal population
    }


      // Gather all form data from visible/relevant fields
      const formData = {
        first_name: document.getElementById('RegisterForm-FirstName').value,
        last_name: document.getElementById('RegisterForm-LastName').value,
        birthdate: document.getElementById('RegisterForm-birthdate').value,
        phone_country_code: "+63", // Fixed to +63
        phone: document.getElementById('ContactForm-phone').value,
        industry: industrySelect ? industrySelect.value : '', // Changed to industry
        role_title: roleSelect && roleSelect.style.display !== 'none' ? roleSelect.value : '', // Now directly maps to role/job title
        
        // Conditional Employment Fields (capture value only if field exists and is visible/relevant)
        school_name: employmentStudentFields.style.display !== 'none' && schoolNameInput ? schoolNameInput.value : '',
        company_agency_name: employmentPrivateGovernmentFields.style.display !== 'none' && companyNameInput ? companyNameInput.value : '',
        business_type: employmentSelfEmployedFields.style.display !== 'none' && businessTypeInput ? businessTypeInput.value : '',
        previous_occupation: employmentUnemployedFields.style.display !== 'none' && previousOccupationInput ? previousOccupationInput.value : '', // Only for Unemployed
        house_of_worship: employmentReligiousFields.style.display !== 'none' && houseOfWorshipInput ? houseOfWorshipInput.value : '', // NEW: Capture House of Worship
        other_employment_status: employmentOtherFields.style.display !== 'none' && otherEmploymentInput ? otherEmploymentInput.value : '',
        other_industry_text: otherIndustryTextField.style.display !== 'none' && otherIndustryTextInput ? otherIndustryTextInput.value : '', // NEW: Capture Other Industry text

        // Shipping Address Data (always included now)
        shipping_provided: 'Yes', // Always 'Yes' now
        shipping_address_line1: shippingAddress1Input ? shippingAddress1Input.value : '',
        shipping_country: 'Philippines', // Fixed to Philippines
        shipping_province: philippineAddressProvinceSelect ? philippineAddressProvinceSelect.value : '',
        shipping_city: philippineAddressCitySelect ? philippineAddressCitySelect.value : '',
        shipping_barangay: philippineAddressBarangaySelect ? philippineAddressBarangaySelect.value : '',
        shipping_postal_code: postalCodeInput ? postalCodeInput.value : '',

        email: document.getElementById('RegisterForm-email').value,
        accepts_marketing: document.getElementById('marketing').checked ? 'Yes' : 'No',
        timestamp: new Date().toISOString()
      };

    // --- Form Submission Logic ---
    form.addEventListener('submit', function(e) {
      // 1. Always prevent default immediately to control submission flow
      e.preventDefault();

      // 2. Perform final validation
      if (!validateFormFields()) {
        // If validation fails, UI messages are already handled by validateFormFields
        return; // Stop here, do not proceed with loading or submission
      }

      // 3. Apply the loading state immediately
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
          submitBtn.textContent = 'Processing...';
          submitBtn.disabled = true;
      }

      // 4. Defer the actual form submission slightly
      // This allows the browser to render the 'Processing...' state.
      setTimeout(() => {
        form.submit();
      }, 0); // Small delay to allow DOM repaint
    });
  });
</script>