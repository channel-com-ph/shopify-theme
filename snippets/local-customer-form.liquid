{%- form 'create_customer', novalidate: 'novalidate', id: 'local-register-form' -%}
  {%- comment -%}
    This include is expected to define `addressObject` in JavaScript
    or provide data that JavaScript can use to build it.
  {%- endcomment -%}

  {%- if form.errors -%}
    <h2 class="form__message" tabindex="-1" autofocus style="font-size: 1.7rem;">
      <span class="svg-wrapper">
        {{- 'icon-error.svg' | inline_asset_content -}}
      </span>
      {{ 'templates.contact.form.error_heading' | t }}
    </h2>
    <ul style="font-size: 1.7rem;">
      {%- for field in form.errors -%}
        <li>
          {%- if field == 'form' -%}
            {{ form.errors.messages[field] }}
          {%- else -%}
            <a href="#RegisterForm-{{ field }}">
              {{ form.errors.translated_fields[field] | capitalize }}
              {{ form.errors.messages[field] }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <span style="display: flex; font-size: 1.9rem; font-weight:600; margin: 1.5rem 0 1rem; color: black;"
    >Personal Information</span
  >

  <div class="setRow">
    <div class="setCol">
      <label for="RegisterForm-FirstName" style="font-size: 1.5rem;"
        ><span class="required-asterisk">*</span>{{ 'customer.register.first_name' | t -}}
      </label>
      <div class="firstname-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterForm-FirstName"
            {% if form.first_name %}
              value="{{ form.first_name }}"
            {% endif %}
            autocomplete="given-name"

            required
            minlength="2"
            maxlength="25"
          >
        </div>
      </div>
    </div>
    <div class="setCol">
      <label for="RegisterForm-LastName" style="font-size: 1.5rem;"
        ><span class="required-asterisk">*</span>{{ 'customer.register.last_name' | t -}}
      </label>
      <div class="lastname-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterForm-LastName"
            {% if form.last_name %}
              value="{{ form.last_name }}"
            {% endif %}
            autocomplete="family-name"

            required
            minlength="2"
            maxlength="25"
          >
        </div>
      </div>
    </div>
  </div>

  <div class="setRow">
    <div class="setCol">
      <label for="RegisterForm-birthdate" style="font-size: 1.5rem;"
        ><span class="required-asterisk">*</span>Birthdate</label
      >
      <div class="birthdate-field form-input-container" style="margin: 0; align-items: center;">
        <div class="form-input-box">
          <input
            type="text" 
            name="customer[note][Birthdate]"
            id="RegisterForm-birthdate"
            autocomplete="bday"
            aria-required="true"
            required
            readonly {# Added readonly to prevent manual input #}
          >
        </div>
      </div>
    </div>
    <div class="setCol">
      <label for="ContactForm-phone" style="font-size: 1.5rem;"
        ><span class="required-asterisk">*</span>Mobile Number</label
      >
      <div class="setRow" style="gap: 8px; flex-wrap: nowrap;">
        <div
          class="country-code-field form-input-container"
          style="width: 30%; min-width: 80px; margin-top: 0; color: grey;"
        >
          <!-- Static display for +63 -->
          <div class="form-input-box" style="justify-content: center;">
            <span style="font-size: 1.7rem; color: #555;">+63</span>
           <!----> <input type="hidden" name="customer[note][CountryCode]" value="+63">
          </div>
        </div>
        <div class="contact-n-field form-input-container" style="flex: 1; margin-top: 0;">
          <div class="form-input-box">
            <input
              type="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[0-9\-]*"
              id="ContactForm-phone"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"

              name="customer[note][Contact Number]"
              autocomplete="tel"
              aria-required="true"
              value="{{ form.phone }}"
              minlength="10"
              maxlength="10"
              pattern="[0-9]{10}"
              required
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Address Section -->
  <div>
   <!-- <span style="display: flex; font-size: 1.9rem; font-weight:600; margin: 1.5rem 0 1rem; color: black;"
      >Shipping Address</span
    >-->
    <!-- Removed "Do you want to provide a shipping address?" radio buttons -->

    <!-- ADDRESS -->
    <div id="shipping-address-container" style="display: block;">
     <!--  <div class="setCol">
        <label for="addressCountry" style="font-size: 1.5rem;">Country</label>
        <div class="address-country-field form-input-container dropdown-wrapper">
          <select id="addressCountry" name="customer[note][addresses][0][country]" required>
            <option value="Philippines" selected>Philippines</option>
          </select>
          <span class="svg-wrapper" style="margin-right: 10px;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-caret-down"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </span>
        </div>
      </div>-->

      <div class="setCol">
        <label for="RegisterForm-homeAddress" style="font-size: 1.5rem;"
          ><span class="required-asterisk">*</span>Address Unit/Floor/Apartment No., Street Name, etc.</label
        >
        <div class="home-address-field form-input-container">
          <div class="form-input-box">
            <input
              type="text"
              name="customer[note][addresses][0][address1]"

              id="RegisterForm-homeAddress"
              autocomplete="street-address"
              minlength="5"
              maxlength="100"
              required
            >
          </div>
        </div>
      </div>

      <!-- Philippine-specific address fields -->
      <div class="setRow" id="ph-address-fields" style="display: flex;">
        <div class="setCol">
          <label for="philippineAddressProvince" style="display: flex; font-size: 1.5rem;"
            ><span class="required-asterisk">*</span>Region/Province</label
          >
          <div class="address-province-field form-input-container dropdown-wrapper">
            <select
              id="philippineAddressProvince"
              name="customer[note][addresses][0][province]"
              required
            >
              <option value="" disabled selected>Select Region/Province</option>
            </select>
            <span class="svg-wrapper" style="margin-right: 10px;">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-caret-down"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </span>
        </div>
        </div>
        <div class="setCol">
          <label for="philippineAddressCity" style="display: flex; font-size: 1.5rem;"
            ><span class="required-asterisk">*</span>City/Municipality</label
          >
          <div class="address-city-field form-input-container dropdown-wrapper">
            <select id="philippineAddressCity" name="customer[note][addresses][0][city]" required>
              <option value="" disabled selected>Select City/Municipality</option>
            </select>
            <span class="svg-wrapper" style="margin-right: 10px;">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucisde-caret-down"
              >
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </div>
        </div>
      </div>

      <div class="setRow" id="ph-barangay-zip-fields" style="display: flex;">
        <div class="setCol">
          <label for="philippineAddressBarangay" style="display: flex; font-size: 1.5rem;"
            ><span class="required-asterisk">*</span>Barangay/Sub-Municipality</label
          >
          <div class="address-barangay-field form-input-container dropdown-wrapper">
            <select id="philippineAddressBarangay" name="customer[note][Barangay]" required>
              <option value="" disabled selected>Select Barangay/Sub-Municipality</option>
            </select>
            <span class="svg-wrapper" style="margin-right: 10px;">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-caret-down"
              >
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </div>
        </div>
        <div class="setCol">
          <label for="postalCode" style="display: flex; font-size: 1.5rem;"
            ><span class="required-asterisk">*</span>Postal/Zip Code</label
          >
          <div class="postal-code-field form-input-container">
            <div class="form-input-box">
              <input
                type="text"
                id="postalCode"
                name="customer[note][addresses][0][zip]"
                placeholder="e.g., 1000"
                minlength="4"
                maxlength="4"
                pattern="[0-9]{4}"
                required
              >
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- End shipping-address-container -->
  </div>

  <!-- Your Industry / Role Section (Updated) -->
  <div class="setCol" style="margin-top: 1.5rem;">
    <span style="display: flex; font-size: 1.9rem; font-weight:600; margin: 1.5rem 0 1rem; color: black;">
      <span class="required-asterisk">*</span>Industry</span
    >

    <div class="industry-field form-input-container dropdown-wrapper">
      <select id="Local-Register-Industry" name="customer[note][Industry]" required>
        <option value="" disabled selected>Select Your Industry</option>
        <!-- Options will be populated by JS -->
      </select>
      <span class="svg-wrapper" style="margin-right: 10px;">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-caret-down"
        >
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </span>
    </div>
  </div>

  <!-- New field for "Other Industry" -->
  <div id="other-industry-text-field" class="setCol" style="margin-top: 1.5rem; display: none;">
    <label for="Local-Register-OtherIndustryText" style="font-size: 1.5rem;">Please specify your industry</label>
    <div class="other-industry-input-field form-input-container">
      <div class="form-input-box">
        <input
          type="text"
          name="customer[note][OtherIndustryText]"
          id="Local-Register-OtherIndustryText"
          minlength="3"
          maxlength="100"
        >
      </div>
    </div>
  </div>

  <!-- New Role Dropdown (initially hidden) -->
  <div id="local-role-dropdown-container" class="setCol" style="margin-top: 1.5rem; display: none;">
    <label for="Local-Register-Role" style="font-size: 1.5rem;"><span class="required-asterisk">*</span>Your Role</label>
    <div class="role-field form-input-container dropdown-wrapper">
      <select id="Local-Register-Role" name="customer[note][Role]">
        <option value="" disabled selected>Select Your Role</option>
        <!-- Options will be populated by JS based on Industry selection -->
      </select>
      <span class="svg-wrapper" style="margin-right: 10px;">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-caret-down"
        >
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </span>
    </div>
  </div>

  <!-- Conditional fields based on Role (Updated IDs) -->
  <div id="local-employment-student-fields" style="display: none;">
    <div class="setCol" style="margin-top: 1.5rem;">
      <label for="Local-Register-SchoolName" style="font-size: 1.5rem;"> Institute Name (Optional)</label>
      <div class="school-name-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[note][SchoolName]"
            id="Local-Register-SchoolName"
            minlength="3"
            maxlength="100"
          >
        </div>
      </div>
    </div>
  </div>

  <div id="local-employment-private-government-fields" style="display: none;">
    <div class="setCol" style="margin-top: 1.5rem;">
      <label for="Local-Register-CompanyName" style="font-size: 1.5rem;"> Company/Agency Name (Optional)</label>
      <div class="company-name-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[note][CompanyName]"
            id="Local-Register-CompanyName"
            {% if form.company %}
              value="{{ form.company }}"
            {% endif %}
            minlength="3"
            maxlength="100"
          >
        </div>
      </div>
    </div>
  </div>

  <div id="local-employment-selfemployed-fields" style="display: none;">
    <div class="setCol" style="margin-top: 1.5rem;">
      <label for="Local-Register-BusinessType" style="font-size: 1.5rem;"> Type of Business</label>
      <div class="business-type-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[note][BusinessType]"
            id="Local-Register-BusinessType"
            minlength="3"
            maxlength="100"
          >
        </div>
      </div>
    </div>
  </div>

  <div id="local-employment-unemployed-fields" style="display: none;">
    <div class="setCol" style="margin-top: 1.5rem;">
      <label for="Local-Register-PreviousOccupation" style="font-size: 1.5rem;">Previous Occupation (Optional)</label>
      <div class="previous-occupation-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[note][PreviousOccupation]"
            id="Local-Register-PreviousOccupation"
            minlength="2"
            maxlength="50"
          >
        </div>
      </div>
    </div>
  </div>

  <div id="local-employment-homemaker-fields" style="display: none;">
    <!-- No specific fields for homemaker -->
  </div>

  <!-- NEW: Religious Organization Fields (Updated IDs) -->
  <div id="local-employment-religious-fields" style="display: none;">
    <div class="setCol" style="margin-top: 1.5rem;">
      <label for="Local-Register-HouseOfWorship" style="font-size: 1.5rem;"> House of Worship (Optional)</label>
      <div class="house-of-worship-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[note][HouseOfWorship]"
            id="Local-Register-HouseOfWorship"
            minlength="3"
            maxlength="100"
          >
        </div>
      </div>
    </div>
  </div>

  <div id="local-employment-other-fields" style="display: none;">
    <div class="setCol" style="margin-top: 1.5rem;">
      <label for="Local-Register-OtherEmployment" style="font-size: 1.5rem;"> Role</label>
      <div class="other-employment-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[note][OtherEmploymentStatus]"
            id="Local-Register-OtherEmployment"
            minlength="3"
            maxlength="100"
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Account Information Section -->
  <div>
    <span style="display: flex; font-size: 1.9rem; font-weight:600; margin: 1.5rem 0 1rem; color: black;"
      >Account Information</span
    >

    <!-- Email Field -->
    <div class="setRow">
      <div class="setCol">
        <label for="RegisterForm-email" style="font-size: 1.5rem;"
          ><span class="required-asterisk">*</span>{{ 'customer.register.email' | t -}}
        </label>
        <div class="email-field password-field-wrapper">
          <!-- Using password-field-wrapper for consistent styling -->
          <input
            type="email"
            name="customer[email]"
            id="RegisterForm-email"
            {% if form.email %}
              value="{{ form.email }}"
            {% endif %}
            spellcheck="false"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}

            minlength="5"
            maxlength="35"
            required
          >
        </div>
      </div>
      <div class="setCol">
        <!-- Empty column for alignment if needed, or remove if not necessary for balance -->
      </div>
    </div>

    <!-- Password and Confirm Password Fields side-by-side -->
    <div class="setRow">
      <div class="setCol">
        <!-- Password Field -->
        <label for="RegisterForm-password" style="font-size: 1.5rem;"
          ><span class="required-asterisk">*</span>{{ 'customer.register.password' | t -}}
        </label>
        <div class="password-field password-field-wrapper">
          <input
            type="password"
            name="customer[password]"
            id="RegisterForm-password"
            aria-required="true"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
            {% endif %}

            minlength="8"
            maxlength="20"
            required
            oninput="checkPasswordStrength(this.value); checkPasswordsMatch();"
          >
          <span class="password-toggle" id="togglePassword">
            <img src="https://img.icons8.com/ios/50/closed-eye.png" alt="Hide password">
          </span>
        </div>
      </div>
      <div class="setCol">
        <!-- Confirm Password Field -->
        <label for="RegisterForm-confirm-password" style="font-size: 1.5rem;"> Confirm Password</label>
        <div class="confirm-password-field password-field-wrapper">
          <input
            type="password"
            name="customer[password_confirmation]"
            id="RegisterForm-confirm-password"
            aria-required="true"
            minlength="8"
            maxlength="20"
            required
            oninput="checkPasswordsMatch();"
          >
          <span class="password-toggle" id="toggleConfirmPassword">
            <img src="https://img.icons8.com/ios/50/closed-eye.png" alt="Hide password">
          </span>
        </div>
        <p
          id="password-match-feedback"
          class="password-match-feedback"
          style="
            margin-top: 8px;
            font-size: 0.9rem;
            height: 18px;
            transition: all 0.3s ease;
          "
        ></p>
      </div>
    </div>

    <!-- Password requirements and strength below the password fields -->
    <div class="setRow">
      <div class="setCol">
        <div
          id="password-requirements"
          style="margin-top: 1rem; font-size: 1.5rem; color: #555; background-color: #f8f8f8; padding: 1rem; border-radius: 6px; line-height: 1.6;"
        >
          <!-- <div style="font-weight: 600; margin-bottom: 0.6rem; font-size: 1.5rem;">Password must include:</div> -->
          <div style="font-weight: 600; margin-bottom: 0.6rem; font-size: 1.5rem;">Password must include:</div>
          <ul style="margin: 0; padding-left: 1.5rem; font-size: 1.1rem;">
            <li id="length-req" style="margin-bottom: 0.4rem; color: #e74c3c;">
              ✓ At least 8 characters (12+ recommended)
            </li>
            <li id="upper-req" style="margin-bottom: 0.4rem; color: #e74c3c;">✓ At least One uppercase letter (A-Z)</li>
            <li id="lower-req" style="margin-bottom: 0.4rem; color: #e74c3c;">✓ At least One lowercase letter (a-z)</li>
            <li id="number-req" style="margin-bottom: 0.4rem; color: #e74c3c;">✓ At least One number (0-9)</li>
            <li id="special-req" style="color: #e74c3c;">✓ At least One special character (!@#$% etc.)</li>
          </ul>
        </div>

        <div id="password-strength" style="margin-top: 1rem; font-size: 1.6rem; display: flex; align-items: center;">
          <span style="margin-right: 0.5rem;">Password Strength:</span>
          <span id="strength-meter" style="font-weight: 600;">None</span>
        </div>
      </div>
      <div class="setCol">
        <!-- Empty column for alignment if needed, or remove if not necessary for balance -->
      </div>
    </div>

    <div style="margin-top: 1.5rem; font-size: 1.1rem;">
      <label
        for="marketing"
        style="display: flex; gap: 10px; align-items: flex-start; line-height: 1.4;"
      >
        <input
          type="checkbox"
          name="customer[accepts_marketing]"
          value="true"
          id="marketing"
          checked
          style=" background-color: red; margin-top: 0.2em; flex-shrink: 0;"
        >
        <span
          >Subscribe to our newsletter and stay updated on the latest products, announcements, and exclusive offers.</span
        >
      </label>

      <div style="margin-top: 1rem; text-align: center; line-height: 1.4; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25em; font-size: 1.1rem;">
        <span>By creating an account, you agree to our</span>
        <a href="/policies/terms-of-service" style="white-space: nowrap;">Terms</a>
        <span>and have read and acknowledge the</span>
        <a href="/policies/privacy-policy" style="white-space: nowrap;">Privacy Policy</a>.
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
      <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-md text-xl">
        {{ 'customer.register.submit' | t }} AN ACCOUNT
      </button>
    </div>
  </div>
{%- endform -%}

