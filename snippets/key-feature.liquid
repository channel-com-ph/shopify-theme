{%- assign main_feature = product.metafields.custom.feature | metafield_tag -%}
{%- assign main_features = product.metafields.custom.features | metafield_tag -%}

<div class="key-feature">
  <h4>Key Features</h4>
  {{ main_feature }}
  {{ main_features }}
</div>
<style>
  .key-feature {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    font-size: 14px;
    gap: 0;
  }
  .key-feature ul {
    list-style-type: disc;
    list-style-position: inside;
    padding-left: 0;      
    margin-left: 20px;
    margin-bottom: 0;
    margin-top: 0;
     text-align: justify;
  }
  .metafield-rich_text_field {
    margin-bottom: 0;
  }

    .key-features li {
    text-align: justify;       /* justify text */
    text-justify: inter-word;
    margin-bottom: 8px;
  }

</style>
