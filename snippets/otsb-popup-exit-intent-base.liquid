    {%- assign minified_style = minified_style | append: new_word -%}
{%- endfor -%}
{{-minified_style-}}
<script src="{{ 'otsb-popup.min.js' | asset_url }}" defer></script>
{% if thankiu_block.settings.coupon_code != blank %}
<script src="{{ 'otsb-coupon-code.min.js' | asset_url }}" defer></script>
{% endif %}
