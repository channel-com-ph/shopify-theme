    /**
     * Validates all visible and required fields on the form.
     * Temporarily disables 'required' for hidden fields to allow form submission.
     */
    function validateFormFields() { // Renamed from validatePageFields
      console.log('[validateFormFields] Called.');
      const allFormElements = form.querySelectorAll('input, select, textarea');
      const hiddenRequiredFields = [];

      allFormElements.forEach(field => {
          const isHidden = field.offsetParent === null || field.offsetWidth === 0 || field.offsetHeight === 0 ||
                                   field.style.display === 'none';
          
          if (field.type === 'hidden') {
              return;
          }

          if (field.required && isHidden) {
              field.setAttribute('data-temp-required', 'true');
              field.required = false;
              hiddenRequiredFields.push(field);
              console.log(`[validateFormFields] Temporarily disabled required for hidden field: ${field.id}`);
          }
      });

      let allValid = true;
      const visibleRequiredInputs = form.querySelectorAll('[required]:not([type="hidden"])');

      for (let i = 0; i < visibleRequiredInputs.length; i++) {
          const input = visibleRequiredInputs[i];
          // Ensure the element is visible and required before validating it
          if (input.offsetParent === null || input.offsetWidth === 0 || input.offsetHeight === 0 || input.style.display === 'none') {
              continue;
          }
          if (!input.checkValidity()) {
              allValid = false;
              input.reportValidity(); // Show native browser validation message
              console.log(`[validateFormFields] Validation failed for field: ${input.id}`);
              break;
          }
      }

      // Check for password strength - THIS IS WHERE THE STRICT VALIDATION HAPPENS FOR SUBMISSION
      const passwordInput = document.getElementById('foreign-password');
      if (passwordInput && !checkForeignPasswordStrength(passwordInput.value)) { 
          showCustomMessage('Your password does not meet all the required criteria. Please review the password requirements.');
          allValid = false;
          passwordInput.focus(); // Focus on password field to help user
          console.log('[validateFormFields] Password strength validation failed.');
          // Do not return here, let the loop finish to highlight other fields if any.
      }


      // Check for password match AFTER individual field validity and strength
      const confirmPasswordInput = document.getElementById('foreign-password-confirm');
      if (passwordInput && confirmPasswordInput && passwordInput.value !== confirmPasswordInput.value) { // Only validate if both fields exist
          showCustomMessage('Passwords do not match. Please ensure both password fields are identical.');
          allValid = false;
          // Optionally, focus on the confirm password field to highlight the issue
          confirmPasswordInput.focus();
          console.log('[validateFormFields] Password match validation failed.');
      }


      // Restore original 'required' state for fields that were temporarily disabled
      hiddenRequiredFields.forEach(field => {
        field.required = true;
        field.removeAttribute('data-temp-required');
        console.log(`[validateFormFields] Restored required for field: ${field.id}`);
      });

      console.log(`[validateFormFields] Overall form validity: ${allValid}`);
      return allValid;
    }


