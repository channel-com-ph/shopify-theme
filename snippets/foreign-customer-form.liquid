  {%- comment -%}
    This include is expected to define `addressObject` in JavaScript
    or provide data that JavaScript can use to build it.
  {%- endcomment -%}

  {%- if form.errors -%}
    <h2 class="form__message" tabindex="-1" autofocus style="font-size: 1.7rem;">
      <span class="svg-wrapper">
        {{- 'icon-error.svg' | inline_asset_content -}}
      </span>
      {{ 'templates.contact.form.error_heading' | t }}
    </h2>
    <ul style="font-size: 1.7rem;">
      {%- for field in form.errors -%}
        <li>
          {%- if field == 'form' -%}
            {{ form.errors.messages[field] }}
          {%- else -%}
            <a href="#Foreign-Register-{{ field }}">
              {{ form.errors.translated_fields[field] | capitalize }}
              {{ form.errors.messages[field] }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <span style="display: flex; font-size: 1.9rem; font-weight:600; margin: 1.5rem 0 1rem; color: black;"
    >Personal Information</span
  >

  <div class="setRow">
    <div class="setCol">
      <label for="ForeignForm-FirstName" style="font-size: 1.5rem"
        ><span class="required-asterisk">*</span>{{ 'customer.register.first_name' | t -}}
      </label>
      <div class="firstname-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[first_name]"
            id="ForeignForm-FirstName"
            {% if form.first_name %}
              value="{{ form.first_name }}"
            {% endif %}
            autocomplete="given-name"
            required
            minlength="2"
            maxlength="25"
          >
        </div>
      </div>
    </div>
    <div class="setCol">
      <label for="ForeignForm-LastName" style="font-size: 1.5rem"
        ><span class="required-asterisk">*</span>{{ 'customer.register.last_name' | t -}}
      </label>
      <div class="lastname-field form-input-container">
        <div class="form-input-box">
          <input
            type="text"
            name="customer[last_name]"
            id="ForeignForm-LastName"
            {% if form.last_name %}
              value="{{ form.last_name }}"
            {% endif %}
            autocomplete="family-name"
            required
            minlength="2"
            maxlength="25"
          >
        </div>
      </div>
    </div>
  </div>

  <div class="setRow">
    <div class="setCol">
      <label for="ForeignForm-birthdate" style="font-size: 1.5rem;"
        ><span class="required-asterisk">*</span>Birthdate</label
      >
      <div class="birthdate-field form-input-container" style="margin: 0; align-items: center;">
        <div class="form-input-box">
          <input
            type="text" 
            name="customer[note][Birthdate]"
            id="ForeignForm-birthdate"
            autocomplete="bday"
            aria-required="true"
            required
            readonly 
          >
        </div>
      </div>
    </div>
<div class="setCol" style="margin: 0;">
  <label for="ForeignForm-contactN" style="font-size: 1.5rem; margin: 0;">
    <span class="required-asterisk">*</span>Mobile Number
  </label>
  <div class="setRow" style="gap: 8px; align-items: flex-start;">
    <div class="setCol" style="flex: 0 0 120px; max-width: 120px;">
      <div class="country-code-field form-input-container dropdown-wrapper" style="margin: 0;">
        <select id="foreignCountryCode" name="customer[note][CountryCode]" style="margin: 0; height: 100%;">
          <option value="" disabled selected>Select Code</option>
          <!-- Options populated by JS -->
        </select>
        <span class="svg-wrapper" style="margin-right: 10px;">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </div>
    <div class="setCol" style="flex: 1;">
      <div class="contact-n-field form-input-container" style="margin: 0;">
        <div class="form-input-box" style="margin: 0;">
          <input
            type="tel"
            name="customer[phone]"
            id="ForeignForm-contactN"
            aria-required="true"
            {% if form.phone  %}
            value="{{ form.phone  }}"
            {% endif %}
            autocomplete="tel"
            required
            style="width: 100%;"
          >
        </div>
      </div>
    </div>
  </div>
</div>
