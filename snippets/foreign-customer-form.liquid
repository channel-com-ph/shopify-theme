<style>
  /* Basic styling for the form elements for better visual separation */
    .setRow {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 1.5rem;
    }

    .setCol {
      flex: 1;
      min-width: 280px;
    }

  /* Base styling for all field containers */
  .form-input-container {
    position: relative;
    margin-top: 0.5rem; 
  }

  /* Consistent visual box for all general input types (text, date, tel, postal code span) */
  .form-input-box {
    display: flex; 
    align-items: center;
    width: 100%;
    border: 1px solid #cbd5e0;
    border-radius: 8px;
    background-color: #f8fafc;
    height: 3rem; 
    box-sizing: border-box;
  }

  /* Styling for inputs *inside* the .form-input-box */
  .form-input-box input {
    flex-grow: 1; 
    border: none;
    outline: none; 
    background-color: transparent;
    padding: 0 1.2rem;
    font-size: 1.7rem;
    height: 100%; 
  }

  /* Specific wrapper for password fields, also used for email for consistency */
  .password-field-wrapper {
      position: relative;
      width: 100%;
      display: flex;
      align-items: center;
      border: 1px solid #cbd5e0;
      border-radius: 8px;
      background-color: #f8fafc;
      height: 3rem;
      box-sizing: border-box;
  }

  /* Styling for inputs *inside* the .password-field-wrapper */
  .password-field-wrapper input {
      flex-grow: 1;
      border: none;
      padding: 0 1.2rem;
      height: 100%; 
      font-size: 1.7rem;
      outline: none;
      background-color: transparent;
  }

  .password-toggle {
      position: absolute;
      right: 12px;
      cursor: pointer;
      padding: 0 5px;
  }

  .password-toggle img {
      width: 20px;
      height: 20px;
      vertical-align: middle;
  }

  /* Styling for the dropdown wrapper itself to make it look like a consistent input box */
  .dropdown-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    border: 1px solid #cbd5e0;
    border-radius: 8px;
    background-color: #f8fafc;
    height: 3rem;
    box-sizing: border-box;
  }

  /* Styling for select element *inside* its .dropdown-wrapper container */
  .dropdown-wrapper select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    flex-grow: 1;
    border: none;
    outline: none;
    background-color: transparent;
    padding: 0 1.2rem;
    font-size: 1.7rem;
    height: 100%;
    cursor: pointer;
  }

  /* Styling for the SVG wrapper inside .dropdown-wrapper */
  .dropdown-wrapper .svg-wrapper {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none; 
  }

  button[type="submit"], button[type="button"] {
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 1rem 2rem;
    font-size: 1.2rem;
  }

  button[type="submit"]:hover, button[type="button"] :hover {
    background-color: #0056b3;
  }

  button[disabled] {
    background-color: #cccccc;
    cursor: not-allowed;
  }

  /* Custom Message Box Styling */
  .custom-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }

  .custom-modal-content {
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    text-align: center;
    max-width: 400px;
    width: 90%;
    position: relative;
  }

  .custom-modal-content h3 {
    margin-top: 0;
    font-size: 1.8rem;
    color: #333;
    margin-bottom: 15px;
  }

  .custom-modal-content p {
    font-size: 1.5rem;
    color: #555;
    margin-bottom: 25px;
  }

  .custom-modal-close-btn {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 25px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1.4rem;
    transition: background-color 0.3s ease;
  }

  .custom-modal-close-btn:hover {
    background-color: #0056b3;
  }

  .required-asterisk {
    color: red;
    margin-right: 4px; 
    font-weight: bold;
  }

  .password-match-feedback {
      font-size: 1.3rem;
      margin-top: 0.5rem;
      text-align: right;
      min-height: 1.5rem; 
  }

  .password-match {
      color: #27ae60; /* Green for match */
  }

  .password-mismatch {
      color: #e74c3c; /* Red for mismatch */
  }

  .shipping-note {
  background-color: #fceded; 
  color: #812e2e; 
  border-left: 5px solid #992b2b;
  padding: 1rem; 
  margin: 1.5rem 0;
  border-radius: 0 8px 8px 0;
  font-family: system-ui, sans-serif;
  line-height: 1.5;
}

.shipping-note p {
  margin: 0; 
}

.shipping-note strong {
  color: #8a2525; /*"Note"*/
}

</style>

