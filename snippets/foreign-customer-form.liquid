    // --- Event Listeners for new Primary Country Information ---
    if (CustomerCountrySelect) {
        CustomerCountrySelect.addEventListener('change', function() {
            const selectedCountry = this.value;
            console.log(`[CustomerCountrySelect] CustomerCountry changed to: ${selectedCountry}`);
            togglePrimaryAddressFields(selectedCountry); // Updated call
        });
    }
    if (PrimaryNonPhProvinceSelect) {
        PrimaryNonPhProvinceSelect.addEventListener('change', function() {
            console.log('[PrimaryNonPhProvinceSelect] Primary Non-PH Province changed.');
