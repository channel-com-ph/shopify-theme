      maxDate: "today",    // Prevent selecting future dates
      altInput: true,      // Show a human-friendly date in the input
      altFormat: "F j, Y", // e.g., "July 26, 2025"
      enableTime: false,   // Only date, no time
      // Flatpickr's default UI already provides good navigation for years/months
      // by clicking on the month/year in the header.
    });
    
    // Attach toggle event listeners
    document.getElementById('toggle-foreign-password').addEventListener('click', () => togglePasswordVisibility('foreign-password', 'toggle-foreign-password'));
    document.getElementById('toggle-foreign-password-confirm').addEventListener('click', () => togglePasswordVisibility('foreign-password-confirm', 'toggle-foreign-password-confirm'));

    // --- Global Elements ---
    const form = document.getElementById('foreign-register-form');
    // const shippingAddressContainer = document.getElementById('foreign-shipping-address-container'); // Removed

    // --- Employment Status Elements ---
    const industrySelect = document.getElementById('Foreign-Register-Industry'); // Renamed to industrySelect
