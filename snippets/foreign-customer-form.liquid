    /**
     * Sets or unsets the 'required' attribute and clears the value for input/select elements
     * within a given container.
     * @param {HTMLElement} container The container element.
     * @param {boolean} isRequired Whether the fields should be required.
     */
    function setFieldsRequiredAndClear(container, isRequired) {
        if (!container) return;
        const fields = container.querySelectorAll('input, select');
        fields.forEach(field => {
            // Skip hidden inputs like postalCodeInput as their 'required' state is managed by the logic
            if (field.type === 'hidden') {
                return;
            }

            field.required = isRequired;
            if (!isRequired) {
                // Clear value and reset dropdowns only if making them not required/hidden
                if (field.tagName === 'SELECT') {
                    field.value = ''; // Attempt to reset to empty
                    if (field.querySelector('option[disabled][selected]')) {
                        field.value = ''; // Ensure the disabled selected option is active
                    }
                } else if (field.type !== 'radio' && field.type !== 'checkbox') {
                    field.value = ''; // Clear input field value
                }
            }
        });
    }

    /**
     * Get postal code from addressObject
     * @param {string} region The selected region.
     * @param {string} city The selected city.
     * @param {string|null} barangay The selected barangay (optional).
     * @returns {string} The postal code or an empty string if not found.
     */
    function getPostalCode(region, city, barangay = null) {
        console.log('[getPostalCode] Called with:', { region, city, barangay });
        if (typeof addressObject === 'undefined' || !addressObject.Philippines || !region || !city) {
            console.warn("[getPostalCode] addressObject or essential address data missing.");
            return '';
        }

        let cityData = null;
        const regionContent = addressObject.Philippines[region];

        if (regionContent) {
            // Check if city is directly under the region
            if (regionContent[city] && typeof regionContent[city] === 'object' && regionContent[city] !== null) {
                cityData = regionContent[city];
            } else {
                // Check if city is nested under a province within the region
                for (const provinceKey in regionContent) {
                    if (regionContent.hasOwnProperty(provinceKey)) {
                        const provinceContent = regionContent[provinceKey];
                        if (typeof provinceContent === 'object' && provinceContent !== null && provinceContent[city] && typeof provinceContent[city] === 'object' && provinceContent[city] !== null) {
                            cityData = provinceContent[city];
                            break;
                        }
                    }
                }
            }
        }

        if (cityData) {
            if (barangay && typeof cityData[barangay] === 'string') {
                const postal = cityData[barangay];
                console.log(`[getPostalCode] Found specific postal code for barangay ${barangay}: ${postal}`);
                return postal;
            }
            if (typeof cityData.postal_code === 'string') {
                const postal = cityData.postal_code;
                console.log(`[getPostalCode] Found city-level postal code: ${postal}`);
                return postal;
            }
        }
        console.log("[getPostalCode] No postal code found for the given selection.");
        return '';
    }

