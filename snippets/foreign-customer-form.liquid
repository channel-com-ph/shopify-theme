                employmentReligiousFields.style.display = 'block'; 
                
            }
              else if (selectedRole.includes('Other Role')) {
                employmentOtherFields.style.display = 'block';
                if (otherEmploymentInput) otherEmploymentInput.required = false; 
            }
        });
