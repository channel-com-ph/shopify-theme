    /**
     * Populates the City/Municipality dropdown based on selected Region/Province.
     * @param {HTMLSelectElement} provinceDropdown The province select element holding the selected region.
     * @param {HTMLSelectElement} cityDropdown The city select element to populate.
     * @param {HTMLSelectElement} barangayDropdown The barangay select element to clear and disable.
     * @param {HTMLInputElement} postalInput The postal code input to clear.
     */
    function populateCities(provinceDropdown, cityDropdown, barangayDropdown, postalInput) {
        const selectedRegion = provinceDropdown.value;
        console.log(`[populateCities] Called for region: ${selectedRegion}`);
        if (typeof addressObject === 'undefined' || !selectedRegion || !addressObject.Philippines[selectedRegion]) {
            console.warn("addressObject or address data for selected region not found during populateCities.");
            resetDropdown(cityDropdown, 'Select City/Municipality');
            return;
        }

        cityDropdown.disabled = false;
        resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
        if (postalInput) postalInput.value = '';

        cityDropdown.innerHTML = '<option value="" disabled selected>Select City/Municipality</option>';
        const regionContent = addressObject.Philippines[selectedRegion];
        const citiesToAdd = new Set(); // Use a Set to avoid duplicate city names

        // Iterate through direct children of the region (could be cities or provinces)
        for (const key in regionContent) {
            if (regionContent.hasOwnProperty(key)) {
                const item = regionContent[key];
                if (typeof item === 'object' && item !== null) {
                    // If the item has a 'postal_code' or contains direct string values (barangays as strings), it's likely a city object
                    if (item.postal_code || Object.keys(item).some(subKey => typeof item[subKey] === 'string' && subKey !== 'postal_code')) {
                        citiesToAdd.add(key); // This 'key' is a city name
                    } else {
                        // Otherwise, it might be a province containing cities
                        for (const cityKey in item) {
                            if (item.hasOwnProperty(cityKey) && typeof item[cityKey] === 'object' && item[cityKey] !== null) {
                                if (item[cityKey].postal_code || Object.keys(item[cityKey]).some(subKey => typeof item[cityKey][subKey] === 'string' && subKey !== 'postal_code')) {
                                    citiesToAdd.add(cityKey); // This 'cityKey' is a city name
                                }
                            }
                        }
                    }
                }
            }
        }

        const sortedCities = Array.from(citiesToAdd).sort();
        sortedCities.forEach(city => {
            const option = document.createElement('option');
            option.value = city;
            option.textContent = city;
            cityDropdown.appendChild(option);
        });
        console.log(`[populateCities] Populated Philippine cities for ${selectedRegion}. Total: ${sortedCities.length}`);
        updatePostalCodeInput(provinceDropdown, cityDropdown, barangayDropdown, postalInput);
    }

    /**
     * Populates the Barangay/Sub-Municipality dropdown.
     * @param {HTMLSelectElement} provinceDropdown The province select element holding the selected region.
     * @param {HTMLSelectElement} cityDropdown The city select element holding the selected city.
     * @param {HTMLSelectElement} barangayDropdown The barangay select element to populate.
     * @param {HTMLInputElement} postalInput The postal code input (now just cleared, not set).
     */
    function populateBarangays(provinceDropdown, cityDropdown, barangayDropdown, postalInput) {
        const selectedRegion = provinceDropdown.value;
        const selectedCity = cityDropdown.value;
        console.log(`[populateBarangays] Called for region: ${selectedRegion}, city: ${selectedCity}`);

        if (typeof addressObject === 'undefined' || !selectedRegion || !selectedCity || !addressObject.Philippines[selectedRegion]) {
            console.warn("addressObject or address data for selected region/city not found during populateBarangays.");
            resetDropdown(barangayDropdown, 'Select Barangay/Sub-Municipality');
            if (postalInput) postalInput.value = '';
            return;
        }

        barangayDropdown.disabled = false;
        barangayDropdown.innerHTML = '<option value="" disabled selected>Select Barangay/Sub-Municipality</option>';

        let targetCityData = null;
        const regionContent = addressObject.Philippines[selectedRegion];

        if (regionContent) {
            // Check if city is directly under the region
            if (regionContent[selectedCity] && typeof regionContent[selectedCity] === 'object' && regionContent[selectedCity] !== null) {
                targetCityData = regionContent[selectedCity];
            } else {
                // Check if city is nested under a province within the region
                for (const provinceKey in regionContent) {
                    if (regionContent.hasOwnProperty(provinceKey)) {
                        const provinceContent = regionContent[provinceKey];
                        if (typeof provinceContent === 'object' && provinceContent !== null && provinceContent[selectedCity] && typeof provinceContent[selectedCity] === 'object' && provinceContent[selectedCity] !== null) {
                            targetCityData = provinceContent[selectedCity];
                            break;
                        }
                    }
                }
            }
        }

        if (targetCityData) {
            // Filter out 'postal_code' and any other non-barangay properties (assuming barangays are strings)
            const barangays = Object.keys(targetCityData).filter(key => typeof targetCityData[key] === 'string' && key !== 'postal_code');
            barangays.sort(); // Sort barangays alphabetically
            barangays.forEach(barangay => {
                const option = document.createElement('option');
                option.value = barangay;
                option.textContent = barangay;
                barangayDropdown.appendChild(option);
            });
            console.log(`[populateBarangays] Populated Philippine barangays for ${selectedCity}. Total: ${barangays.length}`);
        } else {
            console.warn(`[populateBarangays] No specific barangay data found for city: ${selectedCity} in region: ${selectedRegion}`);
        }
        // Always update postal code here, even if no barangay selected (it will use city's if available)
        updatePostalCodeInput(provinceDropdown, cityDropdown, barangayDropdown, postalInput);
    }


