    // --- NEW: Functions for Primary Country's dynamic address fields ---
    function togglePrimaryAddressFields(selectedCountry) {
      console.log(`[togglePrimaryAddressFields] Called for country: ${selectedCountry}`);
      
      if (!PrimaryCountryAddressFields) {
          console.error(`[togglePrimaryAddressFields] Primary country address fields container not found.`);
          return;
      }
      
      // Hide all dynamic address field containers first
      PrimaryCountryAddressFields.style.display = 'none';
      if (PrimaryNonPhProvinceSelectContainer) PrimaryNonPhProvinceSelectContainer.style.display = 'none';
      if (PrimaryNonPhProvinceInputContainer) PrimaryNonPhProvinceInputContainer.style.display = 'none';
      if (PrimaryNonPhCityInputContainer) PrimaryNonPhCityInputContainer.style.display = 'none'; // Always input for city
      if (PrimaryNonPhZipInputContainer) PrimaryNonPhZipInputContainer.style.display = 'none'; // Always input for primary zip

      // Reset required state for all primary address fields AND clear their values
      [PrimaryAddress1Input, PrimaryAddress2Input, PrimaryNonPhProvinceSelect, PrimaryNonPhProvinceInput, PrimaryNonPhCityInput, PrimaryNonPhZipInput].forEach(el => {
          if (el) {
              el.required = false;
              el.value = '';
              if (el.tagName === 'SELECT') {
                  el.innerHTML = `<option value="" disabled selected>${el.options[0].textContent}</option>`;
                  el.disabled = true;
              }
          }
      });

      if (!selectedCountry) { // No country selected yet or cleared
          PrimaryCountryAddressFields.style.display = 'none'; // Hide the whole section
          return;
      }

      // Show the main primary address fields container
      PrimaryCountryAddressFields.style.display = 'block';

      // Address 1 is always required for any selected country
      if (PrimaryAddress1Input) PrimaryAddress1Input.required = true;
      // Address 2 is always optional
      if (PrimaryAddress2Input) PrimaryAddress2Input.required = false;

      if (selectedCountry === 'Philippines') {
          // Primary address for Philippines is not collected in this section,
          // it's assumed to be handled by the shipping address or not needed here.
          // So, these fields remain empty for 'Philippines' in the Primary Country section.
          PrimaryCountryAddressFields.style.display = 'none';
          console.log('[togglePrimaryAddressFields] Primary country is Philippines. Hiding primary-country-address-fields.');
      } else if (selectedCountry === 'Other') {
          console.log('[togglePrimaryAddressFields] Primary country is "Other". Showing input fields.');
          if (PrimaryNonPhProvinceInputContainer) PrimaryNonPhProvinceInputContainer.style.display = 'block';
          if (PrimaryNonPhProvinceInput) PrimaryNonPhProvinceInput.required = true;
          if (PrimaryNonPhCityInputContainer) PrimaryNonPhCityInputContainer.style.display = 'block';
          if (PrimaryNonPhCityInput) PrimaryNonPhCityInput.required = true;
          if (PrimaryNonPhZipInputContainer) PrimaryNonPhZipInputContainer.style.display = 'block'; // Always input for ZIP
          if (PrimaryNonPhZipInput) PrimaryNonPhZipInput.required = true;

      } else if (window.locationData[selectedCountry]) { // Country is in locationData, use dropdowns for province/city
          console.log(`[togglePrimaryAddressFields] Primary country (${selectedCountry}) is in locationData. Showing select fields for province/city.`);
          if (PrimaryNonPhProvinceSelectContainer) PrimaryNonPhProvinceSelectContainer.style.display = 'block';
          if (PrimaryNonPhProvinceSelect) {
              PrimaryNonPhProvinceSelect.required = true;
              PrimaryNonPhProvinceSelect.disabled = false; // Enable province select
              populatePrimaryProvinces('CustomerCountry', 'PrimaryNonPhProvinceSelect', 'PrimaryNonPhCityInput', 'PrimaryNonPhZipInput'); // Populate dropdown
          }
          if (PrimaryNonPhCityInputContainer) PrimaryNonPhCityInputContainer.style.display = 'block'; // City is now an input
          if (PrimaryNonPhCityInput) {
              PrimaryNonPhCityInput.required = true;
          }
          if (PrimaryNonPhZipInputContainer) PrimaryNonPhZipInputContainer.style.display = 'block'; // Always input for ZIP
          if (PrimaryNonPhZipInput) PrimaryNonPhZipInput.required = true;

      } else { // Country not in locationData and not "Other", default to text inputs
          console.log(`[togglePrimaryAddressFields] Primary country (${selectedCountry}) is NOT in locationData and not "Other". Showing input fields.`);
          if (PrimaryNonPhProvinceInputContainer) PrimaryNonPhProvinceInputContainer.style.display = 'block';
          if (PrimaryNonPhProvinceInput) PrimaryNonPhProvinceInput.required = true;
          if (PrimaryNonPhCityInputContainer) PrimaryNonPhCityInputContainer.style.display = 'block';
          if (PrimaryNonPhCityInput) PrimaryNonPhCityInput.required = true;
          if (PrimaryNonPhZipInputContainer) PrimaryNonPhZipInputContainer.style.display = 'block'; // Always input for ZIP
          if (PrimaryNonPhZipInput) PrimaryNonPhZipInput.required = true;
      }
    }

    function populatePrimaryProvinces(countrySelectId, provinceSelectId, cityInputId, zipInputId) { // Changed citySelectId to cityInputId, zipSelectId to zipInputId
      console.log(`[populatePrimaryProvinces] Called for primary with countrySelectId: ${countrySelectId}`);
      const countrySelect = document.getElementById(countrySelectId);
      const provinceSelect = document.getElementById(provinceSelectId);
      const cityInput = document.getElementById(cityInputId); // Get the input element for city
      const zipInput = document.getElementById(zipInputId); // Get the input element for zip
      const selectedCountry = countrySelect ? countrySelect.value : '';

      if (provinceSelect) provinceSelect.innerHTML = '<option value="" disabled selected>Select state/province</option>';
      if (cityInput) cityInput.value = ''; // Clear the city input
      if (zipInput) zipInput.value = ''; // Clear the zip input

      if (window.locationData && window.locationData[selectedCountry] && provinceSelect) {
        Object.keys(window.locationData[selectedCountry]).forEach(province => {
          const option = document.createElement('option');
          option.value = province;
          option.textContent = province;
          provinceSelect.appendChild(option);
        });
        provinceSelect.disabled = false;
        console.log(`[populatePrimaryProvinces] Populated primary provinces for ${selectedCountry}. Total: ${Object.keys(window.locationData[selectedCountry]).length}`);
      } else {
          if (provinceSelect) provinceSelect.disabled = true;
          console.warn(`[populatePrimaryProvinces] No primary province data found for country: ${selectedCountry}`);
      }
    }

    // Removed populatePrimaryCities and populatePrimaryZipCodes as city and zip are now inputs for primary address.


      // Gather all form data from visible/relevant fields
      const formData = {
        first_name: document.getElementById('ForeignForm-FirstName').value,
        last_name: document.getElementById('ForeignForm-LastName').value,
        birthdate: document.getElementById('ForeignForm-birthdate').value,
        phone_country_code: document.getElementById('foreignCountryCode').value,
        phone: document.getElementById('ForeignForm-contactN').value,
        
        // Primary Country Information
        primary_country: CustomerCountrySelect ? CustomerCountrySelect.value : '',
        primary_address1: '', // New field
        primary_address2: '', // New field
        primary_province: '',
        primary_city: '',
        primary_zip: '',

        // Employment Status and related fields
        industry: industrySelect ? industrySelect.value : '', // Renamed to industry
        role_title: roleSelect && roleSelect.style.display !== 'none' ? roleSelect.value : '', // Now directly maps to role/job title
        // Added checks for element existence before accessing value or style
        school_name: employmentStudentFields && employmentStudentFields.style.display !== 'none' && schoolNameInput ? schoolNameInput.value : '',
        company_agency_name: employmentPrivateGovernmentFields && employmentPrivateGovernmentFields.style.display !== 'none' && companyNameInput ? companyNameInput.value : '',
        // business_type: employmentSelfEmployedFields && employmentSelfEmployedFields.style.display !== 'none' && businessTypeInput ? businessTypeInput.value : '', // Business Type for Business Owner
        previous_occupation: employmentUnemployedFields && employmentUnemployedFields.style.display !== 'none' && previousOccupationInput ? previousOccupationInput.value : '', 
        house_of_worship: employmentReligiousFields && employmentReligiousFields.style.display !== 'none' && houseOfWorshipInput ? houseOfWorshipInput.value : '', // NEW: Capture House of Worship
        other_employment_status: employmentOtherFields && employmentOtherFields.style.display !== 'none' && otherEmploymentInput ? otherEmploymentInput.value : '',
        foreign_other_industry_text: foreignOtherIndustryTextField && foreignOtherIndustryTextField.style.display !== 'none' && foreignOtherIndustryTextInput ? foreignOtherIndustryTextInput.value : '', // NEW: Capture Other Industry text


        // Shipping Address Data (only if provided) // Removed
        // shipping_provided: document.getElementById('ForeignShippingAddressYes').checked ? 'Yes' : 'No', // Removed
        // shipping_address_line1: '', // Removed
        // // shipping_address_line2: '', // Not present in the current shipping section HTML // Removed
        // shipping_country: '', // Removed
        // shipping_province: '', // Removed
        // shipping_city: '', // Removed
        // shipping_barangay: '', // Removed
        // shipping_postal_code: '' // Removed
      };

      // Populate primary country address fields in formData
      if (CustomerCountrySelect && CustomerCountrySelect.value) {
          formData.primary_address1 = PrimaryAddress1Input ? PrimaryAddress1Input.value : ''; // New
          formData.primary_address2 = PrimaryAddress2Input ? PrimaryAddress2Input.value : ''; // New
          const selectedPrimaryCountry = CustomerCountrySelect.value;
          if (selectedPrimaryCountry === 'Philippines') {
              // Primary address for Philippines is not collected in this section,
              // it's assumed to be handled by the shipping address or not needed here.
              // So, these fields remain empty for 'Philippines' in the Primary Country section.
          } else if (selectedPrimaryCountry === 'Other') {
              formData.primary_province = PrimaryNonPhProvinceInput ? PrimaryNonPhProvinceInput.value : '';
              formData.primary_city = PrimaryNonPhCityInput ? PrimaryNonPhCityInput.value : '';
              formData.primary_zip = PrimaryNonPhZipInput ? PrimaryNonPhZipInput.value : '';
          } else { // Country is in window.locationData
              formData.primary_province = PrimaryNonPhProvinceSelect ? PrimaryNonPhProvinceSelect.value : '';
              formData.primary_city = PrimaryNonPhCityInput ? PrimaryNonPhCityInput.value : ''; // Always input for city
              formData.primary_zip = PrimaryNonPhZipInput ? PrimaryNonPhZipInput.value : ''; // Always input for zip
          }
      }


      // if (document.getElementById('ForeignShippingAddressYes').checked) { // Removed
      //   formData.shipping_address_line1 = ForeignShippingAddress1Input ? ForeignShippingAddress1Input.value : ''; // Removed
      //   formData.shipping_country = 'Philippines'; // Always Philippines if "Yes" is selected for shipping // Removed
      //   // formData.shipping_address_line2 is not present in the current shipping section HTML // Removed
        
      //   formData.shipping_province = ForeignPhShippingProvinceSelect ? ForeignPhShippingProvinceSelect.value : ''; // Removed
      //   formData.shipping_city = ForeignPhShippingCitySelect ? ForeignPhShippingCitySelect.value : ''; // Removed
      //   formData.shipping_barangay = ForeignPhShippingBarangaySelect ? ForeignPhShippingBarangaySelect.value : ''; // Removed
      //   formData.shipping_postal_code = ForeignPhShippingPostalCodeInput ? ForeignPhShippingPostalCodeInput.value : ''; // Removed
      // } // Removed

      formData.email = document.getElementById('foreign-email').value; // Updated ID
      formData.accepts_marketing = document.getElementById('foreignMarketing').checked ? 'Yes' : 'No';
      formData.timestamp = new Date().toISOString();


      // --- Form Submission Logic ---
      form.addEventListener('submit', function(e) {
        console.log('[Form Submission] Form submission attempted.');
        // Perform final validation for the entire form, considering hidden fields
        if (!validateFormFields()) { // Changed to validateFormFields
          e.preventDefault(); 
          showCustomMessage('Please fill in all required fields correctly.');
          return;
        }

        e.preventDefault();

        // Show loading state
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.textContent;
        if (submitBtn) {
            submitBtn.textContent = 'Processing...';
            submitBtn.disabled = true;
            console.log('[Form Submission] Submit button disabled and text changed to "Processing...".');
        }

        // Send to Google Sheets
        fetch('https://script.google.com/macros/s/AKfycbwPtyuHiXwlw2gCA-LCa69zrfpR2UHB4_tbi4Z8SRATG6aBNKmzuDomJ7DqJnJfUuI2/exec', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        })
        .then(response => {
          if (response.ok) {
            console.log('[Form Submission] Data successfully sent to Google Sheets. Submitting form to Shopify.');
            form.submit();
          } else {
            console.error('[Form Submission] Failed to save data to Google Sheets. Status:', response.status);
            showCustomMessage('Failed to save data to Google Sheets. Attempting to register account anyway.');
            form.submit();
          }
        })
        .catch(error => {
          console.error('[Form Submission] An error occurred during fetch to Google Sheets:', error);
          showCustomMessage('An error occurred during data submission. Attempting to register account anyway.');
          form.submit(); 
        })
        .finally(() => {
          if (submitBtn) {
              submitBtn.textContent = originalBtnText;
              submitBtn.disabled = false;
              console.log('[Form Submission] Submit button re-enabled and text restored.');
          }
        });
      });
