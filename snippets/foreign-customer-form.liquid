          }

          // Populate the role dropdown based on the selected industry
          populateRoles(selectedIndustry);

          // Show the role dropdown container if an industry is selected AND it's not "Other Industry"
          if (selectedIndustry && selectedIndustry !== 'Other Industry') {
              roleDropdownContainer.style.display = 'block';
              roleSelect.disabled = false;
