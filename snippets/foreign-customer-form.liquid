      document.getElementById('custom-message-box').style.display = 'none';
    });
  });

// Password Strength Checker for Foreign Customers (stricter)
function checkForeignPasswordStrength(password) {
  const strengthMeter = document.getElementById('foreign-strength-meter');
  const requirements = {
    length: document.getElementById('foreign-length-req'),
    upper: document.getElementById('foreign-upper-req'),
    lower: document.getElementById('foreign-lower-req'),
    number: document.getElementById('foreign-number-req'),
    special: document.getElementById('foreign-special-req')
  };

  let allRequirementsMet = true;

  const updateRequirement = (reqElement, condition) => {
    if (reqElement) { // Check if element exists before manipulating
      if (condition) {
        reqElement.style.color = '#27ae60';
        // Ensure "✓ " is only added if not already present
        if (!reqElement.textContent.startsWith('✓ ')) {
            reqElement.textContent = '✓ ' + reqElement.textContent.replace(/^[✓✗]\s/, '');
        }
      } else {
        reqElement.style.color = '#e74c3c';
        // Ensure "✗ " is only added if not already present
        if (!reqElement.textContent.startsWith('✗ ')) {
            reqElement.textContent = '✗ ' + reqElement.textContent.replace(/^[✓✗]\s/, '');
        }
      }
    }
    allRequirementsMet = allRequirementsMet && condition;
  };

  // Foreign customer requirements (stricter)
  const hasLength = password.length >= 9; // Stricter length requirement
  updateRequirement(requirements.length, hasLength);

  const hasUpperCase = /[A-Z]/.test(password);
  updateRequirement(requirements.upper, hasUpperCase);

  const hasLowerCase = /[a-z]/.test(password);
  updateRequirement(requirements.lower, hasLowerCase);

  const hasNumber = /[0-9]/.test(password);
  updateRequirement(requirements.number, hasNumber);

  const hasSpecialChar = /[^A-Za-z0-9]/.test(password);
  updateRequirement(requirements.special, hasSpecialChar);

  // Strength level for UI
  let strengthLevel = '';
  let color = '#777'; // Default color

  if (password.length > 0) {
    if (password.length < 9) { // Weak if less than 9 characters
      strengthLevel = 'Weak';
      color = '#e74c3c';
    } else if (!hasSpecialChar || !hasUpperCase || !hasNumber) { // Medium if length met but some other critera not
      strengthLevel = 'Medium';
      color = '#f39c12';
    } else { // Strong if all criteria met including length
      strengthLevel = 'Strong';
      color = '#27ae60';
    }
  }

  if (strengthMeter) {
    strengthMeter.textContent = strengthLevel;
    strengthMeter.style.color = color;
  }

  return allRequirementsMet;
}

// Password Match Checkers (separate for each form)
// This function is for the foreign form, using its specific IDs
function checkForeignPasswordsMatch() {
  const passwordInput = document.getElementById('foreign-password');
  const confirmPasswordInput = document.getElementById('foreign-password-confirm');
  const feedbackElement = document.getElementById('foreign-password-match-feedback');
  
  if (!passwordInput || !confirmPasswordInput || !feedbackElement) return;
  
  const password = passwordInput.value;
  const confirmPassword = confirmPasswordInput.value;
  
  if (confirmPassword.length === 0) {
    feedbackElement.textContent = '';
    feedbackElement.style.color = ''; // Clear color if no input
    return;
  }
  
  if (password === confirmPassword) {
    feedbackElement.textContent = '✓ Passwords match';
    feedbackElement.style.color = '#28a745'; // Green for match
  } else {
    feedbackElement.textContent = '✗ Passwords do not match';
    feedbackElement.style.color = '#dc3545'; // Red for mismatch
  }
}
  
  // Function to toggle password visibility with images
  function togglePasswordVisibility(inputId, toggleId) {
      const input = document.getElementById(inputId);
      const toggle = document.getElementById(toggleId);
      const toggleImg = toggle.querySelector('img');

      if (!input || !toggle || !toggleImg) {
          console.error('Missing elements for password toggle:', { input, toggle, toggleImg });
          return;
      }

      if (input.type === 'password') {
          input.type = 'text';
          // Using the specific show icon provided by the user
          toggleImg.src = 'https://img.icons8.com/external-smashingstocks-hand-drawn-black-smashing-stocks/99/external-eye-password-security-cyber-attack-hacking-smashingstocks-hand-drawn-black-smashing-stocks.png';
          toggleImg.alt = 'Show password';
      } else {
          input.type = 'password';
          // Using the specific hide icon provided by the user
          toggleImg.src = 'https://img.icons8.com/ios/50/closed-eye.png';
          toggleImg.alt = 'Hide password';
      }
  }

  // Format phone number inputs to accept only digits
  document.getElementById('ForeignForm-contactN').addEventListener('input', function(e) {
    this.value = this.value.replace(/[^0-9]+/g, '');
  });

  document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM Content Loaded. Initializing form scripts.');

